{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valentinapdesign",
  "compatibility_date": "2025-09-02",
  // The Worker exists only for /api/* (review comments). Everything else is
  // answered by the asset layer first and never reaches worker/index.js.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valentinapdesign-comments",
      "database_id": "4bf029b5-2eb3-4df2-a75c-f31db6f0dab4",
      "migrations_dir": "worker/migrations"
    }
  ]
}
