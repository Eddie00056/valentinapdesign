---
// Sticky identity + nav, shared by the /website homepage and every case study.
---

<header class="nav">
  <div class="nav-inner">
    <a class="id" href="/website">
      <img src="/website/portrait.png" alt="Valentina Padure" width="48" height="48" />
      <span class="id-text">
        <span class="id-name">VALENTINA PADURE</span>
        <span class="id-mail">valeapad@gmail.com</span>
      </span>
    </a>
    <nav class="links">
      <a href="/website#projects">Projects</a>
      <button type="button" class="contact-copy" data-email="valeapad@gmail.com">Contact</button>
      <!-- the owner's own links, only with ?me (see Website.astro) -->
      <a class="owner-only" href="/">Presentation</a>
      <a class="owner-only" href="/prototypes">Prototypes</a>
    </nav>
  </div>
</header>

<div class="copy-toast" role="status" aria-live="polite"></div>

<script>
  /* Contact copies the email and says so in a toast at the foot of the
     window. Bound by delegation, so it keeps working however the page was
     reached. */
  const email = "valeapad@gmail.com";
  let hide = 0;
  const copy = async () => {
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const t = document.createElement("textarea");
      t.value = email;
      t.style.cssText = "position:fixed;opacity:0";
      document.body.append(t);
      t.select();
      document.execCommand("copy");
      t.remove();
    }
    const toast = document.querySelector<HTMLElement>(".copy-toast");
    if (!toast) return;
    toast.textContent = `${email} copied to clipboard`;
    toast.classList.add("is-on");
    clearTimeout(hide);
    hide = window.setTimeout(() => toast.classList.remove("is-on"), 2600);
  };
  document.addEventListener("click", (e) => {
    if ((e.target as Element | null)?.closest(".contact-copy")) copy();
  });

  /* Arriving at /website#projects from another page: the browser jumps
     before the hero has settled, and lands short. Jump again once it has. */
  if (location.hash === "#projects") {
    const land = () =>
      document.getElementById("projects")?.scrollIntoView({ behavior: "instant" as ScrollBehavior });
    if (document.readyState === "complete") setTimeout(land, 50);
    else window.addEventListener("load", () => setTimeout(land, 50), { once: true });
  }
</script>

<style>
  .nav {
    /* its own layer in the page transition: it stays put while the new
       page rises under it (see styles/page-transition.css) */
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--w-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Full-bleed like the Framer header: 32px from the window edge, not the
       content column. Measured off valentinapadure.framer.website. */
    padding: 0.875rem clamp(1.25rem, 4.5cqw, 2rem);
  }

  .id {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .id img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .id-text {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    line-height: 1;
  }

  .id-name {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.005em;
  }

  .id-mail {
    font-size: 0.875rem;
    color: var(--w-ink-soft);
  }

  /* the owner's links (Presentation, Prototypes): only with ?me — see the
     inline script in Website.astro */
  :global(html:not(.is-owner)) .owner-only {
    display: none;
  }

  /* Contact is a button that reads as the links do */
  .contact-copy {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* the copied toast: a dark pill at the foot of the window */
  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    z-index: 50;
    padding: 14px 20px;
    border-radius: 12px;
    background: #222222;
    color: #fff;
    font-size: 1rem;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 12px);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copy-toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Framer's 24px between the links, on screen (÷ the desktop zoom) */
  .links {
    display: flex;
    gap: calc(24px / var(--zoom));
  }

  .links a,
  .links .contact-copy {
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    color: var(--w-ink-mute);
    transition: color 0.18s ease;
  }

  .links a:hover,
  .links .contact-copy:hover {
    color: var(--w-ink);
  }

  @media (max-width: 820px) {
    .id-name {
      font-size: 0.8125rem;
    }
  }

  /* phones: the name, email and both links don't fit on one row at 390px
     (the links ran 17px off screen). The email gives way — it's in the
     contact section too. */
  @media (max-width: 480px) {
    .links {
      gap: 1.1rem;
    }

    .id-mail {
      display: none;
    }
  }
</style>
