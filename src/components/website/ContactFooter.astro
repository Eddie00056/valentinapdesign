---
// The closing "Currently looking for new roles" block. Its rule spans the
// window, like every divider (--w-rule-line).
---

<section id="contact" class="w-wrap contact" data-reveal>
  <h2 class="contact-title" data-r>Currently looking for new roles</h2>
  <p class="contact-line" data-r>
    <a href="mailto:valeapad@gmail.com">valeapad@gmail.com</a>
    <span class="dot">•</span>
    <a href="tel:+19292716949">929-271-6949</a>
    <span class="dot">•</span>
    <a
      class="u"
      href="https://www.linkedin.com/in/valentinapadure"
      target="_blank"
      rel="noopener">Linkedin</a
    >
  </p>
</section>

<style>
  /* tucked right under its rule, no cavernous gap under the last line */
  .contact {
    position: relative;
    overflow-x: clip;
    padding-top: clamp(1.75rem, 1.25rem + 1.4cqw, 2.5rem);
    padding-bottom: clamp(2.5rem, 1.75rem + 2cqw, 3.75rem);
  }

  .contact::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(50% - 50vw / var(--zoom));
    width: calc(100vw / var(--zoom));
    right: auto;
    height: 1px;
    background: var(--w-rule-line);
    pointer-events: none;
  }

  .contact-title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.1rem + 2.6cqw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  /* Framer, on screen (÷ the desktop zoom): 15px under the heading, the
     items 18px white, 38px from one to the next with the dot centred */
  .contact-line {
    margin: calc(15px / var(--zoom)) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(14.5px / var(--zoom));
    font-size: calc(18px / var(--zoom));
    line-height: 1.2;
    color: var(--w-ink);
  }

  .contact-line a {
    color: var(--w-ink);
    transition: color 0.18s ease;
  }

  .contact-line a:hover {
    color: var(--w-ink-soft);
  }

  .contact-line .u {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-line .dot {
    color: var(--w-ink-faint);
  }
</style>
