---
/** A screenshot crop, placed on the 1920×1080 canvas at the rect it was cut from. */
interface Props {
  src: string;
  x: number;
  y: number;
  w: number;
  cls?: string;
  /** step index: the crop fades in on that arrow, like a label or a live frame */
  s?: number;
}
const { src, x, y, w, cls = "gd-media-shot", s } = Astro.props;
---

<img
  class:list={[cls, s != null && "gd-fade"]}
  data-s={s ?? undefined}
  src={`/website/case/gusto/v2/${src}.webp`}
  alt=""
  loading="lazy"
  draggable="false"
  style={`left:${x}%;top:${y}%;width:${w}%`}
/>
