---
/**
 * GUSTO portfolio deck — rebuilt in-house.
 *
 * Every slide is native HTML on a 1920×1080 canvas that scales to fit: real
 * type, screenshots re-rendered from the source PDF at 4× and placed at the
 * rect they were cut from, and — wherever a slide shows UI that exists in
 * the gallery — the live prototype itself, mounted in an iframe (`live`).
 * A handful of pure-image slides stay rasters.
 *
 * Slide data lives in `src/data/gustoDeck.json` (generated — see gen4.py).
 */
import deck from "../../../data/gustoDeck.json";
import overrides from "../../../data/gustoDeckOverrides.json";
import newText from "../../../data/deckNewText.json";
import Shot from "./DeckShot.astro";
import VedaSlide from "./VedaSlide.astro";
import { InlineClock } from "./InlineClock";
import { OwnershipStack } from "./OwnershipStack";

type Slide = Record<string, any>;
const slides = deck as Slide[];
const COUNT = slides.length;
const W = 1920;
const H = 1080;
const IMG = "/website/case/gusto/slides/";
const OWN = "/website/case/gusto/own/";

const isOn = (active: any, i: number) =>
  active === "all" || (Array.isArray(active) && active.includes(i));
const fs = (s: Slide) => (s.fs ? `font-size:${s.fs}px` : undefined);
const title = (s: Slide): string | undefined =>
  s.corner ?? s.heading ?? (s.kind === "titlecard" ? undefined : s.kicker);
/* `solo`: the deck is the whole window and starts at once — the
   presentation page is nothing but the presentation. Same as `?solo`. */
/* `theme="new"`: the new presentation UI (/presentation-new) — the same
   slides under the new chrome: #0b0b0b ground, Plus Jakarta Sans for the
   live type, and the underlined section label. */
/* `theme="veda"`: the new UI in the Veda direction (/presentation-veda) —
   every slide on black, Elza Text, mono section labels, and the text
   slides that carry a visual rebuilt in VedaSlide (VEDA below). `range`
   keeps only those slides in the show; the rest render empty and are
   skipped, so slide numbers (and #slide-N) stay the deck's own. */
/* `theme="mixed"`: the full deck (the site's front door) with ONLY the
   order entry case study (11–53) in the Veda direction — every other slide
   (the intro, the fractional shares study) renders exactly as the plain
   deck. The Veda show's extra slides reuse numbers past 53 that belong to
   other studies (55, 58–62, 67, 71, 72), so here they are appended past
   the deck's own (101…) and carry their Veda number as `vn`. The look is
   per slide: Veda slides carry .gd-v (and .gd-n, the new UI they build
   on), and every themed rule keys off those, never the section. */
const { solo = false, theme, range } = Astro.props as {
  solo?: boolean;
  theme?: "new" | "veda" | "mixed";
  range?: [number, number];
};
const newUI = theme === "new" || theme === "veda";
const veda = theme === "veda";
const mixed = theme === "mixed";
/* the Veda number a slide is keyed by (its own, or `vn` for an appended one) */
const key = (s: Slide): number => (s as any).vn ?? s.n;
/* this slide in the Veda look / in the new UI */
const isV = (s: Slide) => veda || (mixed && (!!(s as any).vn || (s.n >= 11 && s.n <= 53)));
const isN = (s: Slide) => newUI || isV(s);
/* veda: image slides keep their images and live frames, but their text
   baked into an image is rebuilt live — `corner` is the slide title,
   `hide` the shots it replaces, `rows` the label / value pairs */
const VEDA_MEDIA: Record<number, { corner?: string; hide?: string[]; rows?: [string, string[]][] }> = {
  17: {
    corner: "My role",
    hide: ["017c"],
    rows: [
      ["Team", ["2 Engineering teams", "1 DS Designer", "1 UX Researcher"]],
      ["Design timeline", ["6 months"]],
    ],
  },
};
const vm = (s: Slide) => (isV(s) ? VEDA_MEDIA[key(s)] : undefined);
/* veda: the show's running order — the user's Figma (Presentation — Veda
   (editable) (Copy), 2026-11-04), its main grid read row by row. Slide
   numbers stay the deck's own (#slide-N, overrides), so the slides the
   show adds take free numbers past the case study's range (55–61, the
   Figma frames' names) and render as VEDA / VEDA_CLONE below. */
const VEDA_ORDER = [
  11, 13, 14, 15, 16, 17, 18, 19, 20, 55, 58, 26, 30, 31, 32, 59, 33, 60, 67, 41, 42, 71, 39,
  38, 61, 72, 48, 50, 51, 52, 53,
];
/* veda: a slide shown twice — the number it shows again */
const VEDA_CLONE: Record<number, number> = { 59: 32, 61: 51, 62: 41 };
/* veda: a slide that continues the one before it (same widget, same
   place) — arriving from that slide it doesn't fade its contents in, so
   only what's new (30's and 59's eye-path dots) animates (the user: it
   "looks like a new page") */
const VEDA_SAME: Record<number, number> = { 30: 26, 59: 32 };
/* veda: every live widget quotes one instrument (the user, 2026-11-04):
   HOOD at $87.41 — passed to each embedded page as ?sym=&px= (see
   shared/quoteOverride); the website's own pages keep DASH / PLTR */
const VEDA_QUOTE = "sym=HOOD&px=87.41";
// the user's Figma (2026-11-04): the Problem #1 run carries its solution
const P1 = "Problem #1: Optimizing information hierarchy for faster scanning and quicker trade reactions.";
const P2 = "Problem #2: Improving trade ergonomics";
// the security-type menu and the widgets after it (19–22 in the show)
const STYPE = "Simplified the experience by security type.";
/* veda: fields of a media slide replaced for this show only (gustoDeck.json
   stays the other decks' source). `marks` are plain rules in canvas px. */
const VEDA_PATCH: Record<number, Slide> = {
  // 26 draws its widget exactly as 30 does (the crop + an empty path), not
  // the full-slide 026a, so the step to 30 is pixel-identical
  26: {
    corner: P1,
    shots: [{ src: "widget-tsla", x: 27.08, y: 27.42, w: 45.91, annot: { w: 609.41, h: 297.96, line: "#E03E1A", points: [] } }],
  },
  30: { corner: P1 },
  31: { corner: P1 },
  32: { corner: P1 },
  /* 59: the counterpart of 30's eye path. 30 zigzags across the legacy
     ticket; here the bracket is open on arrival and the eye runs straight
     down the new one in four stops, each centred on its section (the
     user's call): 1 the symbol, 2 the order details (quantity / type /
     duration), 3 the bracket order, 4 Sell / Buy — on the rule at x 660,
     one per click */
  59: {
    corner: P1,
    steps: 3,
    live: [{ ...slides[31].live[0], step: undefined, unstep: undefined, init: "openBracket" }],
    eye: { line: "#E03E1A", x: 660, ys: [336, 448, 636, 807] },
  },
  /* 38: placing an option order in IQ Edge (the user's "placing an option
     order iq edge.mp4", 2026-11-04), in slide 16's box: the same top and
     height, centred, so the two legacy recordings sit alike */
  38: {
    corner: P2,
    videos: [
      {
        src: "iq-edge-option-order.mp4",
        y: 14.72,
        w: (74.65 * (1768 / 1080)) / (1828 / 1080),
        x: (100 - (74.65 * (1768 / 1080)) / (1828 / 1080)) / 2,
      },
    ],
  },
  /* 51: the Questrade Pro case study's hero (/website/questrade-pro): the
     MacBook with the chain-to-order workspace playing itself (ChainLoop),
     embedded live — the page isolated to its .cs-laptop and fitted to the
     slide below the label (the user, 2026-11-04: in place of the bare
     chain + ticket frame) */
  51: {
    shots: [],
    live: [
      {
        // live pages resolve under /work/ — this one lives at /website/
        page: "../website/questrade-pro",
        // a touch smaller than full bleed (the user): ~78% of the slide
        x: 11,
        y: 12,
        w: 78,
        h: 80,
        vw: 1440,
        vh: 900,
        fit: ".cs-laptop",
        css:
          "body *{visibility:hidden!important}.cs-laptop,.cs-laptop *{visibility:visible!important}" +
          "[data-reveal],[data-r]{opacity:1!important;transform:none!important;translate:none!important}" +
          ".site-header,header{display:none!important}",
      },
    ],
  },
  /* 41: the existing widget (041a, left half, card x 209–749, top 339)
     and, in the empty right half, the final vision — 42's re-inked picture
     (042-final-ink) at 42's size (718 wide), centred on 1440, its top on
     the existing widget's (the user, 2026-11-04) */
  41: {
    corner: STYPE,
    // the final vision only (the user, 2026-11-04): the existing widget
    // stays on 62, the slide before; this one swaps it for the vision
    // centred both ways (the user, 2026-11-04), 718 wide (2157×1627 →
    // 541.6 tall); "Vision", on the house gap above it (the label's y sat
    // 38.65px over the picture's top before, kept)
    shots: [
      // 042-final-even: the ink cut with the card's right margin evened to
      // its left (12px of source, was ~44 — "more padding on the right"),
      // 2126 wide; drawn at the same scale (718 × 2126/2157), centred
      // 042-final-legs: the same card with its three leg rows rebuilt as
      // field rows (Buy chip · qty · expiry | strike | type, the user's
      // reference) — 1772 tall, so re-centred for its new height
      { src: "042-final-v3", x: ((960 - (718 * 2126) / 2157 / 2) / 1920) * 100, y: ((1080 - (718 * 1795) / 2157) / 2 / 1080) * 100, w: ((718 * 2126) / 2157 / 1920) * 100 },
    ],
    labels: [{ text: "Vision", x: 50, y: (((1080 - (718 * 1795) / 2157) / 2 - 38.65) / 1080) * 100, size: "lg" }],
  },
  /* 67: the legacy ticket's security-type menu (STK / OPT / STG) — the
     user's screenshot, centred (a free number: deck 67 belonged to the
     fractional chapter). The image: /website/case/gusto/v2/sectype-menu.webp */
  67: {
    bg: "black",
    corner: STYPE,
    // 1148×932 drawn 400 wide (325 tall) — well under half its pixels, so it
    // stays sharp on a 2× screen (at 702 it was upscaled: "the quality is
    // low"; 520 was still too big) — centred both ways
    shots: [{ src: "sectype-menu", x: (1920 / 2 - 200) / 19.2, y: (540 - (400 * 932) / 1148 / 2) / 10.8, w: 400 / 19.2 }],
    labels: [],
    live: [],
  },
  /* 50: Then / Now without the Then (the user, 2026-11-04): the legacy
     COIN ticket, its label and the divider go; the two new tickets, one
     48px gutter apart, centred on the slide both ways (tops level) */
  50: {
    shots: [],
    boxes: [],
    labels: [],
    live: [
      {
        ...slides[49].live[0],
        x: (100 - (25.68 * 2 + 2.5)) / 2,
        y: (100 - 35.28) / 2,
        h: 35.28,
        /* same height as the option ticket (243.07 native px), Sell/Buy
           pinned to the bottom so it sits level with Submit */
        css:
          slides[49].live[0].css +
          "html.is-bare .wshell.wshell{min-height:243.07px!important;display:flex!important;flex-direction:column!important}.ob-card{flex:1 1 auto!important;display:flex!important;flex-direction:column!important}.ob-foot{margin-top:auto!important;transform:translateY(3.71px)}",
      },
      { ...slides[49].live[1], x: (100 - (25.68 * 2 + 2.5)) / 2 + 25.68 + 2.5, y: (100 - 35.28) / 2 },
    ],
  },
  /* 16: the widget-based system, re-recorded (the user's "iq edge widget
     system new.mp4", 2026-11-04) */
  16: {
    /* the old recording's still (016a) goes: it is wider than the new
       video and showed down both sides */
    shots: [],
    /* 3536×2160, a touch squarer than the old 1828×1080: held to the old
       height (same top and bottom) and centred on the same axis */
    videos: [
      {
        ...slides[15].videos[0],
        src: "iq-edge-widget-system.mp4",
        w: (74.65 * (3536 / 2160)) / (1828 / 1080),
        x: 12.65 + (74.65 - (74.65 * (3536 / 2160)) / (1828 / 1080)) / 2,
      },
    ],
  },
  /* 72: after "Design system" — the input-field spec (/work/input-field-
     spec), its three boards captured at 2×: the states grid across the
     slide's full width (56 margins), the error rules and the notes side by
     side under it, 24 apart, tops level (the user, 2026-11-04) */
  72: {
    bg: "black",
    corner: "Design system: input field",
    // the set 1600 wide, centred (the user: "slightly smaller" than 1808)
    shots: [
      { src: "ifs-states", x: 160 / 19.2, y: 120 / 10.8, w: 1600 / 19.2 },
      { src: "ifs-rules", x: 160 / 19.2, y: (120 + (1600 * 1039) / 2944 + 24) / 10.8, w: 788 / 19.2 },
      { src: "ifs-notes", x: (160 + 788 + 24) / 19.2, y: (120 + (1600 * 1039) / 2944 + 24) / 10.8, w: 788 / 19.2 },
    ],
    labels: [],
    boxes: [],
    live: [],
    videos: [],
    connectors: undefined,
  },
  /* 61: the option chain alone on arrival (the user, 2026-11-04); a bid
     or ask opens the ticket in its reserved column, where it always sat */
  61: {
    live: [{ ...slides[50].live[0], page: "chain-to-order?static&bare&closed" }],
  },
  /* 62: 41 split in two (the user, 2026-11-04) — the existing widget alone
     first, in its place, then 41 adds the final vision beside it */
  62: {
    corner: STYPE,
    shots: [{ src: "041a", x: 0, y: 0, w: 100 }],
    labels: [{ text: "Existing widget", x: 24.6, y: 27.81, size: "lg" }],
  },
  /* 42: the MVP ticket alone, centred on the slide (the user, 2026-11-04:
     the final vision and the divider came off — the final vision now
     sits on 41). 45's own live MVP at 480 wide (k fits the rest of the
     show's tickets), its card ≈ 326 tall, so its top at 377 centres it */
  42: {
    corner: STYPE,
    shots: [],
    boxes: [],
    live: [
      {
        ...slides[44].live[0],
        mode: "width",
        x: ((960 - 240) / 1920) * 100,
        y: (377 / 1080) * 100,
        w: (480 / 1920) * 100,
        h: (slides[44].live[0].h * 480) / 519.4,
      },
    ],
    labels: [{ text: "MVP", x: 50, y: 33, size: "lg" }],
  },

};
/* veda: the copy as the user rewrote it in the Figma — label / text per
   slide, over deckNewText.json (which /presentation-new still reads).
   `fs` a type size of its own, `note` the user's red note-to-self. */
const VEDA_TEXT: Record<number, { label?: string; text?: string; fs?: number; note?: boolean; bg?: string; none?: boolean }> = {
  13: { fs: 64, text: "Questrade saw a 20% decline in active traders since 2021." },
  18: { text: "Design process" },
  19: { text: "“No one complains about order entry.\nDon’t fix what isn’t broken.”" },
  21: { text: "The current order placement is slow." },
  22: { label: "Goal", text: "Make trade submission fast and frictionless." },
  25: { label: P1, text: "How do we show our data?" },
  33: { label: "Impact", text: "Decreased time to submit an order by 25%." },
  // 62 reuses a number deckNewText gives another deck's statement: it's a
  // picture slide here (41's existing widget alone)
  62: { none: true },
  36: { label: P2, text: "Why?" },
  39: { text: "80% of Questrade’s revenue. 3x the steps." },
  57: { label: "Goal", text: "Make trade submission fast and frictionless\none step at a time.", bg: "black" },
  40: { text: "Simplify the experience by security type." },
};
/* the problem slides' four points (55, then 58 / 60 lighting one row each);
   the copy is the Figma's placeholder until the real points arrive */
// the user's three problems (2026-11-04); the solutions are still to come
const POINTS = [
  "Information layout isn’t optimized for trade ergonomics.",
  "Options workflows don’t align with how traders evaluate and build strategies.",
  "The option chain lacks a direct path to trade execution.",
];
const SOLUTIONS: string[] = [
  "Optimized information hierarchy for faster scanning and quicker trading reactions.",
  "Simplified the experience by security type.",
  "Enabled trade execution directly from the option chain.",
];
const STRATEGY = "Make order placement faster and seamless.";
const PLABEL = "Goal";
const VEDA: Record<number, { kind: any; num?: string; text?: string; label?: string; items?: string[]; solutions?: string[]; lit?: number[]; src?: string; steps?: number }> = {
  // the opener: the title alone, centred — no "Case study 01" label, no 01 (the user)
  11: { kind: "chapter", text: "Order entry<br />modernization", src: "/website/case/questrade/edge-web.webp" },
  12: { kind: "section" },
  // 14: the new web platform (Edge web, Beta V0.8) front-on in the MacBook
  14: { kind: "laptop", src: "/website/case/questrade/edge-web.webp" },
  15: { kind: "platforms" },
  18: { kind: "section" },
  // 21 is the statement alone (VEDA_TEXT); its dot rows follow as 54
  54: { kind: "bars", label: "Problem", text: "" },
  24: { kind: "section" },
  34: { kind: "section" },
  48: { kind: "section" },
  // the user's added section, before Final designs (66: a free number)
  66: { kind: "section", text: "Design system", label: "" },
  52: { kind: "section" },
  53: { kind: "impact" },
  // lit: the rows at full white (by problem); 55 all, 58 the first, 60 the second
  // built one click at a time (the user): the goal, then problem 1,
  // solution 1, problem 2… — 2 steps per row
  55: { kind: "points", label: PLABEL, text: STRATEGY, items: POINTS, solutions: SOLUTIONS, lit: [0, 1, 2], steps: 6 },
  58: { kind: "points", label: PLABEL, text: STRATEGY, items: POINTS, solutions: SOLUTIONS, lit: [0] },
  60: { kind: "points", label: PLABEL, text: STRATEGY, items: POINTS, solutions: SOLUTIONS, lit: [1] },
  // 60 again with problem 3 lit, before the chain-to-order slides (71: free)
  71: { kind: "points", label: PLABEL, text: STRATEGY, items: POINTS, solutions: SOLUTIONS, lit: [2] },
};
/* the hand edits keyed to the numbers this show reuses for its own slides
   (55, 57–61) belong to other decks' slides — drop them here */
const vedaOverrides = Object.fromEntries(
  Object.entries(overrides as Record<string, any>).filter(([k]) => !(+k > 53 && VEDA_ORDER.includes(+k))),
);
const vslide = (s: Slide): Slide => {
  if (!isV(s)) return s;
  const k = key(s);
  const base = VEDA_CLONE[k] ? { ...slides[VEDA_CLONE[k] - 1] } : s;
  const out = VEDA_PATCH[k] ? { ...base, ...VEDA_PATCH[k] } : base;
  return { ...out, n: s.n, vn: (s as any).vn } as Slide;
};
/* mixed: the Veda show's numbers past 53, appended after the deck's own */
const EXTRA = mixed ? VEDA_ORDER.filter((n) => n > 53) : [];
const mapN = (n: number) => (mixed && n > 53 ? slides.length + EXTRA.indexOf(n) + 1 : n);
const ALL: Slide[] = mixed
  ? [...slides, ...EXTRA.map((n, k) => ({ ...slides[n - 1], n: slides.length + k + 1, vn: n }) as Slide)]
  : slides;
const COUNT_ALL = ALL.length;
const inRange = (s: Slide) =>
  veda
    ? VEDA_ORDER.includes(s.n)
    : mixed
      ? isV(s)
        ? VEDA_ORDER.includes(key(s))
        : true
      : !range || (s.n >= range[0] && s.n <= range[1]);
/* the show's order: veda its own; mixed the deck's intro, then the Veda
   show (at its mapped numbers), then the rest of the deck — the fractional
   shares study as it was */
const RUN_ORDER = veda
  ? VEDA_ORDER
  : mixed
    ? [
        ...slides.filter((s) => s.n < 11).map((s) => s.n),
        ...VEDA_ORDER.map(mapN),
        ...slides.filter((s) => s.n > 53).map((s) => s.n),
      ]
    : undefined;
/* in the new UI, the slides that were only text baked into an image are
   rebuilt as live text in the statement template (data/deckNewText.json) */
/* new UI: screenshots re-cut for it — src → its replacement, and where
   the crop moved, its new rect on the canvas */
const NEW_SHOTS: Record<string, { src: string; x?: number; y?: number; w?: number }> = {
  // the COIN legacy ticket without its window title bar or quote strip
  "049c": { src: "049c-body", x: 5.55 + 32.55 * (12 / 1670), y: 24.63 + (32.55 * (79 / 1670) * 1920) / 1080, w: 32.55 * (1646 / 1670) },
};
const nt = (
  s: Slide,
): { label?: string; text?: string; bg?: string; fs?: number; note?: boolean; table?: { head: string[]; rows: (string | number)[][]; hideLast?: boolean } } | undefined => {
  if (!isN(s)) return undefined;
  const k = key(s);
  const base = (newText as Record<string, any>)[String(k)];
  if (isV(s) && VEDA_TEXT[k]?.none) return undefined;
  return isV(s) && VEDA_TEXT[k] ? { ...base, ...VEDA_TEXT[k] } : base;
};
---

<section class:list={["gd w-wrap", newUI && "gd-theme-new", veda && "gd-theme-veda"]}>
  <div class="gd-stage" data-count={COUNT_ALL} data-overrides={JSON.stringify(veda ? vedaOverrides : overrides)} data-order={RUN_ORDER ? JSON.stringify(RUN_ORDER) : undefined} data-solo={solo ? "1" : undefined}>
    <button type="button" class="gd-play">
      <span class="gd-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"
          ><path d="M8 5v14l11-7z"></path></svg
        >
      </span>
      <span class="gd-play-text">
        <span class="gd-play-label">Play the presentation</span>
        <span class="gd-play-sub"
          >{COUNT} slides · ← → to move · ⤢ for fullscreen · N for notes</span
        >
      </span>
    </button>

    <div class="gd-viewer" hidden>
      <div class="gd-frame">
        <div class="gd-canvas">
          {
            ALL.map(vslide).map((s) => !inRange(s) ? (
              <article class="gd-slide" data-n={s.n} data-out="1" hidden />
            ) : isV(s) && VEDA[key(s)] ? (
              <article class="gd-slide gd-slide--black gd-v gd-n" data-n={s.n} data-rebuilt="1" data-steps={VEDA[key(s)].steps || undefined} hidden>
                <VedaSlide
                  kind={VEDA[key(s)].kind}
                  num={VEDA[key(s)].num}
                  label={VEDA[key(s)].kind === "chapter" ? undefined : VEDA[key(s)].label ?? nt(s)?.label ?? s.corner ?? (VEDA[key(s)].kind === "impact" ? "Impact" : undefined)}
                  text={VEDA[key(s)].text ?? nt(s)?.text}
                  items={VEDA[key(s)].items}
                  solutions={VEDA[key(s)].solutions}
                  build={!!VEDA[key(s)].steps}
                  lit={VEDA[key(s)].lit}
                  src={VEDA[key(s)].src}
                />
              </article>
            ) : (
              <article
                class:list={["gd-slide", `gd-slide--${nt(s)?.bg ?? s.bg}`, isV(s) && "gd-v", isN(s) && "gd-n"]}
                data-n={s.n}
                data-steps={s.steps || undefined}
                data-enter={s.enter ? JSON.stringify(s.enter) : undefined}
                data-same={isV(s) && VEDA_SAME[key(s)] ? mapN(VEDA_SAME[key(s)]) : undefined}
                hidden
              >
                {nt(s) ? (
                  <div class="gd-nt">
                    {nt(s)!.label && <p class="gd-nt-label">{nt(s)!.label}</p>}
                    {nt(s)!.text && <h2 class:list={["gd-nt-text", nt(s)!.note && "is-note"]} style={nt(s)!.fs ? `font-size:${nt(s)!.fs}px;line-height:1.2` : undefined}>{nt(s)!.text}</h2>}
                    {nt(s)!.table && (
                      <div class:list={["gd-tbl", nt(s)!.table!.hideLast && "is-partial"]} role="table">
                        <div class="gd-tbl-row gd-tbl-head" role="row">
                          {nt(s)!.table!.head.map((h, ci, all) => (
                            <span role="columnheader">{nt(s)!.table!.hideLast && ci === all.length - 1 ? "" : h}</span>
                          ))}
                        </div>
                        {nt(s)!.table!.rows.map((r) => (
                          <div class="gd-tbl-row" role="row">
                            <span role="cell">{r[0]}</span>
                            {r.slice(1).map((v, ci, all) => (
                              <span role="cell">
                                {nt(s)!.table!.hideLast && ci === all.length - 1 ? null : v ? (
                                  <i class="gd-tbl-check" aria-label="Included" />
                                ) : (
                                  <i class="gd-tbl-check is-no" aria-label="Not included" />
                                )}
                              </span>
                            ))}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ) : (
                <>
                {(s.panels || []).map((p: any) => (
                  <div
                    class="gd-panel"
                    style={`left:${p.x}%;width:${p.w}%;top:${p.y}%;background:${p.c}`}
                  />
                ))}
                {/* every slide title is this one top-left element — whatever the
                    data calls it (corner / kicker / heading); a title card's
                    kicker stays inside its card */}
                {s.kind === "metrics" ? (
                  <div class="gd-corner-row">
                    <p class="gd-corner">{title(s)}</p>
                    {/* the clock is its own box: in ?edit it can be dragged and resized */}
                    <div class="gd-metrics-clock">
                      <InlineClock
                        client:visible
                        size={26}
                        borderColor="rgba(255,255,255,0.4)"
                        handColor="#fff"
                        dotColor="#fff"
                        dotBorder="#fff"
                      />
                    </div>
                  </div>
                ) : (
                  (vm(s)?.corner ?? title(s)) && <p class:list={["gd-corner", s.cornerInk && `is-${s.cornerInk}`]}>{vm(s)?.corner ?? title(s)}</p>
                )}
                {s.corner2 && (
                  <p class="gd-corner" style={`left:${s.corner2.x}%`}>
                    {s.corner2.text}
                  </p>
                )}
                {s.raster ? (
                  <img
                    class="gd-raster"
                    src={IMG + s.raster}
                    alt=""
                    loading="lazy"
                    draggable="false"
                  />
                ) : s.kind === "cover" ? (
                  <div class="gd-cover">
                    <h2>{s.title}</h2>
                    <p>{s.sub}</p>
                  </div>
                ) : s.kind === "divider" ? (
                  <div
                    class:list={[
                      "gd-divider",
                      `is-${s.size || "lg"}`,
                      `al-${s.align || "center"}`,
                      s.tone ? `tone-${s.tone}` : null,
                    ]}
                  >
                    <span style={fs(s)}>{s.text}</span>
                  </div>
                ) : s.kind === "titlecard" ? (
                  <>
                    <div class="gd-titlecard">
                      {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                      <h2 style={fs(s)}>{s.title}</h2>
                    </div>
                    {s.shot && <Shot {...s.shot} />}
                  </>
                ) : s.kind === "statement" || s.kind === "quote" ? (
                  <div class:list={["gd-statement", { "is-quote": s.kind === "quote", "is-top": s.kicker }]}>
                    <p class="gd-statement-t" style={[fs(s), s.fw && `font-weight:${s.fw}`].filter(Boolean).join(";") || undefined}>{s.text}</p>
                  </div>
                ) : s.kind === "numbered" ? (
                  <div class:list={["gd-numbered", s.size && `is-${s.size}`]}>
                    <ol>
                      {s.items.map((it: string, i: number) => (
                        <li class:list={[{ "is-dim": !isOn(s.active, i) }]}>
                          <span class="gd-num">{i + 1}.</span>
                          <span>{it}</span>
                        </li>
                      ))}
                    </ol>
                    {s.shot && <Shot {...s.shot} />}
                  </div>
                ) : s.kind === "metrics" ? (
                  <div class="gd-metrics">
                    <div class="gd-metrics-row">
                      <p class="gd-metrics-t">{s.items[0].text}</p>
                      <p class="gd-metrics-t">{s.items[1].text}</p>
                    </div>
                  </div>
                ) : s.kind === "checklist" ? (
                  <div class="gd-checklist">
                    <div class="gd-cl-cols">
                      {s.cols.map((col: any) => (
                        <div class="gd-cl-col">
                          <p class="gd-cl-title">{col.title}</p>
                          {col.sections.map((sec: any) => (
                            <div class="gd-cl-sec">
                              <p class="gd-cl-label">{sec.label}</p>
                              {sec.items.map(([t, ok]: [string, boolean]) => (
                                <p class:list={["gd-cl-item", { no: !ok }]}>
                                  <span class="gd-cl-mark">{ok ? "✓" : "✕"}</span>
                                  {t}
                                </p>
                              ))}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "figures" ? (
                  <div
                    class:list={[
                      "gd-figures",
                      `tone-${s.tone}`,
                      { "is-split": s.split, "is-top": s.layout === "top" },
                    ]}
                  >
                    <div class="gd-figrow">
                      {s.items.map(([n, l]: [string, string]) => (
                        <div class="gd-fig">
                          <span class="gd-fig-n">{n}</span>
                          <span class="gd-fig-l">{l}</span>
                        </div>
                      ))}
                    </div>
                    {s.award && (
                      <div class="gd-award">
                        <span class="gd-award-t">{s.award[0]}</span>
                        <span class="gd-award-s">{s.award[1]}</span>
                      </div>
                    )}
                  </div>
                ) : s.kind === "journey" ? (
                  <div class="gd-journey">
                    <div class:list={["gd-journey-row", { "has-active": s.active >= 0 }]}>
                      {s.steps.map((st: string, i: number) => (
                        <>
                          {i > 0 && <span class="gd-arrow" aria-hidden="true" />}
                          <span
                            class:list={[
                              "gd-step",
                              { "is-active": s.active === i, "is-dim": s.active >= 0 && s.active !== i },
                            ]}
                          >
                            {st}
                          </span>
                        </>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "twocol" ? (
                  <div class="gd-twocol">
                    <span>{s.left}</span>
                    <span>{s.right}</span>
                  </div>
                ) : s.kind === "role" ? (
                  <div class="gd-role">
                    <div class="gd-role-col">
                      {s.rows.map(([k, v]: [string, string]) => (
                        <div class="gd-role-row">
                          <p class="gd-kicker">{k}</p>
                          <p class="gd-role-v">{v}</p>
                        </div>
                      ))}
                    </div>
                    {s.shot && <Shot {...s.shot} />}
                  </div>
                ) : s.kind === "cards" ? (
                  <div class="gd-media">
                    {s.cards.map((c: any) => (
                      <div
                        class:list={["gd-card", `tone-${c.tone || "white"}`]}
                        style={`left:${c.x}%;top:${c.y}%;width:${c.w}%`}
                      >
                        <p class="gd-card-t">{c.title}</p>
                        <ul>
                          {c.points.map((pt: string) => (
                            <li>{pt}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ) : s.kind === "goals" ? (
                  <div class:list={["gd-media", { "is-plain": s.plain }]}>
                    {s.cards.map((c: any) => (
                      <div
                        class="gd-goal"
                        style={`left:${c.x}%;top:${c.y}%;width:${c.w}%;height:${c.h}%`}
                      >
                        {c.icon && (
                          <img
                            class:list={["gd-goal-i", { "is-hidden": c.icon.hide }]}
                            src={`/website/case/gusto/v2/${c.icon.src}.webp`}
                            alt=""
                            style={`width:${((c.icon.w / c.w) * 100).toFixed(2)}%`}
                          />
                        )}
                        <p class="gd-goal-t">{c.text}</p>
                      </div>
                    ))}
                  </div>
                ) : s.kind === "media" ? (
                  <div class="gd-media">
                    {s.bigTitle && (
                      <p class="gd-media-big">
                        {s.bigTitle}
                        {s.bigAccent && <span class="g">{s.bigAccent}</span>}
                      </p>
                    )}
                    {(s.marks || []).map((m: any) => (
                      <div class="gd-rule" style={`left:${m.x}px;top:${m.y}px;width:${m.w}px;height:${m.h}px;background:${m.c}`} />
                    ))}
                    {s.eye && (
                      /* an eye path in canvas px (59), drawn like 30's: a line
                         per click, each stop's number popping in as it lands.
                         Sizes are 30's annotation at its 1.446× scale */
                      <div class="gd-annot gd-annot--canvas">
                        <svg viewBox="0 0 1920 1080" aria-hidden="true">
                          {s.eye.ys.slice(1).map((y: number, k: number) => (
                            <line class="gd-annot-line" data-s={k + 1} x1={s.eye.x} y1={s.eye.ys[k]} x2={s.eye.x} y2={y} stroke={s.eye.line} pathLength="1" style="stroke-width:1.6" />
                          ))}
                          {s.eye.ys.map((y: number, k: number) => (
                            <g class="gd-annot-dot" data-s={k} transform={`translate(${s.eye.x} ${y})`}>
                              <g class="gd-annot-pop">
                                <circle r="11.6" fill={s.eye.line} />
                                <text text-anchor="middle" dy="4.8" style="font-size:13.7px">{k + 1}</text>
                              </g>
                            </g>
                          ))}
