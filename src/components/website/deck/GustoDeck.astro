---
/**
 * GUSTO portfolio deck — rebuilt in-house.
 *
 * Each slide is either a native `kind` (real HTML type on a 1920×1080 canvas
 * that scales to fit) or a pixel-faithful 3× raster of the Figma slide while
 * that slide is still being ported. Nothing regresses mid-migration.
 * Slide data + copy live in `src/data/gustoDeck.json`.
 */
import deck from "../../../data/gustoDeck.json";
import { FractionalOrderFlow } from "../../fractionalflow/FractionalOrderFlow";

type Slide = Record<string, any>;
const slides = deck as Slide[];
const COUNT = slides.length;
const IMG = "/website/case/gusto/slides/";

const nums = (a: any): number[] | "all" =>
  a === "all" ? "all" : Array.isArray(a) ? a : [];
const isOn = (active: any, i: number) =>
  active === "all" || (Array.isArray(active) && active.includes(i));
---

<section class="gd w-wrap">
  <div class="gd-stage" data-count={COUNT}>
    <button type="button" class="gd-play">
      <span class="gd-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"
          ><path d="M8 5v14l11-7z"></path></svg
        >
      </span>
      <span class="gd-play-text">
        <span class="gd-play-label">Play the presentation</span>
        <span class="gd-play-sub"
          >{COUNT} slides · ← → to move · ⤢ for fullscreen</span
        >
      </span>
    </button>

    <div class="gd-viewer" hidden>
      <div class="gd-frame">
        <div class="gd-canvas">
          {
            slides.map((s) => (
              <article
                class:list={["gd-slide", `gd-slide--${s.bg}`]}
                data-n={s.n}
                hidden
              >
                {s.raster ? (
                  <img
                    class="gd-raster"
                    src={IMG + s.raster}
                    alt=""
                    loading="lazy"
                    draggable="false"
                  />
                ) : s.kind === "cover" ? (
                  <div class="gd-cover">
                    <h2>{s.title}</h2>
                    <p>{s.sub}</p>
                  </div>
                ) : s.kind === "divider" ? (
                  <div
                    class:list={[
                      "gd-divider",
                      `is-${s.size || "lg"}`,
                      `al-${s.align || "center"}`,
                      s.tone ? `tone-${s.tone}` : null,
                    ]}
                  >
                    <span>{s.text}</span>
                  </div>
                ) : s.kind === "titlecard" ? (
                  <>
                    <div class="gd-titlecard">
                      {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                      <h2>{s.title}</h2>
                    </div>
                    {s.shot && (
                      <img
                        class="gd-media-shot"
                        src={`${IMG}../shots/${s.shot.src}.webp`}
                        alt=""
                        style={`left:${s.shot.x}%;top:${s.shot.y}%;width:${s.shot.w}%`}
                      />
                    )}
                  </>
                ) : s.kind === "statement" || s.kind === "quote" ? (
                  <div class:list={["gd-statement", { "is-quote": s.kind === "quote" }]}>
                    {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                    <p class="gd-statement-t">{s.text}</p>
                  </div>
                ) : s.kind === "numbered" ? (
                  <div class="gd-numbered">
                    {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                    <ol>
                      {s.items.map((it: string, i: number) => (
                        <li class:list={[{ "is-dim": !isOn(s.active, i) }]}>
                          <span class="gd-num">{i + 1}.</span>
                          <span>{it}</span>
                        </li>
                      ))}
                    </ol>
                    {s.shot && (
                      <img
                        class="gd-media-shot"
                        src={`${IMG}../shots/${s.shot.src}.webp`}
                        alt=""
                        style={`left:${s.shot.x}%;top:${s.shot.y}%;width:${s.shot.w}%`}
                      />
                    )}
                  </div>
                ) : s.kind === "checklist" ? (
                  <div class="gd-checklist">
                    {s.heading && <p class="gd-media-h">{s.heading}</p>}
                    <div class="gd-cl-cols">
                      {s.cols.map((col: any) => (
                        <div class="gd-cl-col">
                          <p class="gd-cl-title">{col.title}</p>
                          {col.sections.map((sec: any) => (
                            <div class="gd-cl-sec">
                              <p class="gd-cl-label">{sec.label}</p>
                              {sec.items.map(([t, ok]: [string, boolean]) => (
                                <p class:list={["gd-cl-item", { no: !ok }]}>
                                  <span class="gd-cl-mark">{ok ? "✓" : "✕"}</span>
                                  {t}
                                </p>
                              ))}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "twocard" ? (
                  <div class="gd-twocard">
                    {s.heading && <p class="gd-media-h">{s.heading}</p>}
                    <div class="gd-tc-row">
                      {s.cards.map((c: any) => (
                        <div class="gd-tc-card">
                          <p class="gd-tc-title">{c.title}</p>
                          {c.points.map((pt: string) => (
                            <p class="gd-tc-pt">{pt}</p>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "figures" ? (
                  <div class:list={["gd-figures", `tone-${s.tone}`]}>
                    <div class="gd-figrow">
                      {s.items.map(([n, l]: [string, string]) => (
                        <div class="gd-fig">
                          <span class="gd-fig-n">{n}</span>
                          <span class="gd-fig-l">{l}</span>
                        </div>
                      ))}
                    </div>
                    {s.note && <p class="gd-fig-note">{s.note}</p>}
                  </div>
                ) : s.kind === "journey" ? (
                  <div class="gd-journey">
                    {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                    <div class="gd-journey-row">
                      {s.steps.map((st: string, i: number) => (
                        <>
                          {i > 0 && <span class="gd-arrow" aria-hidden="true" />}
                          <span
                            class:list={["gd-step", { "is-active": s.active === i }]}
                          >
                            {st}
                          </span>
                        </>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "twocol" ? (
                  <div class="gd-twocol">
                    <span>{s.left}</span>
                    <span>{s.right}</span>
                  </div>
                ) : s.kind === "livefractional" ? (
                  <div class="gd-proto-wrap">
                    <FractionalOrderFlow client:visible bgOpacity={0.25} />
                  </div>
                ) : s.kind === "photobuild" ? (
                  <div class="gd-pb">
                    <div class="gd-pb-row">
                      <div class="gd-pb-item">
                        <p class="gd-pb-k">This is me</p>
                        <div class="gd-pb-card gd-pb-card--me">
                          <img src={`${IMG}../portrait.jpg`} alt="" />
                        </div>
                      </div>
                      {s.reveal >= 2 && (
                        <div class="gd-pb-item">
                          <p class="gd-pb-k">This is where I&rsquo;m from</p>
                          <div class="gd-pb-card gd-pb-card--map">
                            <img src={`${IMG}../shots/worldmap.webp`} alt="" />
                          </div>
                        </div>
                      )}
                    </div>
                    {s.reveal >= 3 && (
                      <div class="gd-pb-hobbies-wrap">
                        <p class="gd-pb-k">This is what I like</p>
                        <div class="gd-pb-hobbies">
                          {[
                            "shots/hobby-dance",
                            "hobby-cake",
                            "hobby-calligraphy",
                            "hobby-jitsu",
                            "hobby-flowers",
                          ].map((f) => (
                            <img
                              class="gd-pb-hobby"
                              src={`${IMG}../${f}.${f.startsWith("shots/") ? "webp" : "jpg"}`}
                              alt=""
                            />
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                ) : s.kind === "role" ? (
                  <div class="gd-role">
                    <div class="gd-role-col">
                      {s.rows.map(([k, v]: [string, string]) => (
                        <div class="gd-role-row">
                          <p class="gd-kicker">{k}</p>
                          <p class="gd-role-v">{v}</p>
                        </div>
                      ))}
                    </div>
                    {s.shot && (
                      <img
                        class="gd-role-shot"
                        src={`${IMG}../shots/${s.shot.src}.webp`}
                        alt=""
                        style={`left:${s.shot.x}%;top:${s.shot.y}%;width:${s.shot.w}%`}
                      />
                    )}
                  </div>
                ) : s.kind === "media" ? (
                  <div class="gd-media">
                    {s.heading && <p class="gd-media-h">{s.heading}</p>}
                    {s.bigTitle && (
                      <p class="gd-media-big">
                        {s.bigTitle}
                        {s.bigAccent && <span class="g">{s.bigAccent}</span>}
                      </p>
                    )}
                    {(s.labels || []).map((l: any) => (
                      <p class="gd-media-l" style={`left:${l.x}%;top:${l.y ?? 19}%`}>
                        {l.text}
                      </p>
                    ))}
                    {(s.shots || []).map((sh: any) => (
                      <img
                        class="gd-media-shot"
                        src={`${IMG}../shots/${sh.src}.webp`}
                        alt=""
                        style={`left:${sh.x}%;top:${sh.y}%;width:${sh.w}%`}
                      />
                    ))}
                  </div>
                ) : s.kind === "ownership" ? (
                  <div class:list={["gd-own", { "is-dim": s.dim }]}>
                    {s.reveal >= 1 && (
                      <div class="gd-own-card gd-own-head">
                        <div class="gd-own-pills">
                          {[0, 1, 2, 3].map(() => (
                            <span class="gd-pill">
                              <b>$271.01</b> <i>+$3.64 +3.09%</i>
                            </span>
                          ))}
                        </div>
                        <p>Design ownership spread across highest revenue products</p>
                      </div>
                    )}
                    {s.reveal >= 2 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">10+</span>
                        <span class="gd-own-l">active trader features</span>
                      </div>
                    )}
                    {s.reveal >= 3 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/adv-charting.webp`} alt="" />
                          <span>Advanced charting</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/sym-alerts.webp`} alt="" />
                          <span>Symbol alerts</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 4 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">3+</span>
                        <span class="gd-own-l">0→1 products launched</span>
                      </div>
                    )}
                    {s.reveal >= 5 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/rt-chip.webp`} alt="" class="is-chip" />
                          <span>Real time streaming</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/frac-trading.webp`} alt="" />
                          <span>Fractional trading</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 6 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/questrade-pro.webp`} alt="" />
                          <span>Questrade Pro</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${IMG}../own/edge-mobile.webp`} alt="" />
                          <span>Edge Mobile</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 7 && (
                      <div class="gd-own-card gd-own-team">
                        <p>Led 4 Product Designers + Multiple team initiatives</p>
                      </div>
                    )}
                    {s.reveal >= 8 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">2</span>
                        <span class="gd-own-l">awards</span>
                      </div>
                    )}
                  </div>
                ) : null}
              </article>
            ))
          }
        </div>
      </div>

      <button class="gd-edge gd-edge--prev" type="button" aria-label="Previous slide"
        ><span aria-hidden="true">‹</span></button
      >
      <button class="gd-edge gd-edge--next" type="button" aria-label="Next slide"
        ><span aria-hidden="true">›</span></button
      >
      <div class="gd-bar">
        <span class="gd-count" aria-live="polite">1 / {COUNT}</span>
        <button class="gd-fs" type="button" aria-label="Toggle fullscreen">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M8 3H4v4M16 3h4v4M8 21H4v-4M16 21h4v-4"></path></svg
          >
        </button>
      </div>
      <div class="gd-progress"><span></span></div>
    </div>
  </div>

  <p class="gd-note">
    <kbd>←</kbd> <kbd>→</kbd> or click the edges to move · rebuilt from the deck,
    slide for slide
  </p>
</section>

<script>
  const stage = document.querySelector<HTMLElement>(".gd-stage");
  if (stage) {
    const count = parseInt(stage.dataset.count || "0", 10);
    const play = stage.querySelector<HTMLButtonElement>(".gd-play")!;
    const viewer = stage.querySelector<HTMLElement>(".gd-viewer")!;
    const frame = stage.querySelector<HTMLElement>(".gd-frame")!;
    const canvas = stage.querySelector<HTMLElement>(".gd-canvas")!;
    const slides = Array.from(stage.querySelectorAll<HTMLElement>(".gd-slide"));
    const countEl = stage.querySelector<HTMLElement>(".gd-count")!;
    const bar = stage.querySelector<HTMLElement>(".gd-progress span")!;
    const fsBtn = stage.querySelector<HTMLButtonElement>(".gd-fs")!;
    const prevBtn = stage.querySelector<HTMLButtonElement>(".gd-edge--prev")!;
    const nextBtn = stage.querySelector<HTMLButtonElement>(".gd-edge--next")!;

    const W = 1920;
    const H = 1080;
    let i = 1;
    let started = false;

    const fit = () => {
      const fs = document.fullscreenElement === stage;
      const bw = fs ? window.innerWidth : frame.clientWidth;
      const bh = fs ? window.innerHeight : frame.clientWidth * (H / W);
      const s = Math.min(bw / W, bh / H);
      canvas.style.transform = `translate(${(bw - W * s) / 2}px, ${
        (bh - H * s) / 2
      }px) scale(${s})`;
      frame.style.height = fs ? "100%" : `${bw * (H / W)}px`;
    };

    const warm = (n: number) => {
      slides[n - 1]
        ?.querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((img) => (img.loading = "eager"));
    };

    const show = (n: number) => {
      i = Math.min(count, Math.max(1, n));
      slides.forEach(
        (el) => (el.hidden = parseInt(el.dataset.n || "0", 10) !== i),
      );
      warm(i);
      warm(i + 1);
      warm(i + 2);
      warm(i - 1);
      countEl.textContent = `${i} / ${count}`;
      bar.style.transform = `scaleX(${i / count})`;
    };

    const startShow = () => {
      if (started) return;
      started = true;
      play.hidden = true;
      viewer.hidden = false;
      stage.setAttribute("tabindex", "0");
      fit();
      show(1);
      stage.focus();
    };

    play.addEventListener("click", startShow);
    prevBtn.addEventListener("click", () => show(i - 1));
    nextBtn.addEventListener("click", () => show(i + 1));
    fsBtn.addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else stage.requestFullscreen?.();
    });
    document.addEventListener("fullscreenchange", () => {
      stage.classList.toggle("is-fs", document.fullscreenElement === stage);
      fit();
    });
    window.addEventListener("resize", () => started && fit());
    stage.addEventListener("keydown", (e) => {
      if (!started) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " ") {
        e.preventDefault();
        show(i + 1);
      } else if (k === "ArrowLeft" || k === "PageUp") {
        e.preventDefault();
        show(i - 1);
      } else if (k === "Home") {
        e.preventDefault();
        show(1);
      } else if (k === "End") {
        e.preventDefault();
        show(count);
      } else if (k === "f" || k === "F") {
        fsBtn.click();
      }
    });
  }
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");

  .gd {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    --gd-coral: #f7975c;
    --gd-font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .gd-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--w-line);
    border-radius: 14px;
    overflow: hidden;
    background: radial-gradient(
      120% 90% at 50% 0%,
      color-mix(in srgb, var(--w-accent) 9%, #0a0a0a) 0%,
      #070707 62%
    );
  }
  .gd-stage:fullscreen {
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    background: #000;
  }

  .gd-viewer {
    position: absolute;
    inset: 0;
  }
  .gd-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .gd-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: top left;
  }

  .gd-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-family: var(--gd-font);
    -webkit-font-smoothing: antialiased;
  }
  .gd-slide--black {
    background: #010101;
    color: #fff;
  }
  .gd-slide--white {
    background: #fff;
    color: #0b0b0b;
  }

  .gd-raster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ---- shared bits ---- */
  .gd-kicker {
    margin: 0 0 26px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }
  .gd-slide--white .gd-kicker {
    color: rgba(0, 0, 0, 0.5);
  }

  /* ---- cover ---- */
  .gd-cover {
    position: absolute;
    left: 4.6%;
    bottom: 20%;
  }
  .gd-cover h2 {
    margin: 0;
    font-size: 104px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .gd-cover p {
    margin: 18px 0 0;
    font-size: 46px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  /* ---- divider ---- */
  .gd-divider {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0 8%;
  }
  .gd-divider.al-center {
    justify-content: center;
    text-align: center;
  }
  .gd-divider.al-left {
    justify-content: flex-start;
  }
  .gd-divider span {
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .gd-divider.is-lg span {
    font-size: 104px;
  }
  .gd-divider.is-md span {
    font-size: 60px;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .gd-divider.tone-green span {
    color: #0a5a1e;
  }

  /* ---- titlecard ---- */
  .gd-titlecard {
    position: absolute;
    left: 4.6%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 48%;
  }
  .gd-titlecard h2 {
    margin: 0;
    font-size: 100px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.03;
    white-space: pre-line;
  }

  /* ---- statement / quote ---- */
  .gd-statement {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 9%;
  }
  .gd-statement-t {
    margin: 0;
    font-size: 52px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.02em;
    white-space: pre-line;
    text-wrap: balance;
  }
  .gd-statement.is-quote .gd-statement-t {
    font-size: 46px;
  }

  /* ---- numbered ---- */
  .gd-numbered {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 10%;
  }
  .gd-numbered .gd-kicker {
    margin-bottom: 40px;
  }
  .gd-numbered ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .gd-numbered li {
    display: flex;
    gap: 18px;
    font-size: 47px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .gd-numbered li.is-dim {
    color: rgba(255, 255, 255, 0.32);
  }
  .gd-slide--white .gd-numbered li.is-dim {
    color: rgba(0, 0, 0, 0.28);
  }
  .gd-num {
    opacity: 0.85;
  }
  .gd-numbered li.is-dim .gd-num {
    opacity: 1;
  }

  /* ---- figures ---- */
  .gd-figures {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .gd-figrow {
    display: flex;
    gap: 8%;
  }
  .gd-fig {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 620px;
    text-align: center;
  }
  .gd-fig-n {
    font-size: 220px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .tone-mint .gd-fig-n {
    background: linear-gradient(180deg, #b6f3d5 0%, #64d29c 52%, #33a86a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tone-green .gd-fig-n {
    color: #0a5a1e;
  }
  .gd-fig-l {
    font-size: 30px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #fff;
