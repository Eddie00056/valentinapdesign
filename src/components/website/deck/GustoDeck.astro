---
/**
 * GUSTO portfolio deck — rebuilt in-house.
 *
 * Every slide is native HTML on a 1920×1080 canvas that scales to fit: real
 * type, screenshots re-rendered from the source PDF at 4× and placed at the
 * rect they were cut from, and — wherever a slide shows UI that exists in
 * the gallery — the live prototype itself, mounted in an iframe (`live`).
 * A handful of pure-image slides stay rasters.
 *
 * Slide data lives in `src/data/gustoDeck.json` (generated — see gen4.py).
 */
import deck from "../../../data/gustoDeck.json";
import overrides from "../../../data/gustoDeckOverrides.json";
import Shot from "./DeckShot.astro";
import { InlineClock } from "./InlineClock";

type Slide = Record<string, any>;
const slides = deck as Slide[];
const COUNT = slides.length;
const W = 1920;
const H = 1080;
const IMG = "/website/case/gusto/slides/";
const OWN = "/website/case/gusto/own/";

const isOn = (active: any, i: number) =>
  active === "all" || (Array.isArray(active) && active.includes(i));
const fs = (s: Slide) => (s.fs ? `font-size:${s.fs}px` : undefined);
const title = (s: Slide): string | undefined =>
  s.corner ?? s.heading ?? (s.kind === "titlecard" ? undefined : s.kicker);
---

<section class="gd w-wrap">
  <div class="gd-stage" data-count={COUNT} data-overrides={JSON.stringify(overrides)}>
    <button type="button" class="gd-play">
      <span class="gd-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"
          ><path d="M8 5v14l11-7z"></path></svg
        >
      </span>
      <span class="gd-play-text">
        <span class="gd-play-label">Play the presentation</span>
        <span class="gd-play-sub"
          >{COUNT} slides · ← → to move · ⤢ for fullscreen · N for notes</span
        >
      </span>
    </button>

    <div class="gd-viewer" hidden>
      <div class="gd-frame">
        <div class="gd-canvas">
          {
            slides.map((s) => (
              <article
                class:list={["gd-slide", `gd-slide--${s.bg}`]}
                data-n={s.n}
                data-steps={s.steps || undefined}
                data-enter={s.enter ? JSON.stringify(s.enter) : undefined}
                hidden
              >
                {(s.panels || []).map((p: any) => (
                  <div
                    class="gd-panel"
                    style={`left:${p.x}%;width:${p.w}%;top:${p.y}%;background:${p.c}`}
                  />
                ))}
                {/* every slide title is this one top-left element — whatever the
                    data calls it (corner / kicker / heading); a title card's
                    kicker stays inside its card */}
                {s.kind === "metrics" ? (
                  <div class="gd-corner-row">
                    <p class="gd-corner">{title(s)}</p>
                    {/* the clock is its own box: in ?edit it can be dragged and resized */}
                    <div class="gd-metrics-clock">
                      <InlineClock
                        client:visible
                        size={26}
                        borderColor="rgba(255,255,255,0.4)"
                        handColor="#fff"
                        dotColor="#fff"
                        dotBorder="#fff"
                      />
                    </div>
                  </div>
                ) : (
                  title(s) && <p class:list={["gd-corner", s.cornerInk && `is-${s.cornerInk}`]}>{title(s)}</p>
                )}
                {s.corner2 && (
                  <p class="gd-corner" style={`left:${s.corner2.x}%`}>
                    {s.corner2.text}
                  </p>
                )}
                {s.raster ? (
                  <img
                    class="gd-raster"
                    src={IMG + s.raster}
                    alt=""
                    loading="lazy"
                    draggable="false"
                  />
                ) : s.kind === "cover" ? (
                  <div class="gd-cover">
                    <h2>{s.title}</h2>
                    <p>{s.sub}</p>
                  </div>
                ) : s.kind === "divider" ? (
                  <div
                    class:list={[
                      "gd-divider",
                      `is-${s.size || "lg"}`,
                      `al-${s.align || "center"}`,
                      s.tone ? `tone-${s.tone}` : null,
                    ]}
                  >
                    <span style={fs(s)}>{s.text}</span>
                  </div>
                ) : s.kind === "titlecard" ? (
                  <>
                    <div class="gd-titlecard">
                      {s.kicker && <p class="gd-kicker">{s.kicker}</p>}
                      <h2 style={fs(s)}>{s.title}</h2>
                    </div>
                    {s.shot && <Shot {...s.shot} />}
                  </>
                ) : s.kind === "statement" || s.kind === "quote" ? (
                  <div class:list={["gd-statement", { "is-quote": s.kind === "quote", "is-top": s.kicker }]}>
                    <p class="gd-statement-t" style={[fs(s), s.fw && `font-weight:${s.fw}`].filter(Boolean).join(";") || undefined}>{s.text}</p>
                  </div>
                ) : s.kind === "numbered" ? (
                  <div class:list={["gd-numbered", s.size && `is-${s.size}`]}>
                    <ol>
                      {s.items.map((it: string, i: number) => (
                        <li class:list={[{ "is-dim": !isOn(s.active, i) }]}>
                          <span class="gd-num">{i + 1}.</span>
                          <span>{it}</span>
                        </li>
                      ))}
                    </ol>
                    {s.shot && <Shot {...s.shot} />}
                  </div>
                ) : s.kind === "metrics" ? (
                  <div class="gd-metrics">
                    <div class="gd-metrics-row">
                      <p class="gd-metrics-t">{s.items[0].text}</p>
                      <p class="gd-metrics-t">{s.items[1].text}</p>
                    </div>
                  </div>
                ) : s.kind === "checklist" ? (
                  <div class="gd-checklist">
                    <div class="gd-cl-cols">
                      {s.cols.map((col: any) => (
                        <div class="gd-cl-col">
                          <p class="gd-cl-title">{col.title}</p>
                          {col.sections.map((sec: any) => (
                            <div class="gd-cl-sec">
                              <p class="gd-cl-label">{sec.label}</p>
                              {sec.items.map(([t, ok]: [string, boolean]) => (
                                <p class:list={["gd-cl-item", { no: !ok }]}>
                                  <span class="gd-cl-mark">{ok ? "✓" : "✕"}</span>
                                  {t}
                                </p>
                              ))}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "figures" ? (
                  <div
                    class:list={[
                      "gd-figures",
                      `tone-${s.tone}`,
                      { "is-split": s.split, "is-top": s.layout === "top" },
                    ]}
                  >
                    <div class="gd-figrow">
                      {s.items.map(([n, l]: [string, string]) => (
                        <div class="gd-fig">
                          <span class="gd-fig-n">{n}</span>
                          <span class="gd-fig-l">{l}</span>
                        </div>
                      ))}
                    </div>
                    {s.award && (
                      <div class="gd-award">
                        <span class="gd-award-t">{s.award[0]}</span>
                        <span class="gd-award-s">{s.award[1]}</span>
                      </div>
                    )}
                  </div>
                ) : s.kind === "journey" ? (
                  <div class="gd-journey">
                    <div class:list={["gd-journey-row", { "has-active": s.active >= 0 }]}>
                      {s.steps.map((st: string, i: number) => (
                        <>
                          {i > 0 && <span class="gd-arrow" aria-hidden="true" />}
                          <span
                            class:list={[
                              "gd-step",
                              { "is-active": s.active === i, "is-dim": s.active >= 0 && s.active !== i },
                            ]}
                          >
                            {st}
                          </span>
                        </>
                      ))}
                    </div>
                  </div>
                ) : s.kind === "twocol" ? (
                  <div class="gd-twocol">
                    <span>{s.left}</span>
                    <span>{s.right}</span>
                  </div>
                ) : s.kind === "role" ? (
                  <div class="gd-role">
                    <div class="gd-role-col">
                      {s.rows.map(([k, v]: [string, string]) => (
                        <div class="gd-role-row">
                          <p class="gd-kicker">{k}</p>
                          <p class="gd-role-v">{v}</p>
                        </div>
                      ))}
                    </div>
                    {s.shot && <Shot {...s.shot} />}
                  </div>
                ) : s.kind === "cards" ? (
                  <div class="gd-media">
                    {s.cards.map((c: any) => (
                      <div
                        class:list={["gd-card", `tone-${c.tone || "white"}`]}
                        style={`left:${c.x}%;top:${c.y}%;width:${c.w}%`}
                      >
                        <p class="gd-card-t">{c.title}</p>
                        <ul>
                          {c.points.map((pt: string) => (
                            <li>{pt}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ) : s.kind === "goals" ? (
                  <div class:list={["gd-media", { "is-plain": s.plain }]}>
                    {s.cards.map((c: any) => (
                      <div
                        class="gd-goal"
                        style={`left:${c.x}%;top:${c.y}%;width:${c.w}%;height:${c.h}%`}
                      >
                        {c.icon && (
                          <img
                            class:list={["gd-goal-i", { "is-hidden": c.icon.hide }]}
                            src={`/website/case/gusto/v2/${c.icon.src}.webp`}
                            alt=""
                            style={`width:${((c.icon.w / c.w) * 100).toFixed(2)}%`}
                          />
                        )}
                        <p class="gd-goal-t">{c.text}</p>
                      </div>
                    ))}
                  </div>
                ) : s.kind === "media" ? (
                  <div class="gd-media">
                    {s.bigTitle && (
                      <p class="gd-media-big">
                        {s.bigTitle}
                        {s.bigAccent && <span class="g">{s.bigAccent}</span>}
                      </p>
                    )}
                    {(s.boxes || []).map((b: any) => (
                      <div
                        class="gd-box"
                        style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%;background:${b.c}`}
                      />
                    ))}
                    {(s.labels || []).map((l: any) => (
                      <p
                        class:list={["gd-media-l", l.size && `is-${l.size}`, l.tone && `tone-${l.tone}`, l.s && "gd-fade", l.wrap && "is-wrap"]}
                        data-s={l.s ?? undefined}
                        style={`left:${l.x}%;top:${l.y ?? 19}%`}
                      >
                        {l.text}
                        {l.accent && <span class="gd-media-l-accent">{l.accent}</span>}
                      </p>
                    ))}
                    {(s.shots || []).map((sh: any) =>
                      sh.annot ? (
                        /* an image with a drawn path over it, built one line per click */
                        <div
                          class="gd-annot"
                          style={`left:${sh.x}%;top:${sh.y}%;width:${sh.w}%;aspect-ratio:${sh.annot.w}/${sh.annot.h}`}
                        >
                          <img class="gd-annot-img" src={`/website/case/gusto/v2/${sh.src}.webp`} alt="" draggable="false" />
                          <svg viewBox={`0 0 ${sh.annot.w} ${sh.annot.h}`} aria-hidden="true">
                            {(sh.annot.boxes || []).map(([x, y, w, h]: number[]) => (
                              <rect class="gd-annot-box" x={x} y={y} width={w} height={h} stroke={sh.annot.line} />
                            ))}
                            {(sh.annot.lines || []).map((pts: number[]) => (
                              <polyline class="gd-annot-box" points={pts.join(" ")} stroke={sh.annot.line} />
                            ))}
                            {(sh.annot.points || []).slice(1).map((pt: any, k: number) => (
                              <line
                                class="gd-annot-line"
                                data-s={k + 1}
                                x1={sh.annot.points[k].at[0]}
                                y1={sh.annot.points[k].at[1]}
                                x2={pt.at[0]}
                                y2={pt.at[1]}
                                stroke={sh.annot.line}
                                pathLength="1"
                              />
                            ))}
                            {(sh.annot.points || []).map((pt: any, k: number) => (
                              <g class="gd-annot-dot" data-s={k} transform={`translate(${pt.at[0]} ${pt.at[1]})`}>
                                <g class="gd-annot-pop">
                                  <circle r="8" fill={pt.c} />
                                  <text text-anchor="middle" dy="3.3">{pt.n}</text>
                                </g>
                              </g>
                            ))}
                          </svg>
                          {(sh.annot.notes || []).map((nt: any) => (
                            <p
                              class:list={["gd-annot-note", `is-${nt.anchor}`]}
                              style={`left:${(nt.at[0] / sh.annot.w) * 100}%;top:${(nt.at[1] / sh.annot.h) * 100}%`}
                            >
                              {nt.text}
                            </p>
                          ))}
                        </div>
                      ) : (
                        <Shot {...sh} />
                      ),
                    )}
                    {(s.videos || []).map((v: any) => (
                      <video
                        class="gd-media-shot"
                        style={`left:${v.x}%;top:${v.y}%;width:${v.w}%${v.clip ? `;clip-path:inset(${v.clip.join("% ")}%)` : ""}`}
                        src={`/website/case/gusto/videos/${v.src}`}
                        autoplay
                        loop
                        muted
                        playsinline
                      />
                    ))}
                    {s.connectors && (
                      <svg class="gd-connectors" viewBox="0 0 1920 1080" aria-hidden="true">
                        {s.connectors.map((c: any) => (
                          <polyline
                            class="gd-fade"
                            data-s={c.s ?? undefined}
                            points={c.points.map((p: number[]) => p.join(",")).join(" ")}
                          />
                        ))}
                      </svg>
                    )}
                    {(s.marks || []).map((m: any) => (
                      <span
                        class="gd-mark"
                        aria-hidden="true"
                        style={`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`}
                      />
                    ))}
                  </div>
                ) : s.kind === "ownership" ? (
                  <div class:list={["gd-own", { "is-dim": s.dim }]}>
                    {s.reveal >= 1 && (
                      <div class="gd-own-card gd-own-head">
                        <div class="gd-own-pills">
                          {[0, 1, 2, 3].map(() => (
                            <span class="gd-pill">
                              <b>$271.01</b> <i>+$3.64 +3.09%</i>
                            </span>
                          ))}
                        </div>
                        <p>Design ownership spread across highest revenue products</p>
                      </div>
                    )}
                    {s.reveal >= 2 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">10+</span>
                        <span class="gd-own-l">active trader features</span>
                      </div>
                    )}
                    {s.reveal >= 3 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${OWN}adv-charting.webp`} alt="" />
                          <span>Advanced charting</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${OWN}sym-alerts.webp`} alt="" />
                          <span>Symbol alerts</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 4 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">3+</span>
                        <span class="gd-own-l">0→1 products launched</span>
                      </div>
                    )}
                    {s.reveal >= 5 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          {/* drawn, not the old rt-chip.webp crop — that bitmap carried
                              the export's darker backdrop, a box on the card */}
                          <span class="gd-own-chip">
                            <span class="gd-pill">
                              <b>$271.01</b> <i>+$3.64 +3.09%</i>
                            </span>
                          </span>
                          <span>Real time streaming</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${OWN}frac-trading.webp`} alt="" />
                          <span>Fractional trading</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 6 && (
                      <div class="gd-own-icons">
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${OWN}questrade-pro.webp`} alt="" />
                          <span>Questrade Pro</span>
                        </div>
                        <div class="gd-own-card gd-own-icon">
                          <img src={`${OWN}edge-mobile.webp`} alt="" />
                          <span>Edge Mobile</span>
                        </div>
                      </div>
                    )}
                    {s.reveal >= 7 && (
                      <div class="gd-own-card gd-own-team">
                        <p>Led 4 Product Designers + Multiple team initiatives</p>
                      </div>
                    )}
                    {s.reveal >= 8 && (
                      <div class="gd-own-card gd-own-metric">
                        <span class="gd-own-n">2</span>
                        <span class="gd-own-l">awards</span>
                      </div>
                    )}
                  </div>
                ) : null}
                {(s.live || []).map((l: any) => {
                  const bw = (l.w / 100) * W;
                  const bh = (l.h / 100) * H;
                  const k = bw / l.vw;
                  const vh = l.fit ? l.vh : Math.round(bh / k);
                  return (
                    <div
                      class:list={["gd-live", { "is-clip": l.clip, "gd-fade": l.s != null, "is-rise": l.rise }]}
                      data-s={l.s ?? undefined}
                      data-stack={l.stack ? "" : undefined}
                      style={`left:${l.x}%;top:${l.y}%;width:${l.w}%;height:${l.h}%`}
                    >
                      <iframe
                        title={l.page}
                        data-src={`/work/${l.page}`}
                        data-css={l.css || ""}
                        data-fit={l.fit || ""}
                        data-pad={l.pad || 0}
                        data-mode={l.mode || ""}
                        data-init={l.init || ""}
                        data-arrive={l.arrive || undefined}
                        data-step={l.step || undefined}
                        data-unstep={l.unstep || undefined}
                        data-clip={l.clip ? "1" : ""}
                        data-bw={bw}
                        data-bh={bh}
                        tabindex="-1"
                        style={`width:${l.vw}px;height:${vh}px;zoom:${k.toFixed(5)}`}
                      />
                    </div>
                  );
                })}
              </article>
            ))
          }
        </div>
      </div>

      <button class="gd-edge gd-edge--prev" type="button" aria-label="Previous slide"
        ><span aria-hidden="true">‹</span></button
      >
      <button class="gd-edge gd-edge--next" type="button" aria-label="Next slide"
        ><span aria-hidden="true">›</span></button
      >
      <div class="gd-bar">
        <span class="gd-count" aria-live="polite">1 / {COUNT}</span>
        <div class="gd-bar-actions">
          <button class="gd-notes" type="button" aria-label="Slide notes (private)" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M6 3h8l5 5v13H6z"></path><path d="M14 3v5h5"></path><path d="M9 12h6M9 16h4"></path></svg
            >
          </button>
          <button class="gd-fs" type="button" aria-label="Toggle fullscreen">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M8 3H4v4M16 3h4v4M8 21H4v-4M16 21h4v-4"></path></svg
            >
          </button>
        </div>
      </div>
      <div class="gd-progress"><span></span></div>
    </div>
  </div>

  <p class="gd-note">
    <kbd>←</kbd> <kbd>→</kbd> or click the edges to move · rebuilt from the deck,
    slide for slide
  </p>
</section>

<script>
  import { applyOverrides } from "./deckOverrides";
  import type { Overrides } from "./deckOverrides";
  import { mountNotes } from "./deckNotes";

  const stage = document.querySelector<HTMLElement>(".gd-stage");
  if (stage) {
    // hand edits made in ?edit mode (gustoDeckOverrides.json), on top of the generated slides
    const overrides: Overrides = JSON.parse(stage.dataset.overrides || "{}");
    applyOverrides(stage, overrides);
    const count = parseInt(stage.dataset.count || "0", 10);
    const play = stage.querySelector<HTMLButtonElement>(".gd-play")!;
    const viewer = stage.querySelector<HTMLElement>(".gd-viewer")!;
    const frame = stage.querySelector<HTMLElement>(".gd-frame")!;
    const canvas = stage.querySelector<HTMLElement>(".gd-canvas")!;
    const slides = Array.from(stage.querySelectorAll<HTMLElement>(".gd-slide"));
    const countEl = stage.querySelector<HTMLElement>(".gd-count")!;
    const bar = stage.querySelector<HTMLElement>(".gd-progress span")!;
    const fsBtn = stage.querySelector<HTMLButtonElement>(".gd-fs")!;
    const prevBtn = stage.querySelector<HTMLButtonElement>(".gd-edge--prev")!;
    const nextBtn = stage.querySelector<HTMLButtonElement>(".gd-edge--next")!;
    const notesBtn = stage.querySelector<HTMLButtonElement>(".gd-notes")!;
    const notesUI = mountNotes(stage);

    const W = 1920;
    const H = 1080;
    let i = 1;
    let started = false;

    const fit = () => {
      const fs = document.fullscreenElement === stage;
      const solo = stage.classList.contains("is-solo");
      const bw = fs || solo ? window.innerWidth : frame.clientWidth;
      const bh = fs || solo ? window.innerHeight : frame.clientWidth * (H / W);
      const s = Math.min(bw / W, bh / H);
      canvas.style.transform = `translate(${(bw - W * s) / 2}px, ${
        (bh - H * s) / 2
      }px) scale(${s})`;
      frame.style.height = fs || solo ? "100%" : `${bw * (H / W)}px`;
    };

    /* Hidden slides (toggled in ?edit) drop out of the show: arrows skip
       them and the counter doesn't count them. Edit mode still shows them. */
    const editing = import.meta.env.DEV && new URLSearchParams(location.search).has("edit");
    const skipped = (n: number) => !editing && slides[n - 1]?.dataset.skip === "1";
    const order = () => slides.map((el) => parseInt(el.dataset.n || "0", 10)).filter((n) => !skipped(n));
    const nearest = (n: number) => {
      const o = order();
      return o.find((x) => x >= n) ?? o[o.length - 1] ?? 1;
    };
    /* Builds: a slide with data-steps reveals its [data-s] parts one per
       click before the deck moves on (slide 30's path). Arriving forwards
       starts the build at 0; arriving backwards shows it finished. */
    const steps = (n: number) => parseInt(slides[n - 1]?.dataset.steps || "0", 10);
    let build = 0;
    let nextBuild: number | null = null;
    /* A live frame can take part in a build: `step` is the INIT that plays
       when the build reaches 1 (slide 32's bracket order attaching, at the
       click, so it animates in), `unstep` the one that undoes it going back.
       Off-slide frames are never stepped, and a frame that loads late picks
       the state up when it is revealed. */
    const applyStep = (f: HTMLIFrameElement) => {
      if (!f.dataset.step || !f.dataset.loaded) return;
      const on = f.closest(".gd-slide") === slides[i - 1] && build >= 1;
      if (on === !!f.dataset.stepped) return;
      try {
        const name = on ? f.dataset.step : f.dataset.unstep;
        if (name) INIT[name]?.(f.contentWindow, f.contentDocument!);
      } catch {
        /* same-origin always */
      }
      if (on) f.dataset.stepped = "1";
      else delete f.dataset.stepped;
    };
    const setBuild = (n: number, v: number) => {
      build = v;
      slides[n - 1]?.querySelectorAll<HTMLElement | SVGElement>("[data-s]").forEach((el) =>
        el.classList.toggle("is-on", parseInt(el.dataset.s || "0", 10) <= v),
      );
      slides[n - 1]?.querySelectorAll<HTMLIFrameElement>(".gd-live iframe[data-step]").forEach(applyStep);
    };
    const step = (dir: number) => {
      const max = steps(i);
      if (max && dir > 0 && build < max) return setBuild(i, build + 1);
      if (max && dir < 0 && build > 0) return setBuild(i, build - 1);
      const o = order();
      const at = o.indexOf(i);
      const idx = at < 0 ? o.findIndex((x) => x > i) - (dir > 0 ? 0 : 1) : at + dir;
      const to = o[Math.max(0, Math.min(o.length - 1, idx))] ?? i;
      nextBuild = dir > 0 ? 0 : steps(to);
      show(to);
    };

    const warm = (n: number) => {
      slides[n - 1]
        ?.querySelectorAll<HTMLImageElement>("img[loading='lazy']")
        .forEach((img) => (img.loading = "eager"));
    };

    /* Keys pressed inside a live prototype still drive the deck — unless
       the viewer is typing into one of its fields. */
    const NAV = new Set(["ArrowRight", "ArrowLeft", "PageDown", "PageUp", "Home", "End", " ", "f", "F"]);
    const typing = (t: EventTarget | null) => {
      const el = t as HTMLElement | null;
      return !!el && (/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || el.isContentEditable);
    };

    /* Live prototypes are real pages. They only exist while their slide is
       on screen or one step away, so a deck of them never has more than a
       few ticking at once. Each is re-grounded to transparent so the work
       sits on the slide rather than on its gallery tile. */
    const mount = (f: HTMLIFrameElement) => {
      if (f.getAttribute("src")) return;
      f.addEventListener(
        "load",
        () => {
          try {
            const d = f.contentDocument!;
            const st = d.createElement("style");
            st.textContent =
              "html,body,html[data-embed],html[data-embed] body{background:transparent!important}" +
              // page chrome that isn't the work: the dev toolbar (localhost) and the review-comments button
              "astro-dev-toolbar,.cmt-root,.back,.oc-back{display:none!important}" +
              (f.dataset.css || "");
            d.head.appendChild(st);
            f.contentWindow!.addEventListener("keydown", (e) => {
              if (!NAV.has(e.key) || typing(e.target)) return;
              e.preventDefault();
              stage.focus();
              stage.dispatchEvent(new KeyboardEvent("keydown", { key: e.key }));
            });
          } catch {
            /* cross-origin never happens here; the page just keeps its ground */
          }
          f.dataset.loaded = "1";
          if (f.dataset.init === "mute") runInit(f);
          reveal(f);
        },
        { once: true },
      );
      f.src = f.dataset.src!;
    };
    /* A `fit` prototype is measured, not guessed: once the page has laid
       out, its component (the ticket's card, the phone's frame) is scaled
       and centred onto the slide rect it replaces. Measured once — a card
       that later grows (a bracket order opening) grows from there rather
       than rescaling under the pointer. */
    const place = async (f: HTMLIFrameElement) => {
      const sel = f.dataset.fit;
      const wrap = f.parentElement as HTMLElement;
      const d = f.contentDocument;
      if (!d) return;
      const bw = parseFloat(f.dataset.bw!);
      const bh = parseFloat(f.dataset.bh!);
      if (!sel) {
        wrap.style.clipPath = "";
        return;
      }
      // the union of every match — "the chain AND its ticket" is one target
      const measure = () => {
        const rs = Array.from(d.querySelectorAll(sel))
          .map((e) => e.getBoundingClientRect())
          .filter((q) => q.width > 0 && q.height > 0);
        if (!rs.length) return null;
        const l = Math.min(...rs.map((q) => q.left));
        const t = Math.min(...rs.map((q) => q.top));
        return {
          left: l,
          top: t,
          width: Math.max(...rs.map((q) => q.right)) - l,
          height: Math.max(...rs.map((q) => q.bottom)) - t,
        };
      };
      let r = measure();
      for (let n = 0; n < 50 && !r; n++) {
        await new Promise((res) => setTimeout(res, 100));
        r = measure();
      }
      if (!r) return;
      await new Promise((res) => setTimeout(res, 150)); // let entry springs settle
      r = measure() || r;
      const pad = parseFloat(f.dataset.pad || "0");
      /* "width": the slide draws this device larger than the slide is tall
         — it fills the rect's width from the top and bleeds off the bottom
         edge, which the slide clips. Default: contain, centred. */
      const byWidth = f.dataset.mode === "width";
      const k = byWidth
        ? bw / r.width
        : Math.min((bw - 2 * pad) / r.width, (bh - 2 * pad) / r.height);
      const ox = bw / 2 - (r.left + r.width / 2) * k;
      const oy = byWidth ? -r.top * k : bh / 2 - (r.top + r.height / 2) * k;
      /* `zoom`, not `transform: scale()`. A transformed iframe is a GPU layer
         rasterized once and then stretched, so shrinking a 1440px page onto
         the slide read soft on real displays. Zoom lays the page out at its
         final size, so its text is drawn crisp. Zoom also scales the
         element's own left/top, hence the division. */
      f.style.zoom = String(k);
      f.style.left = `${ox / k}px`;
      f.style.top = `${oy / k}px`;
      /* The iframe is a whole page, mostly transparent and far wider than
         the work — left unclipped it swallows clicks meant for whatever sits
         beside it. Clip (clip-path clips hit-testing too) to the card's
         column only: vertically it stays open, so a card that grows after
         it was measured — an entry spring, a bracket order opening, a
         dropdown — is never cut. A "width" card sits on the rect's top and
         only grows down, so its top is closed just above the card: open,
         it swallowed clicks on a card stacked above it (slide 32). */
      if (f.dataset.clip) {
        wrap.style.clipPath = "";
        return;
      }
      const cw = r.width * k;
      const cl = (bw - cw) / 2;
      const m = 20;
      const top = byWidth ? -m : -2000;
      wrap.style.clipPath = `inset(${top}px ${bw - cl - cw - m}px -2000px ${cl - m}px)`;
    };
    /* Named per-slide actions run inside a prototype after it has loaded —
       putting it in the state the slide shows. Kept here, not in the
       prototypes, so no gallery page needs to know it is in a deck. */
    const INIT: Record<string, (w: any, d: Document) => void> = {
      // slide 81: the quote screen with its fractional banner already open
      openFractional: (_w, d) =>
        d.querySelector<HTMLElement>('[aria-label="Fractional shares"]')?.click(),
      // slide 32: the stock ticket with its bracket order already attached
      openBracket: (_w, d) => {
        const btn = [...d.querySelectorAll<HTMLElement>("button")].find((b) =>
          b.textContent?.includes("Bracket order"),
        );
        btn?.click();
      },
      // ...and taken off again (the build step going back)
      closeBracket: (_w, d) => d.querySelector<HTMLElement>('[aria-label="Remove bracket order"]')?.click(),
      /* slide 79, "Beta release": the entry's css hides the open banner
         (the state stays open, so the chip never mounts — the tag is the
         fractional affordance here) and this sets a "Fractional" tag beside
         the top icons in the banner's own colours (its strip #dce9f7, its
         text #0066db), boxed like the icons beside it: 32 tall, 8 of
         padding, the row's 8 gap. */
      /* slide 79, "Original design": the PDF draws this column as HOOD —
         the quote screen before fractional existed — so the name reads
         Robinhood here; the entry's css hides the chip and the banner. */
      /* slide 87, "Old design": the boxed ticket as it stood before the
         shares / dollar switcher — same "Shares quantity" label, but its
         chevron is gone and the label no longer opens the picker. */
      quantityOnly: (_w, d) => {
        const walker = d.createTreeWalker(d.body, NodeFilter.SHOW_TEXT);
        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
          if (n.nodeValue?.trim() !== "Shares quantity") continue;
          const label = n.parentElement;
          if (!label) continue;
          label.querySelectorAll("svg").forEach((svg) => (svg.style.display = "none"));
          label.style.pointerEvents = "none";
          label.style.cursor = "default";
        }
      },
      notiveOriginal: (_w, d) => {
        const walker = d.createTreeWalker(d.body, NodeFilter.SHOW_TEXT);
        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
          if (n.nodeValue?.trim() === "Apple Inc") n.nodeValue = "Robinhood Markets Inc";
        }
      },
      notiveBeta: (_w, d) => {
        const row = d.querySelector<HTMLElement>(".nq-nav-right");
        if (!row || row.querySelector(".gd-frac-tag")) return;
        const tag = d.createElement("span");
        tag.className = "gd-frac-tag";
        tag.textContent = "Fractional";
        /* The banner's material and nothing else: #dce9f7 under #0066db,
           no rim, no shadow. Computed styles of chip and strip measure
           identical (rgb(220,233,247)); a white rim, then a grey drop
           shadow, each made the small chip read paler than the wide strip
           beside white icons, so both are gone. */
        tag.style.cssText =
          "display:inline-flex;align-items:center;height:32px;padding:0 8px;border-radius:999px;" +
          "background:#dce9f7;color:#0066db;font:400 12px/1 'Open Sans',Helvetica,Arial,sans-serif;flex:none;";
        row.insertBefore(tag, row.firstChild);
      },
      /* slide 95: the amount / quantity switcher, tapping itself — the
         arrowheads flip every two seconds. The frame's own timer, so it
         dies with the slide. */
      switchLoop: (w, d) => {
        const tick = () => {
          d.querySelector<HTMLElement>('[aria-label="Switch"]')?.click();
          w.setTimeout(tick, 2000);
        };
        w.setTimeout(tick, 1200);
      },
      /* fractional-order-flow's amount/quantity swap glyph, tapping itself */
      swapLoop: (w, d) => {
        const tick = () => {
          d.querySelector<HTMLElement>('[aria-label="Swap amount and quantity"]')?.click();
          w.setTimeout(tick, 2000);
        };
        w.setTimeout(tick, 1200);
      },
      /* the fractional order flow, opened on a Limit order (89–91, 96): the
         order-type pill's own menu, picked the way a tap would */
      limitOrder: (w, d) => {
        const pill = [...d.querySelectorAll<HTMLElement>("button")].find((b) => b.textContent?.trim() === "Market order");
        pill?.click();
        let tries = 0;
        const pick = () => {
          const item = [...d.querySelectorAll<HTMLElement>('[role="menuitemradio"]')].find((b) =>
            b.textContent?.includes("Limit order"),
          );
          if (item) item.click();
          else if (tries++ < 40) w.setTimeout(pick, 25);
        };
        pick();
      },
      /* slide 86's set-up, done while the slide is still a neighbour: a Limit
         order with its quantity field focused and empty, the pad open */
      fracHintSetup: (w, d) => {
        INIT.limitOrder(w, d);
        let tries = 0;
        const go = () => {
          const label = [...d.querySelectorAll<HTMLElement>("span")].find((e) => e.textContent === "Share quantity");
          const limitOn = [...d.querySelectorAll<HTMLElement>("span")].some((e) => e.textContent === "Limit price");
          if (!label || !limitOn) return tries++ < 80 && w.setTimeout(go, 25);
          label.parentElement!.click();
        };
        go();
      },
      /* ...and on arrival 1.5 is typed at a readable pace: the "." brings up
         the hint, the blue field and the pill ring together */
      fracHintType: (w) =>
        [["1", 0], [".", 380], ["5", 860]].forEach(([key, ms]) =>
          w.setTimeout(() => w.dispatchEvent(new w.KeyboardEvent("keydown", { key, bubbles: true })), ms),
        ),
      // the order-placed animation chimes when its check lands; a deck is
      // no place for a sound nobody asked for
      // stop the live price walk: the quote holds still on this slide
      freeze: (w) => {
        const hub = w.__pxHub;
        if (hub) w.clearInterval(hub.timer); // the frame's own clearInterval: timer ids are per window
      },
      /* the chain-to-order slide: opens on the option chain alone (the
         ticket arrives when a price is clicked), and the order confirmation
         and the "order placed" toast are brought over the widgets — they
         are placed for a full browser window, which here runs off the slide */
      chainFirst: (w, d) => {
        const cards = [...d.querySelectorAll<HTMLElement>(".ctt .wshell")].map((e) => e.getBoundingClientRect());
        if (!cards.length) return;
        const u = {
          l: Math.min(...cards.map((r) => r.left)),
          t: Math.min(...cards.map((r) => r.top)),
          r: Math.max(...cards.map((r) => r.right)),
          b: Math.max(...cards.map((r) => r.bottom)),
        };
        const st = d.createElement("style");
        st.textContent = `
          .ob-stage .ob-modal-wrap { inset: auto !important; left: ${u.l}px !important; top: ${u.t}px !important;
            width: ${u.r - u.l}px !important; height: ${u.b - u.t}px !important; padding: 0 !important; overflow: visible; }
          .ob-stage .ob-toast-wrap { left: ${u.l}px !important; right: auto !important; width: ${u.r - u.l}px !important;
            bottom: auto !important; top: ${u.b - 56}px !important; }
        `;
        d.head.appendChild(st);
        /* the order placed toast stays a second longer here: the ticket
           dismisses it after 2600ms; stretch that one timer to 3600 */
        const st0 = w.setTimeout.bind(w);
        w.setTimeout = ((fn: any, ms?: number, ...a: any[]) => st0(fn, ms === 2600 ? 3600 : ms, ...a)) as any;
        // the chain keeps its place; the ticket opens beside it
        // close the ticket: picking a price in the chain brings it back
        const close = d.querySelector<HTMLElement>(".ctt-ticket .wshell-actions .wshell-btn:not(.wshell-linkout)");
        close?.click();
      },
      /* slide 95: the fractional shares banner unfurling by itself — the
         piece's own `auto` cadence (open at 600ms, then every 2400ms), done
         by tapping it, so the gallery page stays interactive. */
      bannerLoop: (w, d) => {
        let on = false;
        const step = () => {
          on = !on;
          d.querySelector<HTMLElement>(`[aria-label="${on ? "Expand fractional shares banner" : "Collapse banner"}"]`)?.click();
          w.setTimeout(step, 2400);
        };
        w.setTimeout(step, 600);
      },
      mute: (w) => {
        w.AudioContext = undefined;
        w.webkitAudioContext = undefined;
      },
      /* slide 32: three copies of the stock ticket, each cut down to one
         stage of the build — the quote row; the quote + its fields; all of
         it. The card's top edge stays put if it changes height (hiding
         rows, or the full one's own "+ Bracket order"). */
      ticketQuote: (w, d) =>
        trimTicket(w, d, ".st-body > :not(.st-quote), .ob-card > :not(.st-body)"),
      ticketQty: (w, d) =>
        trimTicket(
          w,
          d,
          ".st-body > :not(.st-quote):not(:has(.ob-params)), .ob-card > :not(.st-body)",
        ),
      ticketFull: (w, d) => trimTicket(w, d, ""),
    };
    /* A [data-stack] column of live cards (slide 32) reflows like a list:
       each card sits a gap below the one above it, so one growing (a Limit
       price row opening) pushes the rest down instead of overlapping them.
       Measured every time a card's size changes, so it follows the spring. */
    function restack(slide: HTMLElement | null | undefined) {
      if (!slide) return;
      const cards = [...slide.querySelectorAll<HTMLElement>(".gd-live[data-stack]")].map((wrap) => {
        const f = wrap.querySelector("iframe");
        const card = f?.contentDocument?.querySelector<HTMLElement>(".wshell");
        return {
          wrap,
          top: (parseFloat(wrap.style.top) / 100) * H, // the card sits on its rect's top
          h: card ? card.getBoundingClientRect().height * parseFloat(f!.style.zoom || "1") : 0,
        };
      });
      if (cards.some((c) => !c.h)) return;
      // the gaps give way (24 → 8) before the last card runs off the slide
      const room = H - 16 - cards[0].top - cards.reduce((a, c) => a + c.h, 0);
      const gap = Math.max(8, Math.min(24, room / (cards.length - 1)));
      let bottom = cards[0].top + cards[0].h;
      cards.slice(1).forEach((c) => {
        const shift = Math.max(0, bottom + gap - c.top);
        c.wrap.style.marginTop = shift ? `${shift}px` : "";
        bottom = c.top + shift + c.h;
      });
    }
    function trimTicket(w: any, d: Document, hide: string) {
      const shell = d.querySelector<HTMLElement>(".wshell");
      const deckEl = d.querySelector<HTMLElement>(".ob-deck");
      if (!shell || !deckEl) return;
      const top0 = shell.getBoundingClientRect().top;
      if (hide) {
        const st = d.createElement("style");
        st.textContent = `${hide} { display: none !important; }`;
        d.head.appendChild(st);
      }
      let shift = 0;
      const pin = () => {
        const drift = shell.getBoundingClientRect().top - top0;
        if (Math.abs(drift) < 0.5) return;
        shift -= drift;
        deckEl.style.translate = `0 ${shift}px`;
      };
      new (w.ResizeObserver as typeof ResizeObserver)(() => {
        pin();
        restack((w.frameElement as HTMLElement | null)?.closest<HTMLElement>(".gd-slide"));
      }).observe(shell);
      pin();
      /* stacked copies: a menu opened in one would drop behind the copy
         below, so its frame comes to the front while a menu is open (the
         menu's own scrim takes the next outside click, which closes it) */
      const wrap = (w.frameElement as HTMLElement | null)?.parentElement;
      if (!wrap) return;
      const raise = () => {
        wrap.style.zIndex = d.querySelector(".ob-dd-scrim, [role=listbox], [role=dialog]") ? "5" : "";
      };
      new (w.MutationObserver as typeof MutationObserver)(raise).observe(d.body, { childList: true, subtree: true });
    }
    const runInit = (f: HTMLIFrameElement) => {
      if (f.dataset.inited) return;
      const name = f.dataset.init;
      try {
        // "a,b": several actions on one frame (slide 79 freezes the price walk beside its own set-up)
        if (name) for (const n of name.split(",")) INIT[n.trim()]?.(f.contentWindow, f.contentDocument!);
      } catch {
        /* same-origin always; a missing element just leaves the default state */
      }
      // set up (with or without an action) — an `arrive` alone (slide 76's banner) waits on this
      f.dataset.inited = "1";
    };
    /* data-arrive: an action that plays when you land on the slide (not when
       it preloads as a neighbour). Held until the frame's own set-up has had
       time to finish; leaving the slide reloads the frame so it plays again. */
    const runArrive = (f: HTMLIFrameElement) => {
      const name = f.dataset.arrive;
      if (!name || f.dataset.arrived || !f.dataset.inited) return;
      f.dataset.arrived = "1";
      const wait = Math.max(0, 900 - (performance.now() - parseFloat(f.dataset.initAt || "0")));
      window.setTimeout(() => {
        try {
          INIT[name]?.(f.contentWindow, f.contentDocument!);
        } catch {
          /* same-origin always */
        }
      }, wait + 300);
    };
    const reveal = (f: HTMLIFrameElement) =>
      place(f).then(() => {
        runInit(f);
        applyStep(f);
        f.dataset.initAt = String(performance.now());
        f.classList.add("is-in");
        if (f.closest(".gd-slide") === slides[i - 1]) runArrive(f);
      });
    const unmount = (f: HTMLIFrameElement) => {
      if (!f.getAttribute("src")) return;
      f.classList.remove("is-in");
      delete f.dataset.loaded;
      delete f.dataset.inited;
      delete f.dataset.stepped;
      f.removeAttribute("src");
    };
    let neighbours = new Set<number>();
    const syncLive = () => {
      slides.forEach((el, k) => {
        const near = k + 1 === i || neighbours.has(k + 1);
        el.querySelectorAll<HTMLIFrameElement>(".gd-live iframe").forEach((f) =>
          near ? mount(f) : unmount(f),
        );
      });
    };

    /* Leaving a slide resets any chain-to-order prototype that was used
       (ticket open, confirmation up), so it's fresh next time. */
    const resetUsed = (n: number) => {
      slides[n - 1]?.querySelectorAll<HTMLIFrameElement>(".gd-live iframe[data-arrive]").forEach((f) => {
        if (!f.dataset.arrived || !f.getAttribute("src")) return;
        delete f.dataset.arrived;
        unmount(f);
        mount(f);
      });
      slides[n - 1]?.querySelectorAll<HTMLIFrameElement>('.gd-live iframe[data-init="chainFirst"]').forEach((f) => {
        const d = f.contentDocument;
        const used = d && (d.querySelector(".ctt-ticket")?.childElementCount || d.querySelector(".ob-modal-wrap *, .ob-toast-item"));
        if (!used || !f.getAttribute("src")) return;
        unmount(f);
        mount(f);
      });
    };

    const show = (n: number) => {
      const next = nearest(Math.min(count, Math.max(1, n)));
      // ?edit can hold a slide change (unsaved edits) and resume it later
      const guard = (stage as any).__beforeShow as ((n: number) => boolean) | undefined;
      if (started && next !== i && guard && !guard(next)) return;
      const arrived = next !== i || !started;
      const from = i;
      i = next;
      notesUI.setSlide(i);
      if (from !== i) resetUsed(from);
      if (arrived) setBuild(i, stage.classList.contains("gd-edit") ? steps(i) : (nextBuild ?? 0));
      nextBuild = null;
      /* The slides either side stay laid out but invisible, so their
         prototypes load AND get measured before you arrive — no pop-in, no
         jump when a slide appears. Everything further away is display:none. */
      const o = order();
      const at = o.indexOf(i);
      neighbours = new Set([o[at - 1], o[at + 1]].filter(Boolean));
      slides.forEach((el) => {
        const n = parseInt(el.dataset.n || "0", 10);
        el.hidden = n !== i && !neighbours.has(n);
        el.classList.toggle("is-near", neighbours.has(n));
        /* `autoplay` alone doesn't reliably start a <video> that begins
           inside a `hidden` article — kick it explicitly once the slide
           it belongs to is actually shown, and pause it off-slide. */
        el.querySelectorAll<HTMLVideoElement>("video").forEach((v) => {
          if (n === i) requestAnimationFrame(() => v.play().catch(() => {}));
          else v.pause();
        });
      });
      warm(i);
      warm(i + 1);
      warm(i + 2);
      warm(i - 1);
      syncLive();
      if (arrived) slides[i - 1]?.querySelectorAll<HTMLIFrameElement>(".gd-live iframe[data-arrive]").forEach(runArrive);
      // backstop: anything that finished loading without being placed
      slides[i - 1]
        ?.querySelectorAll<HTMLIFrameElement>(".gd-live iframe")
        .forEach((f) => {
          if (f.dataset.loaded && !f.classList.contains("is-in")) {
            reveal(f);
          }
        });
      countEl.textContent = `${at + 1} / ${o.length}`;
      bar.style.transform = `scaleX(${(at + 1) / o.length})`;
      if (started) history.replaceState(null, "", `#slide-${i}`);
      if (arrived && started) enter(from, i);
    };

    /* Entrance transitions between two slides (data-enter on the arriving
       slide, only when coming forward from the slide it names):
         morph — elements matched by the same selector on both slides fly
                 from where they were to where they are (FLIP);
         split — items grow out of the source element's old position.
       The previous slide stays laid out (is-near), so its rects are real. */
    const enter = (fromN: number, toN: number) => {
      const to = slides[toN - 1];
      const spec = to?.dataset.enter ? JSON.parse(to.dataset.enter) : null;
      if (!spec || spec.from !== fromN) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || stage.classList.contains("gd-edit")) return;
      const src = slides[fromN - 1];
      const k = canvas.getBoundingClientRect().width / W;
      const scaleOf = (el: HTMLElement) => parseFloat(el.style.scale || "1") || 1;
      const flip = (el: HTMLElement, r0: DOMRect, opts: KeyframeAnimationOptions, extra: Keyframe = {}) => {
        const r1 = el.getBoundingClientRect();
        if (!r1.width || !r1.height) return;
        const s = scaleOf(el);
        const tx = (r0.left + r0.width / 2 - (r1.left + r1.width / 2)) / (k * s);
        const ty = (r0.top + r0.height / 2 - (r1.top + r1.height / 2)) / (k * s);
        el.animate(
          [
            { transform: `translate(${tx}px, ${ty}px) scale(${r0.width / r1.width}, ${r0.height / r1.height})`, ...extra },
            { transform: "none", opacity: 1 },
          ],
          { fill: "backwards", ...opts },
        );
      };
      requestAnimationFrame(() => {
        for (const sel of spec.morph || []) {
          const a = src.querySelector<HTMLElement>(sel);
          const b = to.querySelector<HTMLElement>(sel);
          if (a && b) flip(b, a.getBoundingClientRect(), { duration: 750, easing: "cubic-bezier(.65,0,.25,1)" });
        }
        if (spec.split) {
          const origin = src.querySelector<HTMLElement>(spec.split.from)?.getBoundingClientRect();
          if (!origin) return;
          const items = spec.split.items.flatMap((sel: string) => [...to.querySelectorAll<HTMLElement>(sel)]);
          items.forEach((el: HTMLElement, n: number) => {
            const r1 = el.getBoundingClientRect();
            // start centred on the old widget, at a size that fits inside it
            const f = Math.min(origin.width / r1.width, origin.height / r1.height) * 0.9;
            const r0 = new DOMRect(
              origin.left + origin.width / 2 - (r1.width * f) / 2,
              origin.top + origin.height / 2 - (r1.height * f) / 2,
              r1.width * f,
              r1.height * f,
            );
            flip(el, r0, { duration: 900, delay: 420 + n * 140, easing: "cubic-bezier(.2,.85,.25,1)" }, { opacity: 0 });
          });
        }
      });
    };

    const startShow = (n = 1) => {
      if (started) return;
      started = true;
      play.hidden = true;
      viewer.hidden = false;
      stage.setAttribute("tabindex", "0");
      fit();
      show(n);
      stage.focus({ preventScroll: true });
    };

    play.addEventListener("click", () => startShow());
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    fsBtn.addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else stage.requestFullscreen?.();
    });
    document.addEventListener("fullscreenchange", () => {
      stage.classList.toggle("is-fs", document.fullscreenElement === stage);
      fit();
    });
    window.addEventListener("resize", () => started && fit());
    stage.addEventListener("keydown", (e) => {
      if (!started || typing(e.target)) return;
      const k = e.key;
      if (k === "ArrowRight" || k === "PageDown" || k === " ") {
        e.preventDefault();
        step(1);
      } else if (k === "ArrowLeft" || k === "PageUp") {
        e.preventDefault();
        step(-1);
      } else if (k === "Home") {
        e.preventDefault();
        show(order()[0] ?? 1);
      } else if (k === "End") {
        e.preventDefault();
        show(order()[order().length - 1] ?? count);
      } else if (k === "f" || k === "F") {
        fsBtn.click();
      } else if (k === "n" || k === "N") {
        notesBtn.click();
      }
    });

    /* Deep links: #slide-24 opens the deck on that slide; ?solo makes the
       deck the whole window (a presenter view you can open in its own tab). */
    const params = new URLSearchParams(location.search);
    const edit = import.meta.env.DEV && params.has("edit");
    if (params.has("solo") || edit) stage.classList.add("is-solo");
    const m = /^#slide-(\d+)$/.exec(location.hash);
    if (m || params.has("solo") || edit) startShow(m ? parseInt(m[1], 10) : 1);
    // ?edit — local dev server only; the import is dropped from production builds
    (stage as any).__show = show;
    (stage as any).__step = step;
    if (edit) import("./deckEdit").then((mod) => mod.startEdit(stage, overrides));
  }
</script>

