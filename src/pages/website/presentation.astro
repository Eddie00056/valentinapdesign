---
import Website from "../../layouts/Website.astro";
import SiteHeader from "../../components/website/SiteHeader.astro";
import { Reveal } from "../../components/website/Reveal";
import GustoDeck from "../../components/website/deck/GustoDeck.astro";

const V = "/website/case/gusto";
const FILE_KEY = "8Mdlm1c4YU0ecxJ4B5p3vi";
const DECK = `https://www.figma.com/slides/${FILE_KEY}/Case-study-presentation--GUSTO-`;

const hobbies = [
  { src: `${V}/hobby-cake.jpg`, alt: "A hand-decorated Spider-Man layer cake" },
  { src: `${V}/hobby-calligraphy.jpg`, alt: "Pointed-pen calligraphy reading “Valentina”" },
  { src: `${V}/hobby-jitsu.jpg`, alt: "Rolling on the mats at a jiu-jitsu gym" },
  { src: `${V}/hobby-flowers.jpg`, alt: "A hand-tied floral arrangement" },
];

const chapters = [
  {
    num: "01",
    title: "Order entry modernization",
    blocks: [
      {
        label: "Background",
        body: "Questrade was seeing slower growth among active traders. The answer was a new, modernized trading platform — and its highest-impact workflow was order entry, the one feature clients told us not to touch because nobody complained about it.",
      },
      {
        label: "Problem",
        body: "Research with active traders across the full journey — idea generation, conviction building, execution, monitoring — showed order placement was slow, in particular for option traders. Options are 80% of Questrade’s revenue and the most complex experience in the industry, and the path from finding an option to trading it was broken.",
      },
      {
        label: "Goal",
        body: "Make trade submission fast, frictionless and the best in Canada. Success meant cutting time to trade by 15% and the number of clicks by 30%.",
      },
      {
        label: "Solution",
        body: "Tailor the order ticket to the security type. We audited what data the legacy widget showed and how — fields repeated or redundant — then rebuilt it: a lean stock ticket, an options ticket that takes its contract from the chain, and a workspace where a price becomes an order.",
      },
    ],
    meta: [
      ["My role", "Lead Designer, order entry widget"],
      ["Timeline", "6 months"],
      ["Team", "2 engineering teams · 1 UX researcher"],
    ],
    stats: [
      ["60%", "faster to place trades"],
      ["85%", "satisfaction score in the closed beta"],
    ],
  },
  {
    num: "02",
    title: "Fractional shares",
    blocks: [
      {
        label: "Goal",
        body: "Win more active traders and streamline the trading experience. Traders were asking for affordable, flexible ways to trade — research on the community forums was full of requests for fractional shares.",
      },
      {
        label: "The challenge",
        body: "One feature, two personas, two design languages. How might we make investing accessible to new investors without slowing down advanced traders? A north-star scope was mapped against a realistic MVP across symbol availability, order types, actions and order management.",
      },
      {
        label: "Design process",
        body: "Two goals drove the work: help traders find fractional symbols, and let them place a fractional trade seamlessly. Symbol discovery went from original design to beta to public release; the multi-page order wizard became a single screen, and the edge cases — fractional quantities only clear on market orders — guide traders out of limit-order and duration conflicts without dead ends.",
      },
    ],
    meta: [
      ["My role", "Product Designer"],
      ["Timeline", "4 months"],
      ["Team", "4 engineering teams · 1 UX researcher · 3 PMs"],
    ],
    stats: [
      ["60K", "increase in trading volume"],
      ["$33M", "total value traded"],
    ],
    award: "UX Design Awards — Fall 2025 nominee",
  },
  {
    num: "03",
    title: "Questrade Pro redesign",
    blocks: [
      {
        label: "Context",
        body: "As active-trader design lead I owned order placement across five platforms — bringing advanced charting, real-time streaming, symbol and account alerts, and real-time fractional share trading into one redesigned Pro experience.",
      },
      {
        label: "The edge",
        body: "No other Canadian broker offered real-time fractional trading. The redesign standardized a high-level input-field configuration that scaled from a stock order to a five-leg options strategy without a separate ticket for each.",
      },
      {
        label: "Approach",
        body: "Design for the happy path, then the edge cases, then symbol discoverability. Many order-entry variations were pressure-tested and simplified down — bracket orders, multi-leg options and alerts all folded into one consistent surface.",
      },
      {
        label: "Success criteria",
        body: "2× the active-trader cohort · 2× ARPU per active trader · 2× notional volume.",
      },
    ],
    meta: [],
    stats: [
      ["4.2M", "monthly orders placed"],
      ["$4.6B", "monthly notional value"],
    ],
  },
];
---

<Website
  title="Portfolio presentation"
  description="The portfolio presentation, rebuilt as a page — three active-trader case studies at Questrade, end to end."
>
  <SiteHeader />

  <main class="gp">
    <!-- ---------------------------------------------------------------- hero -->
    <header class="gp-hero w-wrap">
      <p class="gp-kicker">Portfolio presentation</p>
      <h1 class="gp-h1">
        Order entry, fractional shares,<br />and&nbsp;Questrade&nbsp;Pro
      </h1>
      <p class="gp-lede">
        The deck I walk through live, rebuilt as a page. Three active-trader case
        studies at Questrade: the problem, the process, and what shipped.
      </p>
      <a class="gp-link" href={DECK} target="_blank" rel="noopener">
        Open the deck in Figma&nbsp;↗
      </a>
    </header>

    <!-- ----------------------------------------------------------- deck player -->
    <GustoDeck />

    <!-- ------------------------------------------------------------- portrait -->
    <figure class="gp-portrait w-wrap">
      <img
        src={`${V}/portrait.jpg`}
        width="2000"
        height="1400"
        alt="Valentina Padure"
        loading="lazy"
      />
    </figure>

    <!-- ---------------------------------------------------------------- intro -->
    <section class="gp-section w-wrap">
      <div class="gp-row">
        <p class="gp-label">This is me</p>
        <div class="gp-col">
          <p class="gp-body">
            Product Designer with 5+ years shaping fintech products, most of it
            spent in the tools active traders live in. I care about fostering
            collaboration, pushing limits, and delivering high-impact work.
          </p>
          <p class="gp-body">
            I grew up in Moldova and I&rsquo;m based in New York. Away from the
            screen I decorate cakes, practice calligraphy, roll jiu-jitsu, and
            arrange flowers.
          </p>
        </div>
      </div>

      <div class="gp-row gp-row--wide">
        <p class="gp-label">This is what I like</p>
        <ul class="gp-hobbies">
          {
            hobbies.map((h) => (
              <li>
                <img src={h.src} width="1100" height="1100" alt={h.alt} loading="lazy" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ------------------------------------------------------------- overview -->
    <Reveal client:load>
      <section class="gp-section gp-section--rule w-wrap">
        <div class="gp-row">
          <p class="gp-label">Design ownership</p>
          <div class="gp-col">
            <p class="gp-body gp-body--lg">
              Order-placement design across five of Questrade&rsquo;s
              highest-revenue platforms, spanning the full trading journey — idea
              generation, conviction building, execution, and monitoring.
            </p>
          </div>
        </div>

        <dl class="gp-figures">
          <div><dt>10+</dt><dd>active-trader features shipped</dd></div>
          <div><dt>3+</dt><dd>zero-to-one products launched</dd></div>
          <div><dt>4</dt><dd>designers led across team initiatives</dd></div>
          <div><dt>2</dt><dd>industry design awards</dd></div>
        </dl>
      </section>
    </Reveal>

    <!-- ------------------------------------------------------------- chapters -->
    {
      chapters.map((c) => (
        <Reveal client:load>
          <section class="gp-chapter gp-section--rule w-wrap">
            <div class="gp-row gp-row--head">
              <p class="gp-chapter-num">{c.num}</p>
              <h2 class="gp-chapter-title">{c.title}</h2>
            </div>

            {c.blocks.map((b) => (
              <div class="gp-row">
                <p class="gp-label">{b.label}</p>
                <div class="gp-col">
                  <p class="gp-body">{b.body}</p>
                </div>
              </div>
            ))}

            {c.meta.length > 0 && (
              <div class="gp-row">
                <p class="gp-label">Details</p>
                <ul class="gp-meta">
                  {c.meta.map(([k, v]) => (
                    <li>
                      <span class="gp-meta-k">{k}</span>
                      <span class="gp-meta-v">{v}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="gp-row gp-row--wide">
              <p class="gp-label">Impact</p>
              <div class="gp-impact">
                {c.stats.map(([n, l]) => (
                  <div class="gp-impact-item">
                    <span class="gp-impact-n">{n}</span>
                    <span class="gp-impact-l">{l}</span>
                  </div>
                ))}
              </div>
            </div>

            {c.award && <p class="gp-award">{c.award}</p>}
          </section>
        </Reveal>
      ))
    }

    <!-- ---------------------------------------------------------------- close -->
    <Reveal client:load>
      <section class="gp-close gp-section--rule w-wrap">
        <p class="gp-close-line">That&rsquo;s the walkthrough.</p>
        <a class="gp-link" href={DECK} target="_blank" rel="noopener">
          Open the full deck in Figma&nbsp;↗
        </a>
      </section>
    </Reveal>
  </main>
</Website>

<style>
  /* Tiago-Costa register: one left-aligned column, big Elza display type,
     tiny mono labels in a left rail, hairline rules, lots of air.
     Rides on the --w-* tokens from Website.astro. */

  .gp {
    --rail: 12rem; /* width of the left label rail on wide screens */
    --measure: 40rem; /* body copy measure */
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  /* ---- hero ----------------------------------------------------- */
  .gp-hero {
    padding-top: clamp(3.5rem, 2rem + 7vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .gp-kicker,
  .gp-label {
    margin: 0;
    font-family: var(--w-font-alt);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-ink-soft);
  }

  .gp-h1 {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    max-width: 18ch;
    font-weight: 400;
    font-size: clamp(2.5rem, 1.3rem + 5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .gp-lede {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--w-ink-soft);
    text-wrap: pretty;
  }

  .gp-link {
    display: inline-block;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--w-font-alt);
    font-size: 1.0625rem;
    color: var(--w-accent);
    transition: opacity 0.18s ease;
  }

  .gp-link:hover {
    opacity: 0.68;
  }

  /* ---- portrait ----------------------------------------------- */
  .gp-portrait {
    margin: 0 auto;
  }

  .gp-portrait img {
    display: block;
    width: 100%;
    height: auto; /* rendered at its native ratio — never cropped */
    border-radius: 14px;
  }

  /* ---- section / row scaffold -------------------------------- */
  .gp-section,
  .gp-chapter,
  .gp-close {
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(0.75rem, 2vw, 1.25rem);
  }

  .gp-section--rule {
    margin-top: clamp(2.5rem, 5vw, 4.25rem);
    border-top: 1px solid var(--w-line);
  }

  /* a row = tiny label in a left rail + content column */
  .gp-row {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
  }

  .gp-row + .gp-row {
    border-top: 1px solid var(--w-line);
  }

  .gp-row .gp-label {
    padding-top: 0.35rem;
  }

  .gp-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--measure);
  }

  .gp-body {
    margin: 0;
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.125rem);
    line-height: 1.62;
    color: var(--w-ink-soft);
  }

  .gp-body--lg {
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--w-ink);
    max-width: 32ch;
    hyphens: none;
  }

  /* ---- hobby grid ------------------------------------------- */
  .gp-row--wide {
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .gp-hobbies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .gp-hobbies img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1; /* source files are already square — no further crop */
    object-fit: cover;
    border-radius: 10px;
  }

  /* ---- figures (career overview) --------------------------- */
  .gp-figures {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gp-figures div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gp-figures dt {
    font-weight: 600;
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--w-accent); /* fallback */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--w-accent) 70%, #ffffff) 0%,
      var(--w-accent) 55%,
      color-mix(in srgb, var(--w-accent) 82%, #000000) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .gp-figures dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--w-ink-soft);
  }

  /* ---- chapter -------------------------------------------- */
  .gp-row--head {
    align-items: baseline;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gp-chapter-num {
    margin: 0;
    padding-top: 0.5rem;
    font-family: var(--w-font-alt);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--w-accent);
    font-variant-numeric: tabular-nums;
  }

  .gp-chapter-title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(2rem, 1.3rem + 3.4vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* ---- chapter meta list --------------------------------- */
  .gp-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .gp-meta li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .gp-meta-k {
    color: var(--w-ink-faint);
  }

  .gp-meta-v {
    color: var(--w-ink-soft);
  }

  /* ---- impact numbers ----------------------------------- */
  .gp-impact {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 7vw, 5.5rem);
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .gp-impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .gp-impact-n {
    font-weight: 600;
    font-size: clamp(2.75rem, 1.8rem + 4.6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--w-accent); /* fallback */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--w-accent) 70%, #ffffff) 0%,
      var(--w-accent) 55%,
      color-mix(in srgb, var(--w-accent) 82%, #000000) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .gp-impact-l {
    max-width: 22ch;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--w-ink-soft);
  }

  .gp-award {
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    padding-left: calc(var(--rail) + clamp(1rem, 4vw, 3rem));
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    color: var(--w-ink-soft);
  }

  /* ---- close -------------------------------------------- */
  .gp-close {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 0;
  }

  .gp-close-line {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    letter-spacing: -0.03em;
  }

  /* ---- responsive -------------------------------------- */
  @media (max-width: 860px) {
    .gp {
      --rail: 100%;
    }

    .gp-row,
    .gp-row--head {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .gp-row .gp-label,
    .gp-chapter-num {
      padding-top: 0;
    }

    .gp-figures {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .gp-award {
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .gp-hobbies {
      grid-template-columns: repeat(2, 1fr);
    }

    .gp-meta li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

</style>
