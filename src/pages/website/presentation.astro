---
/* The presentation moved to the root. Old links (and their #slide-N deep
   links) land here and go straight on; the fragment survives, which a
   server redirect would not carry through a meta refresh. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Portfolio presentation</title>
    <link rel="canonical" href="https://valentinapdesign.com/" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      location.replace("/" + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/" /></noscript>
  </head>
  <body style="background:#000"></body>
</html>
