---
import Website from "../../layouts/Website.astro";
import SiteHeader from "../../components/website/SiteHeader.astro";
import { Reveal } from "../../components/website/Reveal";
import "../../components/website/case-study.css";

const V = "/website/case/gusto";
const DECK =
  "https://www.figma.com/slides/8Mdlm1c4YU0ecxJ4B5p3vi/Case-study-presentation--GUSTO-";
---

<Website
  title="Portfolio presentation"
  description="The portfolio presentation, rebuilt as a page — three active-trader case studies at Questrade, end to end."
>
  <SiteHeader />

  <main class="cs">
    <section class="cs-hero w-wrap">
      <p class="gp-kicker">Portfolio presentation</p>
      <h1 class="cs-title">
        Order entry, fractional shares, and Questrade Pro — end to end
      </h1>
      <p class="gp-lede">
        The deck I walk through live, rebuilt as a page. Three active-trader case
        studies at Questrade: the problem, the process, and what shipped.
      </p>
      <a class="gp-deck-link" href={DECK} target="_blank" rel="noopener">
        Open the deck in Figma ↗
      </a>
    </section>

    <div class="cs-media w-wrap">
      <img
        src={`${V}/intro.png`}
        alt="This is me, this is where I'm from, this is what I like — cake decorating, calligraphy, jiu-jitsu, floral design"
        loading="lazy"
      />
    </div>

    <section class="cs-overview w-wrap">
      <div class="cs-block">
        <p class="cs-label">This is me</p>
        <p class="cs-body">
          Product Designer with 5+ years shaping fintech products, most of it
          spent on the tools active traders live in. I care about fostering
          collaboration, pushing limits, and delivering high-impact work — and
          away from the screen I decorate cakes, practice calligraphy, roll
          jiu-jitsu, and arrange flowers.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Design ownership across Questrade's highest-revenue products</p>
        <p class="cs-body">
          Order-placement design across five platforms, spanning the full
          trading journey — idea generation, conviction building, execution, and
          monitoring.
        </p>
      </div>
    </section>

    <Reveal client:load>
      <section class="cs-impact w-wrap">
        <h2>Five years, in numbers</h2>
        <ul class="cs-stats gp-stats-4">
          <li><span class="n">10+</span><span class="l">active-trader features shipped</span></li>
          <li><span class="n">3+</span><span class="l">zero-to-one products launched</span></li>
          <li><span class="n">4</span><span class="l">product designers led across team initiatives</span></li>
          <li><span class="n">2</span><span class="l">industry design awards</span></li>
        </ul>
      </section>
    </Reveal>

    <!-- ============================ CHAPTER 01 ============================ -->
    <Reveal client:load>
      <section class="gp-chapter w-wrap">
        <p class="gp-chapter-num">Case study 01</p>
        <h2 class="gp-chapter-title">Order entry modernization</h2>
      </section>
    </Reveal>

    <section class="cs-overview w-wrap">
      <div class="cs-block">
        <p class="cs-label">Problem</p>
        <p class="cs-body">
          Questrade was experiencing slower growth among active traders. The
          desktop platform was a legacy build with no cohesive design system,
          and placing an order was slow enough to limit trade efficiency and
          trader confidence.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Solution</p>
        <p class="cs-body">
          Modernize the legacy desktop platform, starting with the highest-impact
          workflow: order entry. Research with active traders (150+ trades a
          quarter) reframed the work around the full trading journey rather than
          the widget alone.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Design principles</p>
        <p class="cs-body">
          1. Reduce time to trade. 2. Standardize order-type configurations
          across stocks, single-leg options, and multi-leg strategies.
          3. Innovate while respecting the past — traders told us plainly not to
          break the one feature nobody complains about.
        </p>
      </div>

      <div class="cs-meta">
        <div class="cs-block">
          <p class="cs-label">My role</p>
          <p class="cs-body">Lead Designer for the order entry widget</p>
        </div>
        <div class="cs-block">
          <p class="cs-label">Timeline</p>
          <p class="cs-body">6 months</p>
        </div>
        <div class="cs-block">
          <p class="cs-label">Team</p>
          <p class="cs-body">2 engineering teams, 1 UX researcher</p>
        </div>
      </div>
    </section>

    <div class="cs-media w-wrap">
      <img
        src={`${V}/orderentry-final.png`}
        alt="The redesigned order entry widget — Stock and Option modes, profit/loss brackets, and special instructions"
        loading="lazy"
      />
    </div>

    <Reveal client:load>
      <section class="cs-impact w-wrap">
        <h2>Impact</h2>
        <ul class="cs-stats gp-stats-2">
          <li><span class="n">60%</span><span class="l">faster to place trades</span></li>
          <li><span class="n">85%</span><span class="l">satisfaction score during the closed beta</span></li>
        </ul>
      </section>
    </Reveal>

    <!-- ============================ CHAPTER 02 ============================ -->
    <Reveal client:load>
      <section class="gp-chapter w-wrap">
        <p class="gp-chapter-num">Case study 02</p>
        <h2 class="gp-chapter-title">Fractional shares</h2>
      </section>
    </Reveal>

    <section class="cs-overview w-wrap">
      <div class="cs-block">
        <p class="cs-label">Goal</p>
        <p class="cs-body">
          On the back of $0 commission trades, win more active traders and
          streamline trading. Fractional shares were the most-requested feature
          on the community forum — and no other Canadian broker offered them.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">The framing</p>
        <p class="cs-body">
          One feature, two platforms, two personas. How might we make fractional
          investing accessible to new investors without disrupting the speed
          advanced traders depend on? A north-star scope was mapped against a
          realistic MVP across symbol availability, order types, and order
          management.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Design process</p>
        <p class="cs-body">
          Two questions drove the work: how do I find the right symbol, and how
          do I place a fractional trade? Beyond the happy path, the hard part was
          the edge cases — fractional quantities only clear on market orders, so
          the UI had to guide traders out of limit-order and duration conflicts
          without dead ends.
        </p>
      </div>

      <div class="cs-meta">
        <div class="cs-block">
          <p class="cs-label">My role</p>
          <p class="cs-body">Product Designer</p>
        </div>
        <div class="cs-block">
          <p class="cs-label">Timeline</p>
          <p class="cs-body">4 months</p>
        </div>
        <div class="cs-block">
          <p class="cs-label">Team</p>
          <p class="cs-body">
            4 engineering teams, 1 UX researcher, 3 product managers
          </p>
        </div>
      </div>
    </section>

    <div class="cs-media cs-media--cap w-wrap">
      <img
        src={`${V}/fractional-pizza.png`}
        alt="What is fractional trading? A fractional share shown as one slice of a whole pizza"
        loading="lazy"
      />
    </div>

    <Reveal client:load>
      <section class="cs-impact w-wrap">
        <h2>Impact</h2>
        <ul class="cs-stats gp-stats-2">
          <li><span class="n">60K</span><span class="l">increase in trading volume</span></li>
          <li><span class="n">$33M</span><span class="l">total value traded</span></li>
        </ul>
      </section>
    </Reveal>

    <Reveal client:load>
      <section class="cs-award w-wrap">
        <p class="headline">UX Design Awards</p>
        <p class="sub">Fall 2025 nominee</p>
      </section>
    </Reveal>

    <!-- ============================ CHAPTER 03 ============================ -->
    <Reveal client:load>
      <section class="gp-chapter w-wrap">
        <p class="gp-chapter-num">Case study 03</p>
        <h2 class="gp-chapter-title">Questrade Pro redesign</h2>
      </section>
    </Reveal>

    <section class="cs-overview w-wrap">
      <div class="cs-block">
        <p class="cs-label">Context</p>
        <p class="cs-body">
          As active-trader design lead, I owned order placement across five
          platforms — bringing advanced charting, real-time streaming, symbol and
          account alerts, and real-time fractional share trading into one
          redesigned Pro experience.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">The edge</p>
        <p class="cs-body">
          No other Canadian broker offered real-time fractional trading. The
          redesign standardized a high-level input-field configuration that
          scaled from a stock order to a five-leg options strategy without a
          separate ticket for each.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Approach</p>
        <p class="cs-body">
          Design for the happy path, then for the edge cases, then for symbol
          discoverability. Multiple order-entry variations were pressure-tested
          and simplified down — bracket orders, multi-leg options, and alerts all
          folded into one consistent surface.
        </p>
      </div>

      <div class="cs-block">
        <p class="cs-label">Success criteria</p>
        <p class="cs-body">
          2× the active-trader cohort · 2× ARPU per active trader · 2× notional
          volume.
        </p>
      </div>
    </section>

    <div class="cs-media w-wrap">
      <img
        src={`${V}/pro-redesign.png`}
        alt="Questrade Pro redesign — active-trader design lead, spanning advanced charting, real-time streaming, alerts, and real-time fractional share trading"
        loading="lazy"
      />
    </div>

    <div class="cs-media w-wrap">
      <img
        src={`${V}/pro-redesign-flow.png`}
        alt="One order-entry flow spanning desktop and mobile"
        loading="lazy"
      />
    </div>

    <Reveal client:load>
      <section class="cs-impact w-wrap">
        <h2>Impact</h2>
        <ul class="cs-stats gp-stats-2">
          <li><span class="n">4.2M</span><span class="l">monthly orders placed</span></li>
          <li><span class="n">$4.6B</span><span class="l">monthly notional value</span></li>
        </ul>
      </section>
    </Reveal>

    <Reveal client:load>
      <section class="gp-close w-wrap">
        <p class="gp-close-line">That's the walkthrough.</p>
        <a class="gp-deck-link" href={DECK} target="_blank" rel="noopener">
          Open the full deck in Figma ↗
        </a>
      </section>
    </Reveal>
  </main>

  <script>
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>
</Website>

<style>
  /* ---- hero extras ------------------------------------------------ */
  .gp-kicker {
    margin: 0 auto clamp(1rem, 2vw, 1.5rem);
    text-align: center;
    font-family: var(--w-font-alt);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-ink-soft);
  }

  .gp-lede {
    margin: clamp(1.25rem, 3vw, 2rem) auto 0;
    max-width: 52ch;
    text-align: center;
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.1875rem);
    line-height: 1.5;
    color: var(--w-ink-soft);
    text-wrap: pretty;
  }

  .gp-deck-link {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--w-font-alt);
    font-size: 1.0625rem;
    color: var(--w-accent);
    transition: opacity 0.18s ease;
  }

  .gp-deck-link:hover {
    opacity: 0.7;
  }

  .cs-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ---- chapter divider ----------------------------------------- */
  .gp-chapter {
    border-top: 1px solid var(--w-line);
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(0.5rem, 2vw, 1.5rem);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .gp-chapter-num {
    margin: 0 0 0.6rem;
    font-family: var(--w-font-alt);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--w-accent);
  }

  .gp-chapter-title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.875rem, 1.2rem + 3.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* the shared .cs-meta is a 2-item flex row; our chapters carry three
     (role / timeline / team), so lay them out as an even three-up grid
     rather than letting the third wrap under a tall row gap */
  .cs-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .cs-meta .cs-block + .cs-block {
    margin-top: 0;
  }

  /* keep the pizza metaphor from dominating as a full-bleed white block */
  .cs-media--cap img {
    width: auto;
    max-width: min(100%, 760px);
  }

  @media (max-width: 620px) {
    .cs-meta {
      grid-template-columns: 1fr;
    }
  }

  /* two-up impact rows read better centred than stretched across 3 cols */
  .cs-stats.gp-stats-2 {
    grid-template-columns: repeat(2, minmax(0, 16rem));
    justify-content: center;
  }

  /* the career-overview row carries four stats */
  .cs-stats.gp-stats-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .cs-stats.gp-stats-4 {
      grid-template-columns: repeat(2, minmax(0, 14rem));
      justify-content: center;
      gap: 2.5rem 3rem;
    }
  }

  /* ---- close ------------------------------------------------------ */
  .gp-close {
    border-top: 1px solid var(--w-line);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: clamp(3rem, 8vw, 6rem);
    text-align: center;
  }

  .gp-close-line {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  @media (max-width: 760px) {
    .cs-stats.gp-stats-2,
    .cs-stats.gp-stats-4 {
      grid-template-columns: 1fr;
    }
  }
</style>
