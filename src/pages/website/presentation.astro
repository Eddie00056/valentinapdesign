---
import Website from "../../layouts/Website.astro";
import SiteHeader from "../../components/website/SiteHeader.astro";
import { Reveal } from "../../components/website/Reveal";

const V = "/website/case/gusto";
const FILE_KEY = "8Mdlm1c4YU0ecxJ4B5p3vi";
const DECK = `https://www.figma.com/slides/${FILE_KEY}/Case-study-presentation--GUSTO-`;

// Self-hosted deck viewer — every slide exported to WebP, played back with
// its own prev/next, keyboard nav and fullscreen. No Figma dependency.
const DECK_BASE = `${V}/deck/`;
const DECK_COUNT = 102;

const hobbies = [
  { src: `${V}/hobby-cake.jpg`, alt: "A hand-decorated Spider-Man layer cake" },
  { src: `${V}/hobby-calligraphy.jpg`, alt: "Pointed-pen calligraphy reading “Valentina”" },
  { src: `${V}/hobby-jitsu.jpg`, alt: "Rolling on the mats at a jiu-jitsu gym" },
  { src: `${V}/hobby-flowers.jpg`, alt: "A hand-tied floral arrangement" },
];

const chapters = [
  {
    num: "01",
    title: "Order entry modernization",
    blocks: [
      {
        label: "Problem",
        body: "Questrade was seeing slower growth among active traders. The desktop platform was a legacy build with no cohesive design system, and placing an order was slow enough to limit trade efficiency and trader confidence.",
      },
      {
        label: "Solution",
        body: "Modernize the legacy desktop platform, starting with its highest-impact workflow: order entry. Research with active traders — 150+ trades a quarter — reframed the work around the full trading journey rather than the widget alone.",
      },
      {
        label: "Principles",
        body: "Reduce time to trade. Standardize order-type configurations across stocks, single-leg options and multi-leg strategies. Innovate while respecting the past — traders told us plainly not to break the one feature nobody complains about.",
      },
    ],
    meta: [
      ["My role", "Lead Designer, order entry widget"],
      ["Timeline", "6 months"],
      ["Team", "2 engineering teams · 1 UX researcher"],
    ],
    stats: [
      ["60%", "faster to place trades"],
      ["85%", "satisfaction score in the closed beta"],
    ],
  },
  {
    num: "02",
    title: "Fractional shares",
    blocks: [
      {
        label: "Goal",
        body: "On the back of $0 commission trades, win more active traders and streamline trading. Fractional shares were the most-requested feature on the community forum — and no other Canadian broker offered them.",
      },
      {
        label: "The framing",
        body: "One feature, two platforms, two personas. How might we make fractional investing accessible to new investors without disrupting the speed advanced traders depend on? A north-star scope was mapped against a realistic MVP across symbol availability, order types and order management.",
      },
      {
        label: "Design process",
        body: "Two questions drove the work: how do I find the right symbol, and how do I place a fractional trade? Beyond the happy path, the hard part was the edge cases — fractional quantities only clear on market orders, so the UI had to guide traders out of limit-order and duration conflicts without dead ends.",
      },
    ],
    meta: [
      ["My role", "Product Designer"],
      ["Timeline", "4 months"],
      ["Team", "4 engineering teams · 1 UX researcher · 3 PMs"],
    ],
    stats: [
      ["60K", "increase in trading volume"],
      ["$33M", "total value traded"],
    ],
    award: "UX Design Awards — Fall 2025 nominee",
  },
  {
    num: "03",
    title: "Questrade Pro redesign",
    blocks: [
      {
        label: "Context",
        body: "As active-trader design lead I owned order placement across five platforms — bringing advanced charting, real-time streaming, symbol and account alerts, and real-time fractional share trading into one redesigned Pro experience.",
      },
      {
        label: "The edge",
        body: "No other Canadian broker offered real-time fractional trading. The redesign standardized a high-level input-field configuration that scaled from a stock order to a five-leg options strategy without a separate ticket for each.",
      },
      {
        label: "Approach",
        body: "Design for the happy path, then the edge cases, then symbol discoverability. Many order-entry variations were pressure-tested and simplified down — bracket orders, multi-leg options and alerts all folded into one consistent surface.",
      },
      {
        label: "Success criteria",
        body: "2× the active-trader cohort · 2× ARPU per active trader · 2× notional volume.",
      },
    ],
    meta: [],
    stats: [
      ["4.2M", "monthly orders placed"],
      ["$4.6B", "monthly notional value"],
    ],
  },
];
---

<Website
  title="Portfolio presentation"
  description="The portfolio presentation, rebuilt as a page — three active-trader case studies at Questrade, end to end."
>
  <SiteHeader />

  <main class="gp">
    <!-- ---------------------------------------------------------------- hero -->
    <header class="gp-hero w-wrap">
      <p class="gp-kicker">Portfolio presentation</p>
      <h1 class="gp-h1">
        Order entry, fractional shares,<br />and&nbsp;Questrade&nbsp;Pro
      </h1>
      <p class="gp-lede">
        The deck I walk through live, rebuilt as a page. Three active-trader case
        studies at Questrade: the problem, the process, and what shipped.
      </p>
      <a class="gp-link" href={DECK} target="_blank" rel="noopener">
        Open the deck in Figma&nbsp;↗
      </a>
    </header>

    <!-- ----------------------------------------------------------- deck player -->
    <section class="gp-deck w-wrap">
      <div
        class="gp-deck-stage"
        data-base={DECK_BASE}
        data-count={DECK_COUNT}
      >
        <button type="button" class="gp-deck-play">
          <span class="gp-deck-play-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
          <span class="gp-deck-play-text">
            <span class="gp-deck-play-label">Play the presentation</span>
            <span class="gp-deck-play-sub">{DECK_COUNT} slides · ← → to move · ⤢ for fullscreen</span>
          </span>
        </button>

        <div class="gp-deck-viewer" hidden>
          <img class="gp-deck-img" alt="" draggable="false" />
          <button class="gp-deck-edge gp-deck-edge--prev" type="button" aria-label="Previous slide">
            <span aria-hidden="true">‹</span>
          </button>
          <button class="gp-deck-edge gp-deck-edge--next" type="button" aria-label="Next slide">
            <span aria-hidden="true">›</span>
          </button>
          <div class="gp-deck-bar">
            <span class="gp-deck-count" aria-live="polite">1 / {DECK_COUNT}</span>
            <button class="gp-deck-fs" type="button" aria-label="Toggle fullscreen">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 3H4v4M16 3h4v4M8 21H4v-4M16 21h4v-4"></path>
              </svg>
            </button>
          </div>
          <div class="gp-deck-progress"><span></span></div>
        </div>
      </div>
      <p class="gp-deck-note">
        <kbd>←</kbd> <kbd>→</kbd> or click the edges to move ·
        <a href={DECK} target="_blank" rel="noopener">open in Figma&nbsp;↗</a>
      </p>
    </section>

    <!-- ------------------------------------------------------------- portrait -->
    <figure class="gp-portrait w-wrap">
      <img
        src={`${V}/portrait.jpg`}
        width="2000"
        height="1400"
        alt="Valentina Padure"
        loading="lazy"
      />
    </figure>

    <!-- ---------------------------------------------------------------- intro -->
    <section class="gp-section w-wrap">
      <div class="gp-row">
        <p class="gp-label">This is me</p>
        <div class="gp-col">
          <p class="gp-body">
            Product Designer with 5+ years shaping fintech products, most of it
            spent in the tools active traders live in. I care about fostering
            collaboration, pushing limits, and delivering high-impact work.
          </p>
          <p class="gp-body">
            I grew up in Moldova and I&rsquo;m based in New York. Away from the
            screen I decorate cakes, practice calligraphy, roll jiu-jitsu, and
            arrange flowers.
          </p>
        </div>
      </div>

      <div class="gp-row gp-row--wide">
        <p class="gp-label">This is what I like</p>
        <ul class="gp-hobbies">
          {
            hobbies.map((h) => (
              <li>
                <img src={h.src} width="1100" height="1100" alt={h.alt} loading="lazy" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ------------------------------------------------------------- overview -->
    <Reveal client:load>
      <section class="gp-section gp-section--rule w-wrap">
        <div class="gp-row">
          <p class="gp-label">Design ownership</p>
          <div class="gp-col">
            <p class="gp-body gp-body--lg">
              Order-placement design across five of Questrade&rsquo;s
              highest-revenue platforms, spanning the full trading journey — idea
              generation, conviction building, execution, and monitoring.
            </p>
          </div>
        </div>

        <dl class="gp-figures">
          <div><dt>10+</dt><dd>active-trader features shipped</dd></div>
          <div><dt>3+</dt><dd>zero-to-one products launched</dd></div>
          <div><dt>4</dt><dd>designers led across team initiatives</dd></div>
          <div><dt>2</dt><dd>industry design awards</dd></div>
        </dl>
      </section>
    </Reveal>

    <!-- ------------------------------------------------------------- chapters -->
    {
      chapters.map((c) => (
        <Reveal client:load>
          <section class="gp-chapter gp-section--rule w-wrap">
            <div class="gp-row gp-row--head">
              <p class="gp-chapter-num">{c.num}</p>
              <h2 class="gp-chapter-title">{c.title}</h2>
            </div>

            {c.blocks.map((b) => (
              <div class="gp-row">
                <p class="gp-label">{b.label}</p>
                <div class="gp-col">
                  <p class="gp-body">{b.body}</p>
                </div>
              </div>
            ))}

            {c.meta.length > 0 && (
              <div class="gp-row">
                <p class="gp-label">Details</p>
                <ul class="gp-meta">
                  {c.meta.map(([k, v]) => (
                    <li>
                      <span class="gp-meta-k">{k}</span>
                      <span class="gp-meta-v">{v}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="gp-row gp-row--wide">
              <p class="gp-label">Impact</p>
              <div class="gp-impact">
                {c.stats.map(([n, l]) => (
                  <div class="gp-impact-item">
                    <span class="gp-impact-n">{n}</span>
                    <span class="gp-impact-l">{l}</span>
                  </div>
                ))}
              </div>
            </div>

            {c.award && <p class="gp-award">{c.award}</p>}
          </section>
        </Reveal>
      ))
    }

    <!-- ---------------------------------------------------------------- close -->
    <Reveal client:load>
      <section class="gp-close gp-section--rule w-wrap">
        <p class="gp-close-line">That&rsquo;s the walkthrough.</p>
        <a class="gp-link" href={DECK} target="_blank" rel="noopener">
          Open the full deck in Figma&nbsp;↗
        </a>
      </section>
    </Reveal>
  </main>

  <script>
    // Self-hosted slide viewer: one <img> swapped between exported WebP
    // slides, with prev/next, keyboard nav, edge-click and fullscreen.
    const stage = document.querySelector<HTMLElement>(".gp-deck-stage");
    if (stage) {
      const base = stage.dataset.base!;
      const count = parseInt(stage.dataset.count || "0", 10);
      const play = stage.querySelector<HTMLButtonElement>(".gp-deck-play")!;
      const viewer = stage.querySelector<HTMLElement>(".gp-deck-viewer")!;
      const img = stage.querySelector<HTMLImageElement>(".gp-deck-img")!;
      const countEl = stage.querySelector<HTMLElement>(".gp-deck-count")!;
      const bar = stage.querySelector<HTMLElement>(".gp-deck-progress span")!;
      const fsBtn = stage.querySelector<HTMLButtonElement>(".gp-deck-fs")!;
      const prevBtn = stage.querySelector<HTMLButtonElement>(".gp-deck-edge--prev")!;
      const nextBtn = stage.querySelector<HTMLButtonElement>(".gp-deck-edge--next")!;

      const src = (n: number) =>
        `${base}${String(n).padStart(3, "0")}.webp`;
      let i = 1;
      let started = false;

      const preload = (n: number) => {
        if (n < 1 || n > count) return;
        const p = new Image();
        p.src = src(n);
      };

      const show = (n: number) => {
        i = Math.min(count, Math.max(1, n));
        img.src = src(i);
        img.alt = `Slide ${i} of ${count}`;
        countEl.textContent = `${i} / ${count}`;
        bar.style.transform = `scaleX(${i / count})`;
        preload(i + 1);
        preload(i + 2);
        preload(i - 1);
      };

      const start = () => {
        if (started) return;
        started = true;
        play.hidden = true;
        viewer.hidden = false;
        stage.setAttribute("tabindex", "0");
        stage.focus();
        show(1);
      };

      play.addEventListener("click", start);
      prevBtn.addEventListener("click", () => show(i - 1));
      nextBtn.addEventListener("click", () => show(i + 1));

      fsBtn.addEventListener("click", () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else stage.requestFullscreen?.();
      });
      document.addEventListener("fullscreenchange", () => {
        stage.classList.toggle("is-fs", document.fullscreenElement === stage);
      });

      stage.addEventListener("keydown", (e) => {
        if (!started) return;
        const k = e.key;
        if (k === "ArrowRight" || k === "PageDown" || k === " ") {
          e.preventDefault();
          show(i + 1);
        } else if (k === "ArrowLeft" || k === "PageUp") {
          e.preventDefault();
          show(i - 1);
        } else if (k === "Home") {
          e.preventDefault();
          show(1);
        } else if (k === "End") {
          e.preventDefault();
          show(count);
        } else if (k === "f" || k === "F") {
          fsBtn.click();
        }
      });
    }
  </script>
</Website>

<style>
  /* Tiago-Costa register: one left-aligned column, big Elza display type,
     tiny mono labels in a left rail, hairline rules, lots of air.
     Rides on the --w-* tokens from Website.astro. */

  .gp {
    --rail: 12rem; /* width of the left label rail on wide screens */
    --measure: 40rem; /* body copy measure */
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  /* ---- hero ----------------------------------------------------- */
  .gp-hero {
    padding-top: clamp(3.5rem, 2rem + 7vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .gp-kicker,
  .gp-label {
    margin: 0;
    font-family: var(--w-font-alt);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-ink-soft);
  }

  .gp-h1 {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    max-width: 18ch;
    font-weight: 400;
    font-size: clamp(2.5rem, 1.3rem + 5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .gp-lede {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--w-ink-soft);
    text-wrap: pretty;
  }

  .gp-link {
    display: inline-block;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--w-font-alt);
    font-size: 1.0625rem;
    color: var(--w-accent);
    transition: opacity 0.18s ease;
  }

  .gp-link:hover {
    opacity: 0.68;
  }

  /* ---- deck player ------------------------------------------- */
  .gp-deck {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gp-deck-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--w-line);
    border-radius: 14px;
    overflow: hidden;
    background:
      radial-gradient(
        120% 90% at 50% 0%,
        color-mix(in srgb, var(--w-accent) 9%, #0a0a0a) 0%,
        #070707 62%
      );
  }

  /* fullscreen: let the stage fill the screen, image stays contained */
  .gp-deck-stage:fullscreen {
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    background: #000;
    display: flex;
  }

  /* ---- viewer ---------------------------------------------------- */
  .gp-deck-viewer {
    position: absolute;
    inset: 0;
  }

  .gp-deck-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* invisible left / right hit zones with a chevron that shows on hover */
  .gp-deck-edge {
    position: absolute;
    top: 0;
    bottom: 2.75rem;
    width: 33%;
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    border: 0;
    background: none;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .gp-deck-edge--prev {
    left: 0;
    justify-content: flex-start;
  }

  .gp-deck-edge--next {
    right: 0;
    justify-content: flex-end;
  }

  .gp-deck-stage:hover .gp-deck-edge,
  .gp-deck-stage:focus-within .gp-deck-edge {
    opacity: 0.35;
  }

  .gp-deck-edge:hover {
    opacity: 0.9 !important;
  }

  .gp-deck-edge span {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }

  /* bottom control bar */
  .gp-deck-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.9rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
  }

  .gp-deck-count {
    font-family: var(--w-font-alt);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.8);
    font-variant-numeric: tabular-nums;
  }

  .gp-deck-fs {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .gp-deck-fs:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .gp-deck-progress {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
  }

  .gp-deck-progress span {
    display: block;
    height: 100%;
    background: var(--w-accent);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  /* click-to-load facade */
  .gp-deck-play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    background: none;
    border: 0;
    color: var(--w-ink);
    font: inherit;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .gp-deck-play:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .gp-deck-play-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--w-accent);
    color: #04160e;
    transition: transform 0.2s ease;
  }

  .gp-deck-play:hover .gp-deck-play-icon {
    transform: scale(1.06);
  }

  .gp-deck-play-icon svg {
    margin-left: 2px;
  }

  .gp-deck-play-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-align: left;
  }

  .gp-deck-play-label {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .gp-deck-play-sub {
    font-family: var(--w-font-alt);
    font-size: 0.8125rem;
    color: var(--w-ink-soft);
  }

  .gp-deck-note {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--w-ink-soft);
  }

  .gp-deck-note a {
    color: var(--w-accent);
  }

  .gp-deck-note kbd {
    font: inherit;
    padding: 0.05em 0.4em;
    border: 1px solid var(--w-line);
    border-radius: 5px;
    color: var(--w-ink);
  }

  @media (max-width: 560px) {
    .gp-deck-play {
      flex-direction: column;
      gap: 0.9rem;
    }

    .gp-deck-play-text {
      text-align: center;
      align-items: center;
    }
  }

  /* ---- portrait ----------------------------------------------- */
  .gp-portrait {
    margin: 0 auto;
  }

  .gp-portrait img {
    display: block;
    width: 100%;
    height: auto; /* rendered at its native ratio — never cropped */
    border-radius: 14px;
  }

  /* ---- section / row scaffold -------------------------------- */
  .gp-section,
  .gp-chapter,
  .gp-close {
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(0.75rem, 2vw, 1.25rem);
  }

  .gp-section--rule {
    margin-top: clamp(2.5rem, 5vw, 4.25rem);
    border-top: 1px solid var(--w-line);
  }

  /* a row = tiny label in a left rail + content column */
  .gp-row {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
  }

  .gp-row + .gp-row {
    border-top: 1px solid var(--w-line);
  }

  .gp-row .gp-label {
    padding-top: 0.35rem;
  }

  .gp-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--measure);
  }

  .gp-body {
    margin: 0;
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.125rem);
    line-height: 1.62;
    color: var(--w-ink-soft);
  }

  .gp-body--lg {
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--w-ink);
    max-width: 32ch;
    hyphens: none;
  }

  /* ---- hobby grid ------------------------------------------- */
  .gp-row--wide {
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .gp-hobbies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .gp-hobbies img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1; /* source files are already square — no further crop */
    object-fit: cover;
    border-radius: 10px;
  }

  /* ---- figures (career overview) --------------------------- */
  .gp-figures {
