---
import Website from "../../layouts/Website.astro";
import SiteHeader from "../../components/website/SiteHeader.astro";
import ContactFooter from "../../components/website/ContactFooter.astro";
import { LiveFit } from "../../components/website/LiveFit";
import { ChainLoop } from "../../components/website/ChainLoop";
import "../../components/website/case-study.css";

const V = "/website/case/questrade";

/* deck slide 17: the options builder adding legs on its own loop, dressed
   as on the slide */
const BUILDER_CSS =
  ".ob-stage{background:none!important}.ob-cost{display:none!important}.ob-foot{justify-content:flex-end!important}html.is-bare .wshell.wshell{background:#010101!important}";
---

<Website
  title="Redesigning order placement"
  description="Questrade Pro — redesigning order placement to cut time to trade by 60%."
>
  <SiteHeader />

  <main class="cs">
    <section class="cs-hero w-wrap" data-reveal>
      <h1 class="cs-title">
        Redesigning order placement to reduce trade time by 60%
      </h1>
    </section>

    <div class="cs-media cs-media--hero w-wrap" data-reveal>
      <!-- deck slide 51: the chain to its ticket, playing itself on a loop -->
      <div class="cs-loop">
        <ChainLoop client:visible ground="#030205" />
      </div>
    </div>

    <section class="cs-overview w-wrap" data-reveal>
      <div class="cs-block" data-r>
        <p class="cs-label">Project overview</p>
        <p class="cs-body">
          Questrade began modernizing its aging desktop trading experience, which
          lacked a cohesive design system and relied on outdated architecture.
          The goal was to create a faster, more modern experience and reduce time
          to place a trade.
        </p>
      </div>

      <div class="cs-block" data-r>
        <p class="cs-label">What I led</p>
        <p class="cs-body">
          Owned the platform’s highest-impact workflow, order placement, driving
          the experience from discovery through delivery. Partnered with the
          design systems team to establish a consistent, scalable design language
          and supported engineering through handoff and implementation.
        </p>
      </div>

      <div class="cs-meta">
        <div class="cs-block" data-r>
          <p class="cs-label">My role</p>
          <p class="cs-body">
            1 Product Manager, 1 UX Researcher, 1 Content Designer, 4 Engineering
            squads
          </p>
        </div>
        <div class="cs-block" data-r>
          <p class="cs-label">Timeline</p>
          <p class="cs-body">5 months</p>
        </div>
      </div>
    </section>

    <section class="cs-impact w-wrap" data-reveal>
      <h2 data-r>Project impact</h2>
      <ul class="cs-stats">
        <li data-r><span class="n">65%</span><span class="l">decrease in time to submit a trade</span></li>
        <li data-r><span class="n">3X</span><span class="l">fewer errors when placing an equity trade</span></li>
        <li data-r><span class="n">60K</span><span class="l">options contracts traded</span></li>
      </ul>
    </section>

    <section class="cs-ba w-wrap" data-reveal>
      <figure class="is-before">
        <figcaption>Before</figcaption>
        <img src={`${V}/fig-a.png`} alt="The previous order-entry widget" loading="lazy" />
      </figure>
      <figure class="is-after">
        <figcaption>After</figcaption>
        <div class="ba-live">
          <LiveFit
            client:visible
            src="/work/options-strategy-builder?bare&auto"
            fit=".wshell"
            css={BUILDER_CSS}
            vw={1280}
            vh={960}
            freeze
            title="Options strategy builder"
          />
        </div>
      </figure>
    </section>

    <section class="cs-ba cs-ba--wide w-wrap" data-reveal>
      <figure class="is-before">
        <img src={`${V}/before.png`} alt="The previous desktop platform" loading="lazy" />
      </figure>
      <figure class="is-after">
        <img src={`${V}/after.png`} alt="The redesigned desktop platform" loading="lazy" />
      </figure>
    </section>

    <ContactFooter />
  </main>

  <script>
    import { initReveal } from "../../components/website/reveal";
    initReveal();

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>
</Website>
