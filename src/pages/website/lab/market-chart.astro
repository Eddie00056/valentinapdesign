---
import Website from "../../../layouts/Website.astro";
import SiteHeader from "../../../components/website/SiteHeader.astro";
import { MarketChart } from "../../../components/website/lab/MarketChart";
import { EdgeChart } from "../../../components/website/EdgeChart";
---

<Website title="Lab — Market chart">
  <SiteHeader />
  <main class="lab">
    <p class="tag">Prototype · not linked from the site</p>
    <h1>Market chart</h1>
    <p class="note">
      The EdgeMobile bento's chart card, live — what replaced the baked
      Framer clip (2026-09-14): the clip's own picture, the ranges stepping
      on their own, every change a morph, the pill on a spring.
    </p>

    <div class="card">
      <EdgeChart client:load />
    </div>

    <p class="note">
      The earlier candidate — real gradient fill, a spring morph on the
      timeframe, trend flips crossfading green↔red.
    </p>

    <div class="stage">
      <MarketChart client:load />
    </div>
  </main>
</Website>

<style>
  .lab {
    max-width: 620px;
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 6rem) var(--w-gutter) 6rem;
  }
  .tag {
    margin: 0 0 0.75rem;
    font-family: var(--w-font-alt);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--w-accent);
  }
  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    letter-spacing: -0.02em;
  }
  .note {
    margin: 1rem 0 2.5rem;
    color: var(--w-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .stage {
    max-width: 440px;
  }
  /* the homepage bento card, at its size there */
  .card {
    position: relative;
    max-width: 440px;
    aspect-ratio: 8 / 5;
    margin-bottom: 3rem;
    border-radius: 20px;
    background: #0c0c0c;
    overflow: hidden;
    --ec-w: 92%;
    --ec-h: 92%;
  }
</style>
