---
import Website from "../../layouts/Website.astro";
import { caseStudies } from "../../data/site";

export function getStaticPaths() {
  // Slugs with their own bespoke page take precedence; the rest fall back
  // to this stub until they're built.
  const bespoke = new Set(["questrade-pro"]);
  return caseStudies
    .filter((c) => !bespoke.has(c.slug))
    .map((c) => ({
      params: { slug: c.slug },
      props: { study: c },
    }));
}

const { study } = Astro.props;
---

<Website title={study.title} description={study.summary}>
  <main class="cs w-wrap">
    <a class="back" href="/website">← Valentina P.</a>

    <p class="kicker">Case study</p>
    <h1>{study.title}</h1>
    <p class="summary">{study.summary}</p>
    <p class="impact">{study.impact}</p>

    <p class="soon">Full write-up in progress.</p>
  </main>
</Website>

<style>
  .cs {
    min-height: 100dvh;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: 6rem;
    max-width: 720px;
  }

  .back {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--w-ink-mute);
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--w-ink);
  }

  .kicker {
    margin: clamp(3rem, 8vw, 5rem) 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--w-accent);
  }

  h1 {
    margin: 0;
    font-family: var(--w-font);
    font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 4vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .summary {
    margin: 1.25rem 0 0;
    max-width: 32ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--w-ink-soft);
  }

  .impact {
    margin: 1.5rem 0 0;
    font-family: var(--w-font);
    font-weight: 500;
    color: var(--w-ink);
  }

  .soon {
    margin: clamp(3rem, 10vw, 6rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--w-line);
    font-size: 0.875rem;
    color: var(--w-ink-faint);
  }
</style>
