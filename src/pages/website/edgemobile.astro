---
import Website from "../../layouts/Website.astro";
import { EdgeChart } from "../../components/website/EdgeChart";
import SiteHeader from "../../components/website/SiteHeader.astro";
import { HoldingsLoop } from "../../components/website/HoldingsLoop";
import "../../components/website/case-study.css";

const V = "/website/case/edge";
const P = "/website/video"; // shared prototype clips from the homepage
---

<Website
  title="EdgeMobile"
  description="EdgeMobile — designing Questrade's top income-generating mobile app for active traders."
>
  <SiteHeader />

  <main class="cs">
    <section class="cs-hero w-wrap" data-reveal>
      <h1 class="cs-title">Designing Questrade’s top income-generating app</h1>
    </section>

    <div class="cs-media cs-media--hero w-wrap" data-reveal>
      <video src={`${V}/hero.mp4`} autoplay loop muted playsinline preload="metadata"></video>
    </div>

    <section class="cs-overview w-wrap" data-reveal>
      <div class="cs-block" data-r>
        <p class="cs-label">Project overview</p>
        <p class="cs-body">
          Questrade faced an outdated mobile experience and decided to split it
          into two fully native apps, one for novice investors and one for active
          traders.
        </p>
      </div>

      <div class="cs-block" data-r>
        <p class="cs-label">What I led</p>
        <p class="cs-body">
          Shipped core features including alerts, bracket orders, options
          strategies, and charting, while introducing zero-to-one experiences
          like streaming data and onboarding. Partnered with research on a
          three-month VIP pre-release study to identify launch risks,
          collaborated with product and engineering on launch and migration
          plans, and led an app-wide audit resolving 60+ design inconsistencies.
        </p>
      </div>

      <div class="cs-meta">
        <div class="cs-block" data-r>
          <p class="cs-label">My role</p>
          <p class="cs-body">
            1 Product Manager, 1 UX Researcher, 1 Content Designer, 4 Engineering
            squads
          </p>
        </div>
        <div class="cs-block" data-r>
          <p class="cs-label">Timeline</p>
          <p class="cs-body">1.5 years</p>
        </div>
      </div>
    </section>

    <section class="cs-impact w-wrap" data-reveal>
      <h2 data-r>Project impact</h2>
      <ul class="cs-stats">
        <li data-r><span class="n">$45M</span><span class="l">incremental trading volume</span></li>
        <li data-r><span class="n">+10K</span><span class="l">incremental increase in active traders</span></li>
        <li data-r><span class="n">4.5</span><span class="l">stars on App Store and Google Play</span></li>
      </ul>
    </section>

    <section class="cs-bento cs-bento--cols w-wrap" data-reveal>
      <div class="col">
        <div class="dark fit-wide"><video src={`${P}/edge-order.mp4`} autoplay loop muted playsinline></video></div>
        <div class="dark fit-price"><div class="hood-crop"><video src={`${P}/edge-hood.mp4`} autoplay loop muted playsinline></video></div></div>
        <!-- the homepage card's holdings magnifier, on its loop -->
        <div class="dark fit-panel"><HoldingsLoop client:visible fill={1} /></div>
      </div>
      <div class="col">
        <div class="dark fit-bell"><video src={`${P}/edge-bell.mp4`} autoplay loop muted playsinline></video></div>
        <!-- deck slide 79's original quote page -->
        <div class="dark fit-square"><img src={`${V}/quote-original.webp`} alt="The original EdgeMobile quote page" loading="lazy" /></div>
      </div>
      <!-- the closing pair, one size: the order going through on the left,
           the live chart on the right -->
      <div class="bento-row bento-pair">
        <!-- the placing clip's screen, re-framed in the quote page's phone -->
        <div class="dark phone-card">
          <div class="bezel-phone">
            <div class="bezel-screen">
              <video src={`${V}/placing.mp4`} autoplay loop muted playsinline></video>
            </div>
            <img src={`${V}/phone-bezel.webp`} alt="" />
          </div>
        </div>
        <div class="dark fit-fill"><EdgeChart client:visible /></div>
      </div>
    </section>

  </main>

  <script>
    import { initReveal } from "../../components/website/reveal";
    initReveal();

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>
</Website>
