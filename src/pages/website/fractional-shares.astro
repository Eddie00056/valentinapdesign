---
import Website from "../../layouts/Website.astro";
import SiteHeader from "../../components/website/SiteHeader.astro";
import ContactFooter from "../../components/website/ContactFooter.astro";
import { LiveFit } from "../../components/website/LiveFit";
import { FracFlowPhone } from "../../components/website/FracFlowPhone";
import { FracBanner, FracPill } from "../../components/website/FracBanner";
import { BeamDemo } from "../../components/beamring/BeamDemo";
import "../../components/beamring/beam-ring.css";
import "../../components/beamring/beam-demo.css";
import "../../components/website/case-study.css";

const V = "/website/case/fractional";
const P = "/website/video"; // shared prototype clips from the homepage
---

<Website
  title="Fractional Shares"
  description="Fractional Shares at Questrade — 1 feature, 2 platforms, 2 personas, $33M in revenue."
>
  <SiteHeader />

  <main class="cs">
    <section class="cs-hero w-wrap" data-reveal>
      <h1 class="cs-title">1 Feature. 2 Platforms. 2 Personas. $33M in Revenue</h1>
    </section>

    <div class="cs-media cs-media--hero w-wrap" data-reveal>
      <video src={`${V}/hero.mp4`} autoplay loop muted playsinline preload="metadata"></video>
    </div>

    <section class="cs-overview w-wrap" data-reveal>
      <div class="cs-block" data-r>
        <p class="cs-label">Project overview</p>
        <p class="cs-body">
          As Questrade eliminated trading commissions, it opened new
          opportunities for growth, leading to the introduction of fractional
          share trading. The goal was to provide traders with a more affordable
          way to enter the market.
        </p>
      </div>

      <div class="cs-block" data-r>
        <p class="cs-label">What I led</p>
        <p class="cs-body">
          Led feature validation and secured leadership buy-in, driving iterative
          design through user research and usability testing. Oversaw design
          handoff and QA across four platforms, partnered with product on the
          alpha launch, and designed an in-app survey to turn launch insights
          into actionable findings.
        </p>
      </div>

      <div class="cs-meta">
        <div class="cs-block" data-r>
          <p class="cs-label">My role</p>
          <p class="cs-body">
            1 Product Manager, 1 UX Researcher, 1 Content Designer, 4 Engineering
            squads
          </p>
        </div>
        <div class="cs-block" data-r>
          <p class="cs-label">Timeline</p>
          <p class="cs-body">5 months</p>
        </div>
      </div>
    </section>

    <section class="cs-impact w-wrap" data-reveal>
      <h2 data-r>Project impact</h2>
      <ul class="cs-stats">
        <li data-r><span class="n">65K</span><span class="l">increase in trading volume</span></li>
        <li data-r><span class="n">$33M</span><span class="l">total value traded ($507 avg. trade value)</span></li>
        <li data-r><span class="n">47K</span><span class="l">unique clients adopted the feature</span></li>
      </ul>
    </section>

    <section class="cs-award w-wrap" data-reveal>
      <p class="headline">UX Design Awards</p>
      <p class="sub">Fall 2025 Nominee</p>
    </section>

    <section class="cs-panels w-wrap" data-reveal>
      <figure class="panel-light">
        <figcaption>Regular trading platform</figcaption>
        <!-- deck slide 92: the novice platform's live order flow -->
        <div class="panel-live">
          <LiveFit
            client:visible
            src="/work/fractional-order-flow"
            fit=".fof-frame"
            css=".fof-stage{background:none!important}"
            retouch="flowToPhoneFrame"
            vw={1280}
            vh={1000}
            pad={0}
            byHeight
            title="Fractional order flow"
          />
        </div>
      </figure>
      <figure class="panel-dark">
        <figcaption>Advanced trading platform</figcaption>
        <!-- deck slide 94: the advanced platform's live order placement -->
        <div class="panel-live">
          <LiveFit
            client:visible
            src="/work/order-placement-boxed"
            fit={'img[src*="iphone"]'}
            css=".phone-stage{background:none!important}"
            vw={1280}
            vh={1000}
            pad={0}
            byHeight
            title="Order placement"
          />
        </div>
      </figure>
    </section>

    <section class="cs-bento w-wrap" data-reveal>
      <!-- Framer's first row: the phone, and the banner over the pill, the
           pair as tall as the phone card -->
      <div class="bento-row">
        <!-- the homepage card's live pieces: the order flow, the banner,
             the limit-order ring -->
        <div class="light phone phone--foot live-card">
          <FracFlowPhone client:visible fill={0.532} top={0.155} />
        </div>
        <div class="col">
          <div class="light live-card">
            <FracBanner client:visible />
          </div>
          <div class="light live-card">
            <FracPill client:visible />
          </div>
        </div>
      </div>
      <!-- second row: the chart over the stepper, as tall together as the
           placing phone beside them -->
      <div class="bento-row bento-row--dark">
        <div class="col">
          <!-- /work/beam-ring: the light running round the Place order button -->
          <div class="dark clip--chart clip--beam">
            <BeamDemo client:visible />
          </div>
          <div class="dark clip--stepper">
            <video src={`${V}/placing.mp4`} autoplay loop muted playsinline></video>
          </div>
        </div>
        <div class="dark phone phone--foot phone--placing">
          <video src={`${V}/stepper.mp4`} autoplay loop muted playsinline></video>
        </div>
      </div>
    </section>

    <ContactFooter />
  </main>

  <script>
    import { initReveal } from "../../components/website/reveal";
    initReveal();

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>
</Website>
