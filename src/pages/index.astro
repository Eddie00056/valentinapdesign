---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";
import { TogglePreview } from "../components/motionlab/TogglePreview";
import { LimitOrderErrorPreview } from "../components/glasslab/LimitOrderErrorPreview";
import { FractionalSharesBannerPreview } from "../components/glasslab/FractionalSharesBannerPreview";
import { AlertCreationPreview } from "../components/alertscreen/AlertCreationPreview";
import { IframePreview } from "../components/gallery/IframePreview";
import "../components/motionlab/motionlab.css";
import "../components/glasslab/glasslab.css";
---

<Base>
  <div class="page">
    <header>
      <h1>{site.name}</h1>
      <p class="mono links-row">
        <a class="link-underline" href="/website">Website ↗</a>
        <span class="sep" aria-hidden="true">·</span>
        <a class="link-underline" href="/website/presentation">Presentation ↗</a>
      </p>
    </header>

    <ul class="grid">
      {pieces.map((p) => (
        <li>
          <a href={p.href} aria-label={p.title}>
            <span class="thumb">
              {p.slug === "stock-option-toggle" && <TogglePreview client:visible />}
              {p.slug === "limit-order-error" && (
                <LimitOrderErrorPreview client:visible />
              )}
              {p.slug === "fractional-shares-banner" && (
                <FractionalSharesBannerPreview client:visible />
              )}
              {p.slug === "alert-prototype" && (
                <svg
                  class="mark"
                  viewBox="0 0 120 120"
                  role="img"
                  aria-label="Alert creation prototype"
                >
                  <rect width="120" height="120" rx="18" fill="#ffffff"></rect>
                  <g
                    stroke="#48d597"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  >
                    <path d="M78 52a18 18 0 1 0-36 0c0 13-5 17-5 17h46s-5-4-5-17Z"
                    ></path>
                    <path d="M52 76a8 8 0 0 0 16 0"></path>
                  </g>
                </svg>
              )}
              {p.slug === "alert-creation" && (
                <AlertCreationPreview client:visible />
              )}
              {p.slug === "order-placement-boxed" && (
                <svg
                  class="mark"
                  viewBox="0 0 120 120"
                  role="img"
                  aria-label="Order placement"
                >
                  <rect width="120" height="120" rx="18" fill="#ffffff"></rect>
                  <g fill="none" stroke="#3a3f47" stroke-width="3">
                    <rect x="26" y="30" width="68" height="13" rx="4"></rect>
                    <rect x="26" y="51" width="68" height="13" rx="4"></rect>
                    <rect x="26" y="72" width="68" height="13" rx="4"></rect>
                  </g>
                  <rect x="20" y="95" width="37" height="12" rx="6" fill="#ff557d"
                  ></rect>
                  <rect x="63" y="95" width="37" height="12" rx="6" fill="#48d597"
                  ></rect>
                </svg>
              )}
              {p.slug === "order-placed-animation" && (
                <svg
                  class="mark"
                  viewBox="0 0 120 120"
                  role="img"
                  aria-label="Order placed animation"
                >
                  <rect width="120" height="120" rx="18" fill="#ffffff"></rect>
                  <circle cx="60" cy="60" r="34" fill="#48d597"
                    fill-opacity="0.1"></circle>
                  <circle
                    cx="60"
                    cy="60"
                    r="34"
                    fill="none"
                    stroke="#48d597"
                    stroke-width="4"
                  ></circle>
                  <path
                    d="M47 61 L56 70 L74 50"
                    fill="none"
                    stroke="#48d597"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              )}
              {p.slug === "options-strategy-builder" && (
                <IframePreview
                  client:visible
                  src="/work/options-strategy-builder"
                  cropWidth={284}
                  cropHeight={172}
                  frameWidth={1200}
                  frameHeight={500}
                  scale={0.57}
                  offsetX={-200}
                  offsetY={-43}
                />
              )}
              {p.slug === "fractional-order-flow" && (
                <svg
                  class="mark"
                  viewBox="0 0 120 120"
                  role="img"
                  aria-label="Fractional order flow"
                >
                  <rect width="120" height="120" rx="18" fill="#ffffff"></rect>
                  <rect x="26" y="28" width="68" height="26" rx="6"
                    fill="none" stroke="#3a3f47" stroke-width="3"></rect>
                  <rect x="34" y="37" width="30" height="4" rx="2" fill="#6f8b3f"
                  ></rect>
                  <rect x="34" y="45" width="20" height="3" rx="1.5"
                    fill="#3a3f47"></rect>
                  <rect x="26" y="62" width="68" height="14" rx="4"
                    fill="none" stroke="#3a3f47" stroke-width="3"></rect>
                  <rect x="26" y="90" width="68" height="14" rx="7" fill="#227c20"
                  ></rect>
                </svg>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 6vw, 5rem);
    padding: clamp(1.5rem, 1rem + 4vw, 4rem);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
  }

  header .mono a {
    color: var(--ink-faint);
  }

  header .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  header .links-row .sep {
    color: var(--ink-faint);
  }

  /* Masonry: browser-computed column count (not a fixed breakpoint list),
     each tile's own height set by its content instead of a forced
     aspect-ratio — the whole point being tiles of very different natural
     shapes (a tall phone mockup next to a short toggle-switch snippet)
     sitting in the same grid, Pinterest-style. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    column-width: 300px;
    column-gap: 1.5rem;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  .thumb {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #ffffff;
    transition: border-color 0.15s ease;
  }

  a:hover .thumb {
    border-color: var(--ink-faint);
  }

  /* Tiles still on the placeholder icon mark (not yet a live/real
     preview) keep the old centred-square treatment so they don't
     collapse to nothing. */
  .thumb:has(.mark) {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }

  .thumb .mark {
    width: 84px;
    height: 84px;
  }
</style>
