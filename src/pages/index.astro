---
/* The site's front door is the presentation: the deck fills the window
   and starts on slide 1 (or the #slide-N deep link). A hidden side-nav on
   the left edge — a hairline handle until hovered, then a panel slides in
   with the gallery header's own pair of links: the website and the
   prototypes gallery (/prototypes, the old root). */
import Website from "../layouts/Website.astro";
import GustoDeck from "../components/website/deck/GustoDeck.astro";
---

<Website
  title="Portfolio presentation"
  description="The portfolio presentation — three active-trader case studies at Questrade, end to end."
>
  <main class="gp">
    <GustoDeck solo />
    <nav class="gp-nav" aria-label="Site">
      <span class="gp-nav-handle" aria-hidden="true"></span>
      <div class="gp-nav-panel">
        <a href="/website">Website ↗</a>
        <a href="/prototypes">Prototypes ↗</a>
      </div>
    </nav>
  </main>
</Website>

<style is:global>
  /* the deck is fixed to the window; nothing behind it may scroll */
  html,
  body {
    height: 100%;
    overflow: hidden;
    background: #000;
  }
</style>

<style>
  .gp {
    min-height: 100vh;
    background: #000;
  }
  /* The side-nav sits above the deck (its stage is z 1000). At rest it is
     a 2px hairline at the top-left edge, faint; the hot zone around it is
     wider than it looks. Hovering slides the panel in from the left and
     the links follow it a beat apart. All CSS transitions: compositor-
     driven, so they run even when a frame loop would be throttled, and
     they never get in the way of the slide underneath. */
  .gp-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1001;
    width: 28px;
    height: 120px;
  }
  .gp-nav-handle {
    position: absolute;
    top: 22px;
    left: 10px;
    width: 2px;
    height: 24px;
    border-radius: 1px;
    background: #fff;
    opacity: 0.22;
    mix-blend-mode: difference;
    transform-origin: 50% 50%;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .gp-nav:hover .gp-nav-handle,
  .gp-nav:focus-within .gp-nav-handle {
    opacity: 0;
    transform: scaleY(0.4);
  }
  .gp-nav-panel {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 26px 20px 20px;
    border-radius: 0 0 14px 0;
    background: rgba(8, 8, 8, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset -1px -1px 0 rgba(255, 255, 255, 0.06);
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.38s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.22s ease;
  }
  .gp-nav:hover .gp-nav-panel,
  .gp-nav:focus-within .gp-nav-panel {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }
  .gp-nav-panel a {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: #8a8a8a;
    text-decoration: underline;
    text-decoration-color: #4a4a4a;
    text-underline-offset: 0.2em;
    transform: translateX(-10px);
    opacity: 0;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease,
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.25s ease;
  }
  .gp-nav-panel a:nth-child(2) {
    transition-delay: 0s, 0s, 0.06s, 0.06s;
  }
  .gp-nav:hover .gp-nav-panel a,
  .gp-nav:focus-within .gp-nav-panel a {
    transform: translateX(0);
    opacity: 1;
  }
  .gp-nav-panel a:hover {
    color: #f2f2f2;
    text-decoration-color: #f2f2f2;
  }
  @media (prefers-reduced-motion: reduce) {
    .gp-nav-handle,
    .gp-nav-panel,
    .gp-nav-panel a {
      transition-duration: 0.01ms;
    }
  }
</style>
