---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";
import { TogglePreview } from "../components/motionlab/TogglePreview";
import { LimitOrderErrorPreview } from "../components/glasslab/LimitOrderErrorPreview";
import { FractionalSharesBannerPreview } from "../components/glasslab/FractionalSharesBannerPreview";
import "../components/motionlab/motionlab.css";
import "../components/glasslab/glasslab.css";
---

<Base>
  <div class="page">
    <h1>{site.name}</h1>

    <ul class="grid">
      {pieces.map((p) => (
        <li>
          <a href={p.href} aria-label={p.title}>
            <span class="thumb">
              {p.slug === "stock-option-toggle" && <TogglePreview client:visible />}
              {p.slug === "limit-order-error" && (
                <LimitOrderErrorPreview client:visible />
              )}
              {p.slug === "fractional-shares-banner" && (
                <FractionalSharesBannerPreview client:visible />
              )}
              {p.slug === "alert-prototype" && (
                <svg
                  class="mark"
                  viewBox="0 0 120 120"
                  role="img"
                  aria-label="Alert creation prototype"
                >
                  <rect width="120" height="120" rx="18" fill="#111317"></rect>
                  <g
                    stroke="#48d597"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  >
                    <path d="M78 52a18 18 0 1 0-36 0c0 13-5 17-5 17h46s-5-4-5-17Z"
                    ></path>
                    <path d="M52 76a8 8 0 0 0 16 0"></path>
                  </g>
                </svg>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 6vw, 5rem);
    padding: clamp(1.5rem, 1rem + 4vw, 4rem);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 360px));
    gap: 1.5rem;
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    transition: border-color 0.15s ease;
  }

  a:hover .thumb {
    border-color: var(--ink-faint);
  }

  .thumb .mark {
    width: 84px;
    height: 84px;
  }
</style>
