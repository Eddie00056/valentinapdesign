---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";
import manifest from "../../public/thumbs/manifest.json";

/* The gallery, rebuilt on tcosta.com/wspoc's model.

   Every card is a short muted looping MP4 of the piece's component — not the
   whole prototype page — with a poster, `preload="none"`, played only while
   it is on screen. The grid therefore paints from posters at once and still
   moves, and a video that is scrolled away costs nothing. Clips, posters and
   their sizes come from scripts/record.mjs (public/thumbs/manifest.json).

   Layout is his masonry: a CSS grid with 1px auto rows, each card spanning as
   many rows as its thumbnail is tall, so cards keep their real aspect ratio
   and DOM order is preserved while columns pack. Density is 3-5 columns. */

type Thumb = { w: number; h: number };
const thumbs = manifest as Record<string, Thumb>;
const cards = pieces
  .filter((p) => thumbs[p.slug])
  .map((p) => ({ ...p, thumb: thumbs[p.slug] }));
---

<Base>
  <main class="vp-container">
    <header class="vp-header">
      <div class="vp-header-left">
        <h1 class="vp-title">{site.name}</h1>
        <p class="mono vp-links">
          <a class="link-underline" href="/website">Website ↗</a>
          <span class="vp-sep" aria-hidden="true">·</span>
          <a class="link-underline" href="/website/presentation">Presentation ↗</a>
        </p>
      </div>

      <div class="vp-header-right">
        <div class="vp-zoom" role="group" aria-label="Grid density">
          <button type="button" class="vp-zoom-btn" data-step="-1" aria-label="Zoom in — fewer, larger cards">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M2 7.33A5.33 5.33 0 0 1 7.33 2a5.33 5.33 0 0 1 4.21 8.6l2.26 2.26a.67.67 0 1 1-.94.94l-2.26-2.26A5.33 5.33 0 0 1 2 7.33Zm6-2a.67.67 0 0 0-1.33 0v1.34H5.33a.67.67 0 0 0 0 1.33h1.34v1.33a.67.67 0 0 0 1.33 0V8h1.33a.67.67 0 0 0 0-1.33H8V5.33Z"
                fill="currentColor"></path>
            </svg>
          </button>
          <div
            class="vp-zoom-track"
            role="slider"
            tabindex="0"
            aria-label="Columns"
            aria-valuemin="3"
            aria-valuemax="5"
            aria-valuenow="3"
          >
            <span class="vp-zoom-line" aria-hidden="true"></span>
            <span class="vp-zoom-dot" style="left:6px" aria-hidden="true"></span>
            <span class="vp-zoom-dot" style="left:34px" aria-hidden="true"></span>
            <span class="vp-zoom-dot" style="left:62px" aria-hidden="true"></span>
            <span class="vp-zoom-knob" aria-hidden="true"></span>
          </div>
          <button type="button" class="vp-zoom-btn" data-step="1" aria-label="Zoom out — more, smaller cards">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M7.33 2a5.33 5.33 0 1 0 3.27 9.55l2.26 2.26a.67.67 0 1 0 .94-.94l-2.26-2.26A5.33 5.33 0 0 0 7.33 2ZM10 7.33a.67.67 0 0 1-.67.67h-4a.67.67 0 0 1 0-1.33h4c.37 0 .67.3.67.66Z"
                fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class="vp-grid">
      {
        cards.map((c) => (
          <a href={c.href} class="vp-card">
            <div class="vp-card-thumb" style={`--ar:${c.thumb.w} / ${c.thumb.h}`}>
              <video
                class="vp-card-video"
                src={`/thumbs/${c.slug}.mp4`}
                poster={`/thumbs/${c.slug}.webp`}
                width={c.thumb.w}
                height={c.thumb.h}
                muted
                loop
                playsinline
                preload="none"
                aria-label={c.title}
              />
              <div class="vp-card-overlay">
                <span class="vp-card-title">
                  <span>{c.title}</span>
                </span>
                <span class="vp-card-lang">tsx</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<script is:inline>
  (function () {
    const SCROLL_KEY = "vp-gallery-scroll";
    const STORE_KEY = "vp-gallery-cols";
    const MIN = 3;
    const MAX = 5;

    /* Come back from a piece to where you were. Saved on the way out and
       restored once the masonry has real height — the browser's own
       restoration runs before layout and lands in the wrong place. */
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    addEventListener("pagehide", () => {
      try {
        sessionStorage.setItem(SCROLL_KEY, String(scrollY));
      } catch (e) {}
    });
    function restoreScroll() {
      let fromPiece = false;
      let navType = "";
      try {
        fromPiece = /\/work\/[^/]+/.test(document.referrer || "");
      } catch (e) {}
      try {
        navType = (performance.getEntriesByType("navigation")[0] || {}).type || "";
      } catch (e) {}
      if (!fromPiece && navType !== "back_forward") return;
      let y = null;
      try {
        y = sessionStorage.getItem(SCROLL_KEY);
      } catch (e) {}
      if (y !== null) scrollTo(0, parseInt(y, 10) || 0);
    }

    const grid = document.querySelector(".vp-grid");
    if (!grid) return;

    /* Posters decode before the grid is shown, so every card appears in the
       same beat instead of one by one. They are small (the whole set is
       well under a megabyte) and capped at 2s on a slow connection. */
    const posters = [...grid.querySelectorAll("video")].map((v) => {
      const img = new Image();
      img.src = v.getAttribute("poster");
      return img.decode ? img.decode().catch(() => {}) : Promise.resolve();
    });
    const postersReady = Promise.race([
      Promise.all(posters),
      new Promise((r) => setTimeout(r, 2000)),
    ]);

    let lastWidth = -1;
    let raf = 0;
    let revealed = false;

    /* Masonry. Each card spans ceil((thumb height + gap) / row unit) rows of
       the 1px grid, so cards keep their true height and pack. */
    const layout = () => {
      const s = getComputedStyle(grid);
      const unit = parseFloat(s.gridAutoRows) || 1;
      const gap = parseFloat(s.columnGap) || 0;
      grid.querySelectorAll(".vp-card").forEach((card) => {
        const thumb = card.querySelector(".vp-card-thumb");
        const h = thumb && thumb.getBoundingClientRect().height;
        if (h) card.style.gridRowEnd = "span " + Math.ceil((h + gap) / unit);
      });
      if (!revealed) {
        revealed = true;
        postersReady.then(() => {
          restoreScroll();
          grid.classList.add("is-ready");
        });
      }
    };

    const schedule = (force) => {
      /* Only relayout when the width changed: our own span writes change the
         grid's height, and reacting to that would loop the ResizeObserver.
         A column change alters card widths without the grid's, so it forces. */
      const w = grid.clientWidth;
      if (!force && w === lastWidth) return;
      lastWidth = w;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(layout);
    };

    /* Density: 3-5 columns. Zoom in = fewer, larger. */
    const zoom = document.querySelector(".vp-zoom");
    const track = zoom && zoom.querySelector(".vp-zoom-track");
    let cols = 0;
    const setCols = (n, persist) => {
      n = Math.max(MIN, Math.min(MAX, n | 0));
      if (n === cols) return;
      cols = n;
      grid.style.setProperty("--vp-cols", String(n));
      if (zoom) zoom.style.setProperty("--zoom-pos", String(n - MIN));
      if (track) track.setAttribute("aria-valuenow", String(n));
      if (persist) {
        try {
          localStorage.setItem(STORE_KEY, String(n));
        } catch (e) {}
      }
      schedule(true);
    };

    if (zoom) {
      zoom.querySelectorAll(".vp-zoom-btn").forEach((b) => {
        b.addEventListener("click", () => setCols(cols + Number(b.dataset.step), true));
      });
    }
    if (track) {
      // nearest of the three stops; the line is inset 6px at each end
      const stopFromX = (clientX) => {
        const r = track.getBoundingClientRect();
        const t = Math.max(0, Math.min(1, (clientX - r.left - 6) / (r.width - 12)));
        return MIN + Math.round(t * (MAX - MIN));
      };
      let dragging = false;
      track.addEventListener("pointerdown", (e) => {
        dragging = true;
        track.setPointerCapture(e.pointerId);
        setCols(stopFromX(e.clientX), true);
      });
      track.addEventListener("pointermove", (e) => {
        if (dragging) setCols(stopFromX(e.clientX), true);
      });
      const end = (e) => {
        dragging = false;
        try {
          track.releasePointerCapture(e.pointerId);
        } catch (x) {}
      };
      track.addEventListener("pointerup", end);
      track.addEventListener("pointercancel", end);
      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowUp") {
          e.preventDefault();
          setCols(cols + 1, true);
        } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
          e.preventDefault();
          setCols(cols - 1, true);
        }
      });
    }

    let initial = 3;
    try {
      const saved = parseInt(localStorage.getItem(STORE_KEY) || "", 10);
      if (saved >= MIN && saved <= MAX) initial = saved;
    } catch (e) {}
    setCols(initial, false);

    if ("ResizeObserver" in window) {
      new ResizeObserver(() => schedule(false)).observe(grid);
    } else {
      schedule(true);
      addEventListener("resize", () => schedule(true));
    }

    /* Play only what is on screen. With preload="none" an MP4 isn't fetched
       until its first play(), so everything below the fold is free until it
       scrolls near. Reduced motion keeps the posters and never plays. */
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target;
          if (entry.isIntersecting) {
            const p = v.play();
            if (p && p.catch) p.catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { rootMargin: "200px 0px" },
    );
    grid.querySelectorAll("video").forEach((v) => io.observe(v));
  })();
</script>

<style>
  /* Values follow tcosta.com/wspoc's gallery stylesheet; the type is ours. */
  .vp-container {
    max-width: 1920px;
    min-height: 100dvh;
    margin: 0 auto;
    padding: calc(40px + env(safe-area-inset-top, 0px)) 40px 80px;
    background: #000;
    color: #f2f2f2;
  }

  .vp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: 40px;
    gap: 16px;
  }

  .vp-header-left {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .vp-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .vp-links {
    display: flex;
    gap: 0.6rem;
    margin: 0;
  }
  .vp-links a {
    color: #8a8a8a;
  }
  .vp-links a:hover {
    color: #f2f2f2;
  }
  .vp-sep {
    color: #4a4a4a;
  }

  .vp-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ---- density control ---- */
  .vp-zoom {
    --zoom-pos: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.06);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
  }
  .vp-zoom-btn {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    background: none;
    color: #c6c6c6;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s;
  }
  .vp-zoom-btn:hover {
    color: #e6e6e6;
  }
  .vp-zoom-btn svg {
    display: block;
  }
  .vp-zoom-track {
    position: relative;
    width: 68px;
    height: 16px;
    cursor: pointer;
    touch-action: none;
  }
  .vp-zoom-track:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 4px;
    border-radius: 100px;
  }
  .vp-zoom-line {
    position: absolute;
    top: 50%;
    left: 6px;
    right: 6px;
    height: 1.5px;
    border-radius: 2px;
    background: #444;
    transform: translateY(-50%);
  }
  .vp-zoom-dot {
    position: absolute;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #444;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }
  .vp-zoom-knob {
    position: absolute;
    top: 50%;
    left: calc(6px + var(--zoom-pos, 0) * 28px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c6c6c6;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* ---- grid ---- */
  .vp-grid {
    display: grid;
    grid-template-columns: repeat(var(--vp-cols, 3), 1fr);
    grid-auto-rows: 1px;
    gap: 0 20px;
    opacity: 0;
  }
  .vp-grid.is-ready {
    opacity: 1;
    transition: opacity 0.25s;
  }
  @media (scripting: none) {
    .vp-grid {
      opacity: 1;
    }
  }

  /* ---- card ---- */
  .vp-card {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.3, 1.9, 0.4, 1);
  }
  @media (hover: hover) {
    .vp-card {
      will-change: transform;
      backface-visibility: hidden;
      transform: translateZ(0);
    }
    .vp-card:hover {
      z-index: 2;
      transform: scale(1.01) translateZ(0);
      transition: transform 0.3s cubic-bezier(0.34, 1.5, 0.64, 1);
    }
  }

  .vp-card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar, 3 / 2);
    overflow: hidden;
    border-radius: 8px;
    background: #141414;
  }
  /* the hairline rim */
  .vp-card-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      336.4deg,
      rgba(62, 63, 64, 0.5) 14.76%,
      rgba(62, 63, 64, 0.15) 51.14%,
      rgba(62, 63, 64, 0.5) 93.14%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .vp-card-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* name bottom-left, stack bottom-right — both rise in on hover */
  .vp-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px;
    padding: 12px;
    pointer-events: none;
  }
  .vp-card-title {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    height: 30px;
    padding: 0 13px;
    border-radius: 100px;
    background: rgba(20, 20, 20, 0.36);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    backdrop-filter: blur(12px) saturate(1.3);
    opacity: 0;
    transform: translateY(4px);
    will-change: opacity, transform;
    transition:
      opacity 0.2s,
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .vp-card-title span {
    position: relative;
    top: -0.5px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .vp-card-lang {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 10px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.8);
    border: 0.5px solid rgba(0, 0, 0, 0.1);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #333;
    font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, Consolas, monospace;
    font-size: 10.5px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(4px);
    will-change: opacity, transform;
    transition:
      opacity 0.2s,
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .vp-card:hover .vp-card-title,
  .vp-card:hover .vp-card-lang,
  .vp-card:focus-visible .vp-card-title,
  .vp-card:focus-visible .vp-card-lang {
    opacity: 1;
    transform: translateY(0);
  }
  .vp-card:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.5);
    outline-offset: 3px;
    border-radius: 10px;
  }
  @media (hover: none) {
    .vp-card-overlay {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-card {
      will-change: auto;
      transition: none;
      transform: none;
    }
    .vp-card:hover {
      transform: none;
    }
  }

  @media (width <= 768px) {
    .vp-container {
      padding: calc(40px + env(safe-area-inset-top, 0px)) 16px 60px;
    }
    .vp-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 12px;
    }
    .vp-zoom {
      display: none;
    }
  }
</style>
