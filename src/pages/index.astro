---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";
import { TogglePreview } from "../components/motionlab/TogglePreview";
import { LimitOrderErrorPreview } from "../components/glasslab/LimitOrderErrorPreview";
import { FractionalSharesBannerPreview } from "../components/glasslab/FractionalSharesBannerPreview";
import "../components/motionlab/motionlab.css";
import "../components/glasslab/glasslab.css";
---

<Base>
  <div class="page">
    <h1>{site.name}</h1>

    <ul class="grid">
      {pieces.map((p) => (
        <li>
          <a href={p.href} aria-label={p.title}>
            <span class="thumb">
              {p.slug === "stock-option-toggle" && <TogglePreview client:visible />}
              {p.slug === "limit-order-error" && (
                <LimitOrderErrorPreview client:visible />
              )}
              {p.slug === "fractional-shares-banner" && (
                <FractionalSharesBannerPreview client:visible />
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 6vw, 5rem);
    padding: clamp(1.5rem, 1rem + 4vw, 4rem);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 360px));
    gap: 1.5rem;
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    transition: border-color 0.15s ease;
  }

  a:hover .thumb {
    border-color: var(--ink-faint);
  }
</style>
