---
/* The site's front door is the presentation: the deck fills the window
   and starts on slide 1 (or the #slide-N deep link). Two quiet links, top
   left — the gallery header's own pair — lead to the website and to the
   prototypes gallery (/prototypes, the old root). */
import Website from "../layouts/Website.astro";
import GustoDeck from "../components/website/deck/GustoDeck.astro";
---

<Website
  title="Portfolio presentation"
  description="The portfolio presentation — three active-trader case studies at Questrade, end to end."
>
  <main class="gp">
    <GustoDeck solo />
    <p class="gp-links">
      <a href="/website">Website ↗</a>
      <span class="gp-sep" aria-hidden="true">·</span>
      <a href="/prototypes">Prototypes ↗</a>
    </p>
  </main>
</Website>

<style is:global>
  /* the deck is fixed to the window; nothing behind it may scroll */
  html,
  body {
    height: 100%;
    overflow: hidden;
    background: #000;
  }
</style>

<style>
  .gp {
    min-height: 100vh;
    background: #000;
  }
  /* Above the deck (its stage is z 1000). The gallery header's links,
     verbatim: mono, 12px, grey to white on hover. Difference blending
     keeps them legible over the white slides too. */
  .gp-links {
    position: fixed;
    top: 18px;
    left: 20px;
    z-index: 1001;
    display: flex;
    gap: 0.6rem;
    margin: 0;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    mix-blend-mode: difference;
  }
  .gp-links a {
    color: #8a8a8a;
    text-decoration: underline;
    text-decoration-color: #4a4a4a;
    text-underline-offset: 0.2em;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .gp-links a:hover {
    color: #f2f2f2;
    text-decoration-color: #f2f2f2;
  }
  .gp-sep {
    color: #4a4a4a;
  }
</style>
