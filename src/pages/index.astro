---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";

/* Gallery zoom, expressed as column COUNT rather than column width. A
   width-based slider wastes steps: two different widths often resolve to
   the same number of columns, and the widest drops to a single column.
   Counts always change what you see. `column-width` still rides along as
   a floor, so narrow viewports quietly use fewer than asked. */
const ZOOM_STEPS = [5, 4, 3, 2];
/* Second step from the zoomed-out end: four columns, dropping to fewer on
   narrower viewports once the 260px floor bites. */
const ZOOM_DEFAULT = 1;
---

<Base>
  <div class="page" style={`--cols: ${ZOOM_STEPS[ZOOM_DEFAULT]}`}>
    <header>
      <div class="head-left">
        <h1>{site.name}</h1>
        <p class="mono links-row">
          <a class="link-underline" href="/website">Website ↗</a>
          <span class="sep" aria-hidden="true">·</span>
          <a class="link-underline" href="/website/presentation">Presentation ↗</a>
        </p>
      </div>

      <div class="zoom">
        <svg class="zoom-i" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.2"></circle>
          <path d="M10.2 10.2 13.4 13.4"></path>
        </svg>
        <input
          id="zoom"
          type="range"
          min="0"
          max={ZOOM_STEPS.length - 1}
          step="1"
          value={ZOOM_DEFAULT}
          aria-label="Thumbnail size"
        />
        <svg class="zoom-i zoom-i--lg" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.2"></circle>
          <path d="M10.2 10.2 13.4 13.4M7 5.1v3.8M5.1 7h3.8"></path>
        </svg>
      </div>
    </header>

    <ul class="grid">
      {
        pieces.map((p, i) => (
          <li>
            <a href={p.href} aria-label={p.title}>
              <span
                class="thumb"
                data-src={p.href}
                data-title={p.title}
                style={`aspect-ratio: ${p.previewWidth} / ${p.previewHeight}; --vw: ${p.previewWidth}; --vh: ${p.previewHeight}`}
              >
                {/* The poster IS the tile. It is a static capture of the
                    piece (scripts/thumbs.py) and paints with the page — no
                    React, no Motion, no fonts, no phone PNG to decode. The
                    live piece only mounts on hover; see the script below.
                    The first row loads eagerly so the fold is never blank. */}
                <img
                  class="poster"
                  src={`/thumbs/${p.slug}.webp`}
                  alt=""
                  width={p.previewWidth}
                  height={p.previewHeight}
                  decoding="async"
                  loading={i < 8 ? "eager" : "lazy"}
                  fetchpriority={i < 4 ? "high" : "auto"}
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script data-zoom-steps={JSON.stringify(ZOOM_STEPS)} is:inline define:vars={{ ZOOM_STEPS }}>
  const page = document.querySelector(".page");
  const slider = document.getElementById("zoom");

  slider?.addEventListener("input", () => {
    page.style.setProperty("--cols", String(ZOOM_STEPS[+slider.value]));
  });

  /* Each tile renders its page at that piece's own viewport width and
     scales it to the tile's measured width. Measuring beats computing it
     from the column count: a multi-column layout stretches its columns to
     fill the container, so the rendered width is never predictable. */
  const fit = (el) => {
    const w = el.getBoundingClientRect().width;
    const vw = Number(getComputedStyle(el).getPropertyValue("--vw")) || 1280;
    if (w) el.style.setProperty("--s", String(w / vw));
  };

  const thumbs = [...document.querySelectorAll(".thumb")];
  thumbs.forEach(fit);

  /* Live on hover. Every tile used to be an iframe booting its whole piece
     at load, a dozen React apps at once, and the grid sat black until they
     arrived. Now the poster shows immediately and the real piece is mounted
     only when the pointer asks for it — and only on a device that has a
     pointer that hovers, so touch never pays for it. It stays hidden until
     its own load event, then fades in over the matching poster, so there is
     never a blank frame between the two. Once mounted it is kept. */
  if (matchMedia("(hover: hover)").matches) {
    const mount = (t) => {
      if (t.querySelector("iframe")) return;
      const f = document.createElement("iframe");
      f.src = t.dataset.src;
      f.title = t.dataset.title;
      f.tabIndex = -1;
      f.setAttribute("aria-hidden", "true");
      f.setAttribute("scrolling", "no");
      f.style.width = getComputedStyle(t).getPropertyValue("--vw") + "px";
      f.style.height = getComputedStyle(t).getPropertyValue("--vh") + "px";
      f.addEventListener("load", () => {
        // one more frame so the piece's own first paint has landed
        setTimeout(() => t.classList.add("is-live"), 250);
      });
      t.appendChild(f);
    };
    thumbs.forEach((t) =>
      t.closest("a").addEventListener("pointerenter", () => mount(t), { passive: true }),
    );
  }

  if ("ResizeObserver" in window) {
    const ro = new ResizeObserver((entries) => {
      for (const e of entries) fit(e.target);
    });
    thumbs.forEach((t) => ro.observe(t));
  } else {
    addEventListener("resize", () => thumbs.forEach(fit));
  }
</script>

<style>
  /* Dark gallery, after tcosta.com/wspoc: a black page, near-black cards at
     an 8px radius, and each prototype rendered live inside its own card so
     the page's own background becomes the tile's margin. Nothing is
     cropped to fit and nothing is scaled up to fill — the UI floats. */
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1rem + 4vw, 3rem);
    padding: clamp(1.25rem, 1rem + 2vw, 2rem);
    background: #000;
    color: #f2f2f2;
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .head-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: #f2f2f2;
  }

  header .mono a {
    color: #8a8a8a;
  }

  header .mono a:hover {
    color: #f2f2f2;
  }

  header .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  header .links-row .sep {
    color: #4a4a4a;
  }

  /* ---------- zoom ---------- */

  .zoom {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 11px;
    border-radius: 999px;
    background: #141414;
    border: 1px solid #232323;
  }

  .zoom-i {
    width: 13px;
    height: 13px;
    flex: none;
    fill: none;
    stroke: #8a8a8a;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .zoom-i--lg {
    width: 16px;
    height: 16px;
  }

  #zoom {
    -webkit-appearance: none;
    appearance: none;
    width: 104px;
    height: 3px;
    border-radius: 3px;
    background: #333;
    cursor: pointer;
  }

  #zoom::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #f2f2f2;
    transition: transform 0.18s cubic-bezier(0.3, 1.9, 0.4, 1);
  }

  #zoom:hover::-webkit-slider-thumb,
  #zoom:active::-webkit-slider-thumb {
    transform: scale(1.25);
  }

  #zoom::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: #f2f2f2;
  }

  /* ---------- grid ---------- */

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: var(--cols);
    /* Floor, so a narrow viewport uses fewer columns than asked rather
       than squeezing five unreadable ones in. */
    column-width: 260px;
    column-gap: 20px;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 20px;
  }

  .thumb {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #141414;
    /* Tiago's springy curve — it overshoots a touch, which is what makes
       the lift read as a nudge rather than a fade. */
    transition: transform 0.5s cubic-bezier(0.3, 1.9, 0.4, 1);
  }

  a:hover .thumb {
    transform: scale(1.015);
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The page renders at its own --vw and is scaled to the tile by --s,
     set from the tile's measured width by the script above. It sits over the
     poster fully transparent until it has loaded. */
  .thumb :global(iframe) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .thumb.is-live :global(iframe) {
    opacity: 1;
  }

  .thumb :global(iframe) {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    transform: scale(var(--s, 0.34));
    transform-origin: top left;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb,
    #zoom::-webkit-slider-thumb {
      transition: none;
    }

    a:hover .thumb {
      transform: none;
    }
  }
</style>
