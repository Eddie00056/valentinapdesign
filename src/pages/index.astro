---
import Base from "../layouts/Base.astro";
import { site, pieces } from "../data/site";

/* Gallery zoom, expressed as column COUNT rather than column width. A
   width-based slider wastes steps: two different widths often resolve to
   the same number of columns, and the widest drops to a single column.
   Counts always change what you see. `column-width` still rides along as
   a floor, so narrow viewports quietly use fewer than asked. */
const ZOOM_STEPS = [5, 4, 3, 2];
/* Three columns — the density the reference grid sits at, and enough room
   for a phone screen to still read. */
const ZOOM_DEFAULT = 2;
---

<Base>
  <div class="page" style={`--cols: ${ZOOM_STEPS[ZOOM_DEFAULT]}`}>
    <header>
      <div class="head-left">
        <h1>{site.name}</h1>
        <p class="mono links-row">
          <a class="link-underline" href="/website">Website ↗</a>
          <span class="sep" aria-hidden="true">·</span>
          <a class="link-underline" href="/website/presentation">Presentation ↗</a>
        </p>
      </div>

      <div class="zoom">
        <svg class="zoom-i" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.2"></circle>
          <path d="M10.2 10.2 13.4 13.4"></path>
        </svg>
        <input
          id="zoom"
          type="range"
          min="0"
          max={ZOOM_STEPS.length - 1}
          step="1"
          value={ZOOM_DEFAULT}
          aria-label="Thumbnail size"
        />
        <svg class="zoom-i zoom-i--lg" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.2"></circle>
          <path d="M10.2 10.2 13.4 13.4M7 5.1v3.8M5.1 7h3.8"></path>
        </svg>
      </div>
    </header>

    <ul class="grid">
      {
        pieces.map((p) => (
          <li>
            <a href={p.href} aria-label={p.title}>
              <span class="thumb" style={`aspect-ratio: 1280 / ${p.previewHeight}`}>
                <iframe
                  src={p.href}
                  title={p.title}
                  tabindex="-1"
                  aria-hidden="true"
                  loading="lazy"
                  scrolling="no"
                  style={`height: ${p.previewHeight}px`}
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script data-zoom-steps={JSON.stringify(ZOOM_STEPS)} is:inline define:vars={{ ZOOM_STEPS }}>
  const page = document.querySelector(".page");
  const slider = document.getElementById("zoom");

  slider?.addEventListener("input", () => {
    page.style.setProperty("--cols", String(ZOOM_STEPS[+slider.value]));
  });

  /* Each tile renders its real page at a fixed 1280px and scales it to the
     tile's measured width. Measuring beats computing it from the column
     count: a multi-column layout stretches its columns to fill the
     container, so the rendered width is never a number you can predict. */
  const fit = (el) => {
    const w = el.getBoundingClientRect().width;
    if (w) el.style.setProperty("--s", String(w / 1280));
  };

  const thumbs = [...document.querySelectorAll(".thumb")];
  thumbs.forEach(fit);

  if ("ResizeObserver" in window) {
    const ro = new ResizeObserver((entries) => {
      for (const e of entries) fit(e.target);
    });
    thumbs.forEach((t) => ro.observe(t));
  } else {
    addEventListener("resize", () => thumbs.forEach(fit));
  }
</script>

<style>
  /* Dark gallery, after tcosta.com/wspoc: a black page, near-black cards at
     an 8px radius, and each prototype rendered live inside its own card so
     the page's own background becomes the tile's margin. Nothing is
     cropped to fit and nothing is scaled up to fill — the UI floats. */
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1rem + 4vw, 3rem);
    padding: clamp(1.25rem, 1rem + 2vw, 2rem);
    background: #000;
    color: #f2f2f2;
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .head-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: #f2f2f2;
  }

  header .mono a {
    color: #8a8a8a;
  }

  header .mono a:hover {
    color: #f2f2f2;
  }

  header .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  header .links-row .sep {
    color: #4a4a4a;
  }

  /* ---------- zoom ---------- */

  .zoom {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 11px;
    border-radius: 999px;
    background: #141414;
    border: 1px solid #232323;
  }

  .zoom-i {
    width: 13px;
    height: 13px;
    flex: none;
    fill: none;
    stroke: #8a8a8a;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .zoom-i--lg {
    width: 16px;
    height: 16px;
  }

  #zoom {
    -webkit-appearance: none;
    appearance: none;
    width: 104px;
    height: 3px;
    border-radius: 3px;
    background: #333;
    cursor: pointer;
  }

  #zoom::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #f2f2f2;
    transition: transform 0.18s cubic-bezier(0.3, 1.9, 0.4, 1);
  }

  #zoom:hover::-webkit-slider-thumb,
  #zoom:active::-webkit-slider-thumb {
    transform: scale(1.25);
  }

  #zoom::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: #f2f2f2;
  }

  /* ---------- grid ---------- */

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: var(--cols);
    /* Floor, so a narrow viewport uses fewer columns than asked rather
       than squeezing five unreadable ones in. */
    column-width: 260px;
    column-gap: 20px;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 20px;
  }

  .thumb {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #141414;
    /* Tiago's springy curve — it overshoots a touch, which is what makes
       the lift read as a nudge rather than a fade. */
    transition: transform 0.5s cubic-bezier(0.3, 1.9, 0.4, 1);
  }

  a:hover .thumb {
    transform: scale(1.015);
  }

  /* The page renders at a fixed 1280px and is scaled to the tile by --s,
     set from the tile's measured width by the script above. */
  .thumb iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    border: 0;
    transform: scale(var(--s, 0.34));
    transform-origin: top left;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb,
    #zoom::-webkit-slider-thumb {
      transition: none;
    }

    a:hover .thumb {
      transform: none;
    }
  }
</style>
