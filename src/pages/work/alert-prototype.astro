---
import Bare from "../../layouts/Bare.astro";
import { AlertPrototypePage } from "../../components/glasslab/AlertPrototypePage";
---

<Bare title="Alert creation prototype" bg="#0F0F0F">
  <AlertPrototypePage client:load />

  <style is:global>
    .ap-bar {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: "Open Sans", system-ui, -apple-system, sans-serif;
    }

    .ap-glass {
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      background: rgba(17, 19, 23, 0.72);
      border: 1px solid #1d2328;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .ap-back {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #8e97ad;
      transition: color 0.15s ease;
    }
    .ap-back:hover {
      color: #f2f2f8;
    }
    .ap-back:focus-visible {
      outline: 2px solid #48d597;
      outline-offset: 2px;
    }
    .ap-back svg {
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ap-back:hover svg {
      transform: translateX(-2px);
    }

    .ap-tabs {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
    }
    .ap-tabs button {
      height: 32px;
      padding: 0 15px;
      border: none;
      border-radius: 999px;
      background: transparent;
      color: #8e97ad;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.18s ease, color 0.18s ease;
    }
    .ap-tabs button:hover {
      color: #f2f2f8;
    }
    .ap-tabs button.on {
      background: #262d33;
      color: #f2f2f8;
    }
    .ap-tabs button:focus-visible {
      outline: 2px solid #48d597;
      outline-offset: 2px;
    }

    .ap-frame {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: #0f0f0f;
    }

    .ap-stage {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      overflow: auto;
      padding: 88px 24px 40px;
      background:
        radial-gradient(40% 60% at 24% 18%, rgba(120, 160, 255, 0.20), transparent 70%),
        radial-gradient(46% 66% at 86% 42%, rgba(255, 180, 140, 0.18), transparent 70%),
        radial-gradient(54% 74% at 55% 108%, rgba(150, 230, 190, 0.16), transparent 70%),
        #eef0f4;
    }

    @media (prefers-reduced-motion: reduce) {
      .ap-back svg {
        transition: none;
      }
    }

    @media (max-width: 600px) {
      .ap-bar {
        top: 12px;
        left: 12px;
      }
      .ap-tabs button {
        padding: 0 11px;
        letter-spacing: 0.03em;
      }
    }
  </style>
</Bare>
