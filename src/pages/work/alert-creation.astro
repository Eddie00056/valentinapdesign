---
import Bare from "../../layouts/Bare.astro";
import { AlertCreationScreen } from "../../components/alertscreen/AlertCreationScreen";
---

<Bare title="Alert creation" bg="#0b0b0d">
  <div id="bg-wrap">
    <AlertCreationScreen client:load />
  </div>

  <a class="back" href="/" aria-label="Back to home">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M12.0833 15L7.08325 10L12.0833 5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <!-- .acs-root (the phone's own backdrop) paints an inline dark gradient
       that fully covers the viewport, independent of Bare's own `bg` — so
       the switch has to override THAT, not the page background. -->
  <button
    type="button"
    id="bg-toggle"
    class="bg-toggle"
    aria-label="Switch to light background"
    aria-pressed="false"
  >
    <svg class="i-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M10 1.5v2.2M10 16.3v2.2M18.5 10h-2.2M3.7 10H1.5M15.9 4.1l-1.56 1.56M5.66 14.34 4.1 15.9M15.9 15.9l-1.56-1.56M5.66 5.66 4.1 4.1"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
    <svg class="i-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M17.5 11.7A7.6 7.6 0 0 1 8.3 2.5a7.6 7.6 0 1 0 9.2 9.2Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <script>
    const KEY = "acs-bg-theme";
    const wrap = document.getElementById("bg-wrap")!;
    const toggle = document.getElementById("bg-toggle")!;

    function apply(theme: "light" | "dark") {
      wrap.classList.toggle("theme-light", theme === "light");
      toggle.setAttribute("aria-pressed", String(theme === "light"));
      toggle.setAttribute(
        "aria-label",
        theme === "light" ? "Switch to dark background" : "Switch to light background",
      );
    }

    const saved = localStorage.getItem(KEY);
    apply(saved === "dark" ? "dark" : "light");

    toggle.addEventListener("click", () => {
      const next = wrap.classList.contains("theme-light") ? "dark" : "light";
      apply(next);
      localStorage.setItem(KEY, next);
    });
  </script>

  <style is:global>
    html,
    body {
      overflow-y: auto !important;
    }
  </style>

  <style>
    .back {
      position: fixed;
      top: 24px;
      left: 24px;
      z-index: 30;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: #f2f2f8;
      background: rgba(17, 19, 23, 0.72);
      border: 1px solid #1d2328;
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: color 0.15s ease;
    }
    .back:hover {
      color: #fff;
    }
    .back:focus-visible {
      outline: 2px solid #48d597;
      outline-offset: 2px;
    }
    .back svg {
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .back:hover svg {
      transform: translateX(-2px);
    }
    @media (max-width: 600px) {
      .back {
        top: 12px;
        left: 12px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .back svg {
        transition: none;
      }
    }

    /* .acs-root's own background is an inline style on the React side
       (it fully covers the viewport on top of Bare's `bg`) — !important
       is the only way to override an inline style from a stylesheet. */
    #bg-wrap.theme-light :global(.acs-root) {
      background: #ffffff !important;
      transition: background 0.3s ease;
    }

    .bg-toggle {
      position: fixed;
      top: 24px;
      right: 24px;
      z-index: 30;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      appearance: none;
      cursor: pointer;
      color: #f2f2f8;
      background: rgba(17, 19, 23, 0.72);
      border: 1px solid #1d2328;
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .bg-toggle:hover {
      color: #fff;
    }
    .bg-toggle:focus-visible {
      outline: 2px solid #48d597;
      outline-offset: 2px;
    }
    .bg-toggle .i-moon {
      display: none;
    }
    #bg-wrap.theme-light ~ .bg-toggle {
      color: #232528;
      background: rgba(255, 255, 255, 0.75);
      border-color: rgba(35, 37, 40, 0.15);
    }
    #bg-wrap.theme-light ~ .bg-toggle:hover {
      color: #000;
    }
    #bg-wrap.theme-light ~ .bg-toggle .i-sun {
      display: none;
    }
    #bg-wrap.theme-light ~ .bg-toggle .i-moon {
      display: block;
    }
    @media (max-width: 600px) {
      .bg-toggle {
        top: 12px;
        right: 12px;
      }
    }
  </style>
</Bare>
