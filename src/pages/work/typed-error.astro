---
import Bare from "../../layouts/Bare.astro";
import { TypedError } from "../../components/typederror/TypedError";
---

<Bare title="Typed error" bg="#0b0b0d">
  <div class="te-stage">
    <TypedError client:load />
  </div>

  <style>
    .te-stage {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</Bare>
