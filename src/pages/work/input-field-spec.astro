---
/* The input-field spec for the order tickets (unlinked). Built from the
   real ticket fields — see components/inputspec/InputFieldSpec.tsx. */
import Bare from "../../layouts/Bare.astro";
import { InputFieldSpec } from "../../components/inputspec/InputFieldSpec";
import { TICKET_UI } from "../../components/shared/ticketUi";
---

<Bare title="Input field — spec" bg="#000">
  <InputFieldSpec client:load />
  <!-- the tickets' own theme, so every cell is the final field (2026-11-19) -->
  <Fragment set:html={`<style>${TICKET_UI}</style>`} />

  <style is:global>
    html,
    body {
      overflow-y: auto !important;
      height: auto !important;
    }
  </style>
</Bare>
