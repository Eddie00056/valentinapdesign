---
import Base from "../../layouts/Base.astro";
import {
  WatchlistButton,
  AlertButton,
  TradeButton,
  SearchButton,
  BackButton,
  FractionalButton,
} from "../../components/glasslab/GlassButton";
import {
  BackNavButton,
  WatchlistNavButton,
  AlertNavButton,
} from "../../components/glasslab/nav-buttons";
import "../../components/glasslab/glass-button.css";
import "../../components/glasslab/nav-buttons.css";

const variants = ["light", "green"] as const;
---

<Base title="Buttons lab">
  <main class="wrap dark">
    {/* nav buttons — soft circular, ungrouped, shown in a screen-edge bar */}
    <div class="group">
      <div class="bar">
        <BackNavButton />
        <span class="spacer"></span>
        <WatchlistNavButton />
        <AlertNavButton />
      </div>
    </div>

    {/* web pills */}
    <div class="group">
      {variants.map((v) => (
        <div class="pair">
          <WatchlistButton variant={v} />
          <AlertButton variant={v} />
        </div>
      ))}
    </div>

    {/* trade */}
    <div class="group">
      {variants.map((v) => (
        <div class="pair">
          <TradeButton variant={v} />
        </div>
      ))}
    </div>

    {/* mobile icon-only glass */}
    <div class="group">
      {variants.map((v) => (
        <div class="pair">
          <WatchlistButton variant={v} size="mobile" iconOnly />
          <AlertButton variant={v} size="mobile" iconOnly />
          <SearchButton variant={v} />
          <FractionalButton variant={v} />
          <BackButton variant={v} />
        </div>
      ))}
    </div>

    {/* back, 44 */}
    <div class="group">
      {variants.map((v) => (
        <div class="pair">
          <BackButton variant={v} style={{ width: 44, height: 44 }} />
        </div>
      ))}
    </div>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    padding: 3rem 1.5rem;
    background: #0d0d0d;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .pair {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar {
    width: min(420px, 100%);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .spacer {
    flex: 1;
  }
</style>
