---
/* Staging study for the deck's slide 32 (user, 2026-11-12): option A —
   the proposed ticket as a hero product shot on a slide-sized stage.
   The current / proposed comparison it replaced lives in git. */
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order ticket staging</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="rv">
      <section>
        <h2>Plain · bigger</h2>
        <div class="slide">
          <iframe src="/work/stock-order-entry?bare&proposed&stage=plain" title="Ticket, plain and bigger" data-bracket></iframe>
        </div>
      </section>
      <section>
        <h2>A · In context</h2>
        <div class="slide">
          <iframe src="/work/stock-order-entry?bare&proposed&stage=ctx" title="Ticket in context" data-bracket></iframe>
          <p class="label">Updated widget design</p>
        </div>
      </section>
      <section>
        <h2>B · On a plate</h2>
        <div class="slide">
          <iframe src="/work/stock-order-entry?bare&proposed&stage=plate" title="Ticket on a plate" data-bracket></iframe>
          <p class="label">Updated widget design</p>
        </div>
      </section>
      <section>
        <h2>Earlier · lifted with a shadow</h2>
        <div class="slide">
          <iframe src="/work/stock-order-entry?bare&proposed&stage" title="Ticket lifted" data-bracket></iframe>
          <p class="label">Updated widget design</p>
        </div>
      </section>
    </main>
    <script is:inline>
      /* open the bracket — the richer state */
      document.querySelectorAll("iframe[data-bracket]").forEach((f) =>
        f.addEventListener("load", () => {
          const tryOpen = (n) => {
            const d = f.contentDocument;
            if (!d || d.querySelector('[aria-label="Remove bracket order"]')) return;
            const b = [...d.querySelectorAll("button")].find((x) => x.textContent && x.textContent.includes("Bracket order"));
            if (b) b.click();
            if (n > 0) setTimeout(() => tryOpen(n - 1), 300);
          };
          tryOpen(20);
        }),
      );
    </script>
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; background: #050505; color: #f3f1ec; font-family: Inter, -apple-system, sans-serif; }
      .rv { margin: 0 auto; padding: 40px 0 80px; display: flex; flex-direction: column; gap: 48px; }
      h2 { margin: 0 0 12px; font-size: 15px; font-weight: 600; color: #a6a6a6; }
      .rv { width: min(1440px, 100vw - 32px); }
      .slide { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #080909; }
      iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      .label {
        position: absolute; left: 3.2%; top: 5.4%; margin: 0;
        font: 400 clamp(10px, 0.95vw, 14px) / 1 "DM Mono", ui-monospace, monospace;
        letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55);
        pointer-events: none;
      }
    </style>
  </body>
</html>
