---
import Base from "../../layouts/Base.astro";
import {
  WatchlistButton,
  AlertButton,
} from "../../components/glasslab/GlassButton";
import "../../components/glasslab/glass-button.css";

const variants = ["light", "green"] as const;
---

<Base title="Glass buttons" description="Watchlist and alert glass buttons — light and green variants on a dark surface.">
  <main class="wrap dark">
    <header>
      <p class="eyebrow">Component · work in progress</p>
      <h1>Glass buttons</h1>
      <p class="note">
        Watchlist and alert buttons — light and green variants, on a dark
        surface. Resting state only; hover / press are the CSS defaults (a 1px
        lift).
      </p>
    </header>

    <section class="panel">
      <div class="grid">
        {variants.map((v) => (
          <div class="cell">
            <p class="v-name">{v}</p>
            <div class="pair">
              <WatchlistButton variant={v} />
              <AlertButton variant={v} />
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1100px;
    margin-inline: auto;
    padding: clamp(2rem, 1.4rem + 3vw, 4rem) clamp(1.15rem, 0.7rem + 2vw, 2.5rem)
      6rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    font-family: var(--font-body);
    color: var(--ink);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.4rem + 2vw, 2.6rem);
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .note {
    margin: 0;
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .panel {
    border-radius: 16px;
    padding: clamp(2rem, 1.4rem + 4vw, 3.5rem);
    border: 1px solid #262626;
    position: relative;
    overflow: hidden;
    /* backdrop so the glass blur has something to work on */
    background:
      radial-gradient(38% 55% at 20% 15%, rgba(90, 130, 255, 0.30), transparent 70%),
      radial-gradient(44% 60% at 88% 35%, rgba(255, 110, 90, 0.24), transparent 70%),
      radial-gradient(52% 72% at 55% 105%, rgba(70, 200, 140, 0.22), transparent 70%),
      #0d0d0d;
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2.25rem 1.5rem;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .v-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
