---
import Base from "../../layouts/Base.astro";
import {
  WatchlistButton,
  AlertButton,
} from "../../components/glasslab/GlassButton";
import "../../components/glasslab/glass-button.css";

const variants = ["light", "green"] as const;
---

<Base title="Glass buttons" description="Watchlist and alert glass buttons — web and iOS mobile sizing, light and green variants on a dark surface.">
  <main class="wrap dark">
    <header>
      <p class="eyebrow">Component · work in progress</p>
      <h1>Glass buttons</h1>
      <p class="note">
        Watchlist and alert buttons — light and green variants, on a dark
        surface. Resting state; hover / press are the CSS defaults.
      </p>
    </header>

    <section>
      <p class="sec-label">Web · 160 × 48</p>
      <div class="panel">
        <div class="grid">
          {variants.map((v) => (
            <div class="cell">
              <p class="v-name">{v}</p>
              <div class="pair">
                <WatchlistButton variant={v} />
                <AlertButton variant={v} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section>
      <p class="sec-label">Mobile · iOS · icon only</p>
      <p class="rule">
        Circular, 24 × 24 px visible, with an invisible 44 pt hit area
        (Apple's minimum touch target), 14 px glyph, 12 px apart. Each
        carries an aria-label ("Add to watchlist", "Set alert"). No hover
        lift on touch; a 3% scale-down on press.
      </p>

      <div class="phones">
        {variants.map((v) => (
          <div class="phone">
            <span class="phone-tag">{v}</span>
            <div class="screen">
              <div class="toolbar">
                <WatchlistButton variant={v} size="mobile" iconOnly />
                <AlertButton variant={v} size="mobile" iconOnly />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1100px;
    margin-inline: auto;
    padding: clamp(2rem, 1.4rem + 3vw, 4rem) clamp(1.15rem, 0.7rem + 2vw, 2.5rem)
      6rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    font-family: var(--font-body);
    color: var(--ink);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.4rem + 2vw, 2.6rem);
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .note {
    margin: 0;
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sec-label,
  .v-name,
  .phone-tag,
  .ctx {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .sec-label {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .rule {
    margin: -0.25rem 0 0.5rem;
    max-width: 62ch;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* dark backdrop so the glass blur reads */
  .panel,
  .screen {
    background:
      radial-gradient(38% 55% at 20% 15%, rgba(90, 130, 255, 0.30), transparent 70%),
      radial-gradient(44% 60% at 88% 35%, rgba(255, 110, 90, 0.24), transparent 70%),
      radial-gradient(52% 72% at 55% 105%, rgba(70, 200, 140, 0.22), transparent 70%),
      #0d0d0d;
  }

  .panel {
    border-radius: 16px;
    padding: clamp(1.75rem, 1.2rem + 3vw, 3rem);
    border: 1px solid #262626;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2.25rem 1.5rem;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .v-name {
    margin: 0;
    font-size: 0.7rem;
    color: #8a8a8a;
  }

  .pair {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* mobile mock */
  .phones {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .phone {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .phone-tag {
    font-size: 0.7rem;
    color: #8a8a8a;
  }

  .screen {
    display: inline-block;
    border-radius: 24px;
    border: 1px solid #262626;
    padding: 20px;
  }

  .toolbar {
    display: flex;
    gap: 12px; /* 12pt between icon targets */
  }
</style>
