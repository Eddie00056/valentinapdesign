---
/* LOCAL PROTOTYPE — not linked, not shipped. Live 1D charts, framed like
   the reference (SPY). v1 line, v2 candlesticks. */
import Bare from "../../layouts/Bare.astro";
import { LiveLineChart } from "../../components/labs/LiveLineChart";
import { LiveCandleChart } from "../../components/labs/LiveCandleChart";

const tfs = ["1D", "1W", "1M", "3M", "YTD", "1Y"];

const versions = [{ tag: "v1 — line" }, { tag: "v2 — candlesticks" }];
---

<Bare title="Chart lab" bg="#f4f4f4">
  <main class="stage">
    {versions.map(({ tag }) => (
      <div class="card">
        <p class="vtag">{tag}</p>
        <p class="ticker">SPY</p>
        <h1>SPDR S&amp;P 500 ETF Trust</h1>
        <p class="price">$772.77</p>
        <p class="chg">▲ $8.00 (1.05%) <span>Today</span></p>

        <div class="chart">
          {tag.startsWith("v1") ? (
            <LiveLineChart client:load />
          ) : (
            <LiveCandleChart client:load />
          )}
        </div>

        <div class="rail" role="tablist">
          {tfs.map((t, i) => (
            <button role="tab" aria-selected={i === 0} class={i === 0 ? "on" : ""}>
              {t}
            </button>
          ))}
        </div>
      </div>
    ))}
  </main>
</Bare>

<style>
  .stage {
    min-height: 100dvh;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 1rem;
    font-family:
      -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui,
      sans-serif;
  }
  .card {
    width: 390px;
    max-width: 100%;
    background: #fff;
    border-radius: 22px;
    padding: 22px 20px 14px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.25);
  }
  .vtag {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a1a1aa;
  }
  .ticker {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: #6b7280;
    letter-spacing: 0.02em;
  }
  h1 {
    margin: 2px 0 6px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    color: #111;
  }
  .price {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: #111;
    font-variant-numeric: tabular-nums;
  }
  .chg {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #00a804;
  }
  .chg span {
    color: #6b7280;
    font-weight: 500;
  }
  .chart {
    margin: 18px 0 8px;
  }
  .rail {
    display: flex;
    gap: 4px;
  }
  .rail button {
    flex: none;
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #8a9099;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .rail button.on {
    background: rgba(0, 200, 5, 0.14);
    color: #00a804;
  }
</style>
