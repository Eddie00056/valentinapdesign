---
import Bare from "../../layouts/Bare.astro";
import { OptionsBuilder } from "../../components/optionsbuilder/OptionsBuilder";
---

<Bare title="Options strategy builder" bg="#0b0b0d">
  <OptionsBuilder client:load />

  <a class="ob-back" href="/prototypes" aria-label="Back to the prototypes">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M12.0833 15L7.08325 10L12.0833 5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <style is:global>
    html,
    body {
      overflow-y: auto !important;
    }
    /* ?bare — a version without the card: the widget's rows sit straight
       on the page ground. The shell keeps its stroke — the 1px #353d3f66
       edge from the strategy-builder Figma (elevation-2 at 40%) — so the
       widget still reads against the ground; its fill, shadow and the
       panels behind the content go. Review flag. */
    html.is-bare .ob-stage {
      --chip: #1c1e21; /* the input boxes, off the user's swatch */
      /* the divider inside a field (unit switcher | value, $ | price): --sunk
         is #171f20, invisible on the new chip — white at 10% */
      --sunk: rgba(255, 255, 255, 0.1);
    }
    /* the symbol pill in the same colour as the input boxes */
    html.is-bare .tpill {
      background: #1c1e21 !important;
    }
    /* the bar's top corners: 11 was cut for the card's 1px border (12 − 1);
       against the bare 0.5px stroke it left a half-pixel notch in each
       corner, plain once a slide zooms the frame (user, 2026-09-16) */
    html.is-bare .wshell-bar {
      border-radius: 11.5px 11.5px 0 0 !important;
    }
    html.is-bare .wshell {
      background: transparent !important;
      box-shadow: none !important;
      border: 0.5px solid rgba(255, 255, 255, 0.28) !important; /* 16% read too faint on the slides */
    }
    html.is-bare .ob-card,
    html.is-bare .ob-legs-panel,
    html.is-bare .ob-params-panel {
      background: transparent !important;
      border-color: transparent !important;
      box-shadow: none !important;
    }
    /* the payoff strip: no fill, a 1px stroke in its own divider colour */
    html.is-bare .ob-payoff {
      background: transparent !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      /* inset by the fields panel's 6px side padding, so the strip's edges
         land on the labels' left and the inputs' right */
      margin-inline: 6px;
    }
  </style>
  <script is:inline>
    if (new URLSearchParams(location.search).has("bare")) document.documentElement.classList.add("is-bare");
  </script>
</Bare>
