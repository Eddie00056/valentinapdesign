---
import Website from "../layouts/Website.astro";
import { caseStudies } from "../data/site";
import { Reveal } from "../components/website/Reveal";

const bySlug = Object.fromEntries(caseStudies.map((c) => [c.slug, c]));
const qp = bySlug["questrade-pro"];
const fs = bySlug["fractional-shares"];
const em = bySlug["edgemobile"];

const quotes = [
  {
    text: "A systems thinker, strong collaborator; and the person who was instrumental to our active traders business.",
    name: "Marina Priejzev",
    role: "Managing Engineering Director @ Questrade",
  },
  {
    text: "The person you call when you need to get things done. Thoughtful, strategic, and a great collaborator.",
    name: "Eduardo Pastrana",
    role: "Staff Product Manager @ Wealthsimple",
  },
  {
    text: "An exceptional designer with a growth mindset and proven impact in leading active trader products.",
    name: "Kyle Maskewich",
    role: "Content Designer @ Microsoft",
  },
  {
    text: "An amazing leader, combining creativity and clarity to cut through complexity and deliver impact.",
    name: "Carleen Thio",
    role: "Product Designer @ Questrade",
  },
];
---

<Website
  title="Product Designer"
  description="Valentina Padure — Product Designer with 5+ years shaping fintech products."
>
  <header class="nav">
    <div class="w-wrap nav-inner">
      <a class="id" href="/website">
        <img src="/website/portrait.png" alt="Valentina Padure" width="48" height="48" />
        <span class="id-text">
          <span class="id-name">VALENTINA PADURE</span>
          <span class="id-mail">valeapad@gmail.com</span>
        </span>
      </a>
      <nav class="links">
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <noscript>
    <style>
      [style*="opacity:0"],
      [style*="opacity: 0"] {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <main>
    <Reveal client:load>
      <section class="w-wrap bay hero">
        <p class="statement">
          Product Designer with 5+ years experience shaping fintech products
          while focusing on fostering collaboration, pushing limits, and
          delivering high-impact work.
        </p>
      </section>
    </Reveal>

    <Reveal client:load amount={0.6}>
      <section class="w-wrap bay creed">
        <p class="statement">I get <s>shit</s> work done</p>
      </section>
    </Reveal>

    <section id="projects" class="w-wrap projects">
      <!-- Questrade Pro -->
      <Reveal client:load amount={0.25}>
        <article class="project">
          <div class="project-copy">
            <p class="kicker">{qp.title}</p>
            <h2 class="project-title">{qp.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--single">
            <video
              src="/website/video/questrade.mp4"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"></video>
          </div>
        </article>
      </Reveal>

      <!-- Fractional Shares -->
      <Reveal client:load amount={0.25}>
        <article class="project">
          <div class="project-copy">
            <p class="kicker">{fs.title}</p>
            <h2 class="project-title">{fs.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--frac">
            <div class="frac-phone">
              <video src="/website/video/fractional-phone.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="frac-a">
              <video src="/website/video/fractional-limit.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="frac-b">
              <video src="/website/video/fractional-icon.mp4" autoplay loop muted playsinline></video>
            </div>
          </div>
        </article>
      </Reveal>

      <!-- EdgeMobile -->
      <Reveal client:load amount={0.25}>
        <article class="project">
          <div class="project-copy">
            <p class="kicker">{em.title}</p>
            <h2 class="project-title">{em.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--edge">
            <div class="edge-chart">
              <video src="/website/video/edge-chart.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="edge-bell">
              <video src="/website/video/edge-bell.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="edge-hood">
              <video src="/website/video/edge-hood.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="edge-order">
              <video src="/website/video/edge-order.mp4" autoplay loop muted playsinline></video>
            </div>
          </div>
        </article>
      </Reveal>
    </section>

    <Reveal client:load amount={0.3}>
      <section id="team" class="w-wrap bay">
        <h2 class="statement">I'm a great team asset</h2>
        <ul class="quotes">
          {
            quotes.map((q) => (
              <li class="quote">
                <p class="quote-text">“{q.text}”</p>
                <p class="quote-by">
                  <span class="quote-name">{q.name}</span>
                  <span class="quote-role">{q.role}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </Reveal>

    <Reveal client:load amount={0.5}>
      <section id="contact" class="w-wrap bay contact">
        <h2 class="statement">Currently looking for new roles</h2>
        <p class="contact-line">
          <a href="mailto:valeapad@gmail.com">valeapad@gmail.com</a>
          <span class="dot">•</span>
          <a href="tel:+19292716949">929-271-6949</a>
          <span class="dot">•</span>
          <a
            class="u"
            href="https://www.linkedin.com/in/valentinapadure"
            target="_blank"
            rel="noopener">Linkedin</a
          >
        </p>
      </section>
    </Reveal>
  </main>

  <script>
    // Respect reduced-motion: freeze the project loops on the first frame.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>
</Website>

<style>
  /* ---- header ------------------------------------------------------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--w-bg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.875rem;
  }

  .id {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .id img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .id-text {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    line-height: 1;
  }

  .id-name {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.005em;
  }

  .id-mail {
    font-size: 0.875rem;
    color: var(--w-ink-soft);
  }

  .links {
    display: flex;
    gap: 1.75rem;
  }

  .links a {
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    color: var(--w-ink-mute);
    transition: color 0.18s ease;
  }

  .links a:hover {
    color: var(--w-ink);
  }

  /* ---- rhythm ----------------------------------------------------- */
  section[id] {
    scroll-margin-top: 5rem;
  }

  /* scroll-snap targets — glide, then lock each section to the view.
     Each is a screenful so one snap == one "page". */
  .hero,
  .creed,
  .project,
  #team,
  #contact {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-height: 100svh;
  }

  .hero,
  .creed,
  #team,
  #contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* .project keeps its own two-column grid; just centre it vertically */
  .project {
    align-content: center;
  }

  .bay {
    padding-block: clamp(3.5rem, 4rem + 6vw, 8.5rem);
  }

  .hero {
    padding-top: clamp(4rem, 3rem + 8vw, 9rem);
    padding-bottom: clamp(4rem, 3rem + 8vw, 9rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .creed,
    .project,
    #team,
    #contact {
      scroll-snap-align: none;
      scroll-snap-stop: normal;
      min-height: 0;
    }
  }

  .creed {
    padding-top: 0;
    padding-bottom: clamp(2.5rem, 2rem + 4vw, 5rem);
  }

  /* ---- big statements ------------------------------------------- */
  .statement {
    margin: 0;
    max-width: none;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .hero .statement {
    max-width: 25ch;
    text-wrap: pretty;
  }

  @media (min-width: 700px) {
    .hero .statement {
      max-width: 46ch;
    }
  }

  .creed s {
    text-decoration-thickness: 2px;
    text-decoration-color: currentColor;
  }

  /* ---- projects ------------------------------------------------- */
  .projects {
    display: flex;
    flex-direction: column;
  }

  @media (prefers-reduced-motion: reduce) {
    .projects {
      gap: clamp(4rem, 3rem + 8vw, 9rem);
      padding-block: clamp(2rem, 1rem + 4vw, 5rem);
    }
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.5rem, 1rem + 6vw, 7rem);
    align-items: center;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .project-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.125rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .see {
    font-family: var(--w-font-alt);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--w-ink);
  }

  /* media wrappers */
  .media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media--single video {
    aspect-ratio: 798 / 573;
    border-radius: 8px;
  }

  /* Fractional: tall phone card + two stacked cards, all on white */
  .media--frac {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
  }

  .media--frac > div {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .frac-phone {
    grid-row: 1 / 3;
    aspect-ratio: 394 / 440;
  }

  .frac-phone video {
    width: 82%;
    height: 82%;
    object-fit: contain;
  }

  .frac-a video,
  .frac-b video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
  }

  /* EdgeMobile: 2×2 grid of dark rounded cards */
  .media--edge {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-auto-rows: 1fr;
    gap: 12px;
  }

  .media--edge > div {
    background: #0b0b0b;
    border: 1px solid var(--w-line);
    border-radius: 24px;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-height: 168px;
  }

  .edge-chart video {
    width: 82%;
    height: auto;
  }

  .edge-bell video {
    width: 34%;
    height: auto;
  }

  .edge-hood video {
    width: 62%;
    height: auto;
  }

  .edge-order video {
    width: 78%;
    height: auto;
  }

  /* ---- testimonials ------------------------------------------- */
  #team .statement {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--w-surface);
    border-radius: 20px;
    padding: 20px;
  }

  .quote-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .quote-by {
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote-name {
    font-size: 0.75rem;
  }

  .quote-role {
    font-size: 0.75rem;
    color: var(--w-ink-soft);
  }

  /* ---- contact ---------------------------------------------------- */
  .contact-line {
    margin: clamp(1.25rem, 1rem + 1.5vw, 2rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--w-ink-soft);
  }

  .contact-line a {
    color: var(--w-ink-soft);
    transition: color 0.18s ease;
  }

  .contact-line a:hover {
    color: var(--w-ink);
  }

  .contact-line .u {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-line .dot {
    color: var(--w-ink-faint);
  }

  /* ---- responsive ---------------------------------------------- */
  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .project-copy {
      order: 2;
    }

    .quotes {
      grid-template-columns: 1fr;
    }

    .id-name {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 480px) {
    .links {
      gap: 1.1rem;
    }
  }
</style>
