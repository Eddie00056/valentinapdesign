---
import Base from "../layouts/Base.astro";
import { websitePages } from "../data/site";

const statusLabel = {
  todo: "To do",
  wip: "In progress",
  live: "Live",
} as const;
---

<Base title="Website">
  <div class="page">
    <header>
      <p class="mono"><a class="link-underline" href="/">← Valentina P.</a></p>
      <h1>Website</h1>
      <p class="lede">
        Porting the <a
          class="link-underline"
          href="https://valentinapadure.framer.website/"
          target="_blank"
          rel="noopener">Framer site</a
        > over, one page at a time.
      </p>
    </header>

    <table>
      <thead>
        <tr>
          <th scope="col">Page</th>
          <th scope="col">What it is</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          websitePages.map((p) => (
            <tr class={p.status === "live" ? "is-live" : "is-pending"}>
              <td class="name">
                {p.href ? (
                  <a class="link-underline" href={p.href}>
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
              </td>
              <td class="blurb">{p.blurb}</td>
              <td class="status">
                <span class={`tag tag--${p.status}`}>{statusLabel[p.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 5vw, 4rem);
    padding: clamp(1.5rem, 1rem + 4vw, 4rem);
    max-width: 820px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  header .mono a {
    color: var(--ink-faint);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .lede {
    color: var(--ink-soft);
    max-width: 46ch;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th {
    font-weight: 500;
    text-align: left;
    color: var(--ink-faint);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 1rem 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  th:last-child {
    padding-right: 0;
  }

  td {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  td:last-child {
    padding-right: 0;
  }

  .name {
    font-weight: 500;
    white-space: nowrap;
  }

  tr.is-pending .name {
    color: var(--ink-soft);
  }

  .blurb {
    color: var(--ink-soft);
    width: 100%;
  }

  .status {
    text-align: right;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-faint);
  }

  .tag--wip {
    color: var(--ink-soft);
  }

  .tag--live {
    color: var(--ink);
  }

  .tag--live::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4em;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 0.1em;
  }

  @media (max-width: 560px) {
    table,
    thead,
    tbody,
    tr,
    td,
    th {
      display: block;
    }

    thead {
      display: none;
    }

    tr {
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
    }

    td {
      padding: 0;
      border: 0;
    }

    .name {
      white-space: normal;
    }

    .blurb {
      margin-top: 0.25rem;
    }

    .status {
      text-align: left;
      margin-top: 0.5rem;
    }
  }
</style>
