---
import Website from "../layouts/Website.astro";
import { caseStudies } from "../data/site";
import { HoldingsLoop } from "../components/website/HoldingsLoop";
import { DotField } from "../components/website/DotField";
import { FracBanner, FracPill } from "../components/website/FracBanner";
import { ChainLoop } from "../components/website/ChainLoop";
import { FracFlowPhone } from "../components/website/FracFlowPhone";
import SiteHeader from "../components/website/SiteHeader.astro";
import ContactFooter from "../components/website/ContactFooter.astro";

const bySlug = Object.fromEntries(caseStudies.map((c) => [c.slug, c]));
const qp = bySlug["questrade-pro"];
const fs = bySlug["fractional-shares"];
const em = bySlug["edgemobile"];

// the hero line, split so each word can be revealed in turn on load
const heroLine =
  "Product Designer with 5+ years experience shaping fintech products while focusing on fostering collaboration, pushing limits, and delivering high-impact work.";
const heroWords = heroLine.split(" ");

/* the references (#team) are hidden for now; flip to bring them back */
const showReferences = false;

const quotes = [
  {
    text: "A systems thinker, strong collaborator; and the person who was instrumental to our active traders business.",
    name: "Marina Priejzev",
    role: "Managing Engineering Director @ Questrade",
  },
  {
    text: "The person you call when you need to get things done. Thoughtful, strategic, and a great collaborator.",
    name: "Eduardo Pastrana",
    role: "Staff Product Manager @ Wealthsimple",
  },
  {
    text: "An exceptional designer with a growth mindset and proven impact in leading active trader products.",
    name: "Kyle Maskewich",
    role: "Content Designer @ Microsoft",
  },
  {
    text: "An amazing leader, combining creativity and clarity to cut through complexity and deliver impact.",
    name: "Carleen Thio",
    role: "Product Designer @ Questrade",
  },
];
---

<Website
  title="Product Designer"
  description="Valentina Padure — Product Designer with 5+ years shaping fintech products."
>
  <SiteHeader />

  <noscript>
    <style>
      [style*="opacity:0"],
      [style*="opacity: 0"] {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <main>
    <div class="hero-screen">
      <!-- the GlobalShell canvas, live: its ground, and its dot grid
           reacting to the cursor -->
      <div class="hero-field" aria-hidden="true">
        <DotField
          client:idle
          dotColor={[40, 47, 49]}
          lineOpacity={0.12}
          falloff={{ cx: 0.45, cy: 0.42, rx: 0.62, ry: 0.62, inner: 0.35 }}
        />
      </div>
      <section class="w-wrap bay hero">
        <p class="statement hero-statement">
          {heroWords.map((w, i) => (
            <><span class="hw" style="opacity:0">{w}</span>{i < heroWords.length - 1 && " "}</>
          ))}
        </p>
      </section>
    </div>

    <section id="projects" class="w-wrap projects">
      <!-- Fractional Shares -->
      <a class="project" data-reveal href={`/website/${fs.slug}`}>
        <div class="project-copy">
          <div class="project-titles">
            <p class="kicker" data-r>{fs.title}</p>
            <h2 class="project-title" data-r>{fs.summary}</h2>
          </div>
          <span class="see" data-r>See project →</span>
        </div>
        <div class="media media--frac" data-r>
          <div class="frac-phone">
            <FracFlowPhone client:visible />
          </div>
          <div class="frac-a">
            <FracPill client:visible />
          </div>
          <div class="frac-b">
            <FracBanner client:visible />
          </div>
        </div>
      </a>

      <!-- EdgeMobile -->
      <a class="project" data-reveal href={`/website/${em.slug}`}>
        <div class="project-copy">
          <div class="project-titles">
            <p class="kicker" data-r>{em.title}</p>
            <h2 class="project-title" data-r>{em.summary}</h2>
          </div>
          <span class="see" data-r>See project →</span>
        </div>
        <div class="media media--edge" data-r>
          <div class="col">
            <div class="fit-fill">
              <HoldingsLoop client:visible />
            </div>
            <div class="fit-price">
              <div class="hood-crop">
                <video src="/website/video/edge-hood.mp4" autoplay loop muted playsinline></video>
              </div>
            </div>
          </div>
          <div class="col">
            <div class="fit-bell">
              <video src="/website/video/edge-bell.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="fit-wide">
              <video src="/website/video/edge-order.mp4" autoplay loop muted playsinline></video>
            </div>
          </div>
        </div>
      </a>

      <!-- Questrade Pro -->
      <a class="project" data-reveal href={`/website/${qp.slug}`}>
        <div class="project-copy">
          <div class="project-titles">
            <p class="kicker" data-r>{qp.title}</p>
            <h2 class="project-title" data-r>{qp.summary}</h2>
          </div>
          <span class="see" data-r>See project →</span>
        </div>
        <div class="media media--single" data-r>
          <ChainLoop client:visible />
        </div>
      </a>
    </section>

    {
      showReferences && (
        <section id="team" class="w-wrap bay" data-reveal>
          <h2 class="statement" data-r>I'm a great team asset</h2>
          <ul class="quotes">
            {
              quotes.map((q) => (
                <li class="quote" data-r>
                  <p class="quote-text">“{q.text}”</p>
                  <p class="quote-by">
                    <span class="quote-name">{q.name}</span>
                    <span class="quote-role">{q.role}</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    <ContactFooter />
  </main>

  <script>
    import { initReveal } from "../components/website/reveal";
    initReveal();
  </script>

  <script>
    /* Hero text reveal — on load, each word fades up out of a soft blur in
       turn. The words ship with inline opacity:0 so there's no flash of the
       finished line first; <noscript> and reduced motion show it outright. */
    import { animate, stagger } from "motion";

    const words = document.querySelectorAll<HTMLElement>(".hero-statement .hw");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      words.forEach((w) => (w.style.opacity = ""));
    } else {
      animate(
        words,
        {
          opacity: [0, 1],
          filter: ["blur(10px)", "blur(0px)"],
          transform: ["translateY(0.28em)", "translateY(0)"],
        },
        {
          duration: 0.9,
          ease: [0.22, 1, 0.36, 1],
          delay: stagger(0.045, { startDelay: 0.2 }),
        },
      );
    }
  </script>

  <script>
    // Respect reduced-motion: freeze the project loops on the first frame.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>

</Website>

<style>
  /* ---- rhythm ----------------------------------------------------- */
  section[id] {
    scroll-margin-top: 5rem;
  }

  /* the hero fills the first screen under the header, line centred */
  .hero-screen {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh / var(--zoom) - 76px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* the shell's ground (#070f11, lighter toward the edges) under the dot
     field, both fading into the page at the top and bottom */
  /* the dots dissolve on their own (DotField's falloff); behind them only
     the faintest breath of the shell's tint, gone well before any edge */
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 55% 50% at 45% 42%,
      rgba(10, 20, 23, 0.55) 0%,
      rgba(10, 20, 23, 0.25) 45%,
      rgba(10, 20, 23, 0.08) 75%,
      transparent 100%
    );
  }

  /* one padding between every divider and its section: the project rows
     take #team's instead of filling the screen */
  .project,
  #team {
    padding-block: clamp(2.5rem, 1.75rem + 2.4cqw, 4rem);
  }

  #team {
    border-top: 1px solid var(--w-rule);
  }

  .bay {
    padding-block: clamp(3.5rem, 4rem + 6cqw, 8.5rem);
  }

  /* more room below than above, so the line sits a little above the
     screen's middle */
  .hero {
    padding-top: clamp(2rem, 1rem + 5cqw, 5rem);
    padding-bottom: clamp(6rem, 5rem + 11cqw, 13rem);
  }


  /* ---- big statements ------------------------------------------- */
  .statement {
    margin: 0;
    max-width: none;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.1rem + 2.6cqw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .hero .statement {
    max-width: 25ch;
    text-wrap: pretty;
    /* a step under the section headings: 32px (40px on screen at the
       desktop zoom), down from the shared 40px */
    font-size: clamp(1.5rem, 1rem + 2cqw, 2rem);
  }

  /* inline-block so each word can rise on its own; the spaces between the
     spans are real text, so the line still wraps word by word */
  .hw {
    display: inline-block;
    will-change: opacity, filter, transform;
  }

  @media (min-width: 700px) {
    .hero .statement {
      /* three lines, "limits," starting the last: anything from ~840 to
         ~920px breaks there; 55rem sits in the middle of that range */
      max-width: 55rem;
    }
  }

  /* ---- projects ------------------------------------------------- */
  .projects {
    display: flex;
    flex-direction: column;
  }


  /* a hairline over each project row (so between the hero and the first,
     and between every row), as wide as the one above #team (the full
     w-wrap, gutters included): drawn overlong and clipped by .projects, so
     it holds whether the row is two columns or stacked */
  .projects {
    overflow-x: clip;
  }

  .project {
    position: relative;
  }

  .project::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100vw;
    right: -100vw;
    height: 1px;
    background: var(--w-rule);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.5rem, 1rem + 6cqw, 7rem);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Framer: kicker + title 8px apart, then 24px to "See project" */
    gap: 24px;
    /* sit on the media's bottom edge rather than its middle */
    align-self: end;
  }

  .project-titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kicker {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .project-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.125rem, 1rem + 0.9cqw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .see {
    font-family: var(--w-font-alt);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--w-ink);
    transition: color 0.18s ease;
  }

  /* white at rest, grey only under the pointer — not whenever the row is */
  .see:hover {
    color: var(--w-ink-soft);
  }

  /* media wrappers */
  .media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Questrade Pro: the live chain-to-order loop (ChainLoop.tsx) in the
     old video's frame */
  .media--single {
    /* matches GROUND in ChainLoop.tsx; the loop sets the card's shape */
    background: #0f0f0f;
    overflow: hidden;
  }

  :global(.chain-loop) {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: inherit;
  }

  /* Fractional: tall phone card + two stacked cards, all on white */
  .media--frac {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
  }

  .media--frac > div {
    background: #f2f2f2;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 2cqw, 1.25rem);
  }

  .frac-phone {
    grid-row: 1 / 3;
    aspect-ratio: 394 / 440;
  }

  /* the live order flow's phone, cut off by the card's bottom edge
     (FracFlowPhone sizes it) */
  .media--frac > .frac-phone {
    position: relative;
    padding: 0;
  }

  :global(.frac-flow-fit) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* the flow's own page stage: a full-viewport photo ground — here the
     card's white shows through instead */
  :global(.frac-flow-fit .fof-stage) {
    min-height: 0;
    padding: 0;
    background: none !important;
    display: block;
  }

  /* the live pill and banner: FracBanner.tsx scales each with its card,
     the pill's type matched 1:1 to the banner's */
  .media--frac > .frac-a,
  .media--frac > .frac-b {
    position: relative;
    padding: 0;
  }

  :global(.frac-fit) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-family: "DM Sans", system-ui, sans-serif;
  }

  /* EdgeMobile: two independent column stacks (like the case-study
     bento) so each card sizes to its own clip — no row-height
     stretching that balloons the small cards */
  .media--edge {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    /* stretch both columns to the taller one's height so the last card in
       each can grow to a shared bottom edge (see :last-child rule below) */
    align-items: stretch;
    gap: 12px;
  }

  .media--edge .col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .media--edge .col > * {
    width: 100%;
  }

  /* the shorter column's last card takes up the slack so its bottom edge
     lines up with the taller column's — the centred clip inside just
     floats in the extra dark space (Framer's method, above) */
  .media--edge .col > div:last-child {
    flex: 1;
    min-height: 0;
  }

  /* drop the height cap on the grown card's clip so its size stays
     width-driven and the extra card height reads as dark space, not a
     zoomed-in clip */
  .media--edge .col > div:last-child > video {
    max-height: none;
  }

  /* Framer's method: each card is a short/wide near-black box; the clip
     sits CENTRED at its own size with object-fit:contain and generous
     dark padding around it — never stretched to fill. The clips carry
     baked-in #0c0c0c margin, so contain + matching card bg reads as one
     continuous dark surface with the UI floating in it. No cropping. */
  .media--edge .col > div {
    position: relative;
    /* the middle of the clips' own grounds (#0e–#10) */
    background: #0f0f0f;
    border-radius: 20px;
    overflow: hidden;
  }

  /* card rim — reuse of the prototype's fractional-icon border
     (.acs-frac-card::before): a 1px gradient hairline via the padding-box
     mask trick, so the near-black media cards read as framed instead of
     dissolving into the page. */
  .media--single {
    position: relative;
    border-radius: 8px;
  }

  .media--single::after,
  .media--edge .col > div::after,
  .quote::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: rgba(255, 255, 255, 0.08);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* clip is absolutely positioned + centred so it can NEVER stretch the
     card — the card's aspect-ratio alone sets its size. The clip floats
     at its natural size, capped well below the card edges, so it reads
     as content-in-a-frame, not a zoomed-in fill. */
  .media--edge .col > div > video {
    /* the clips' grounds render a shade darker than the card (#0b–#0e on
       #0f): lighten lets the card through them, so no box shows, and
       leaves the UI (all lighter than the card) untouched */
    mix-blend-mode: lighten;
  }

  .media--edge .col > div > video {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: 86%;
    max-height: 82%;
    object-fit: contain;
  }

  /* order ticket — room for all three rows (content ≈ 2.5:1) */
  .media--edge .fit-wide {
    aspect-ratio: 19 / 10;
  }
  /* single price ticker — wide, short; its baked-in text runs large so
     hold the clip well down */
  .media--edge .fit-price {
    aspect-ratio: 26 / 10;
  }
  /* the ticker without its logo: the clip (3840 wide) has the icon in
     x 190–525 and the text in 673–3571, so a window over x 600–3644 —
     centred on the text — cuts the icon. 29% of the card: a quarter under
     its old size, in scale with the bell and the ticket */
  .media--edge .fit-price .hood-crop {
    /* the crop is its own layer (transform), so it blends as a whole */
    mix-blend-mode: lighten;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 29%;
    aspect-ratio: 3044 / 1296;
    transform: translate(-50%, -50%);
    overflow: hidden;
  }

  .media--edge .fit-price .hood-crop video {
    width: 126.15%;
    height: 100%;
    margin-left: -19.71%;
  }
  /* the holdings magnifier's card (HoldingsLoop scales it to the slot) */
  .media--edge .fit-fill {
    aspect-ratio: 8 / 5;
  }

  :global(.holdings-fit) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  /* the piece's own page stage — a full-window gradient — gives way to
     the card's ground */
  :global(.holdings-fit .he-root) {
    min-height: 0;
    padding: 0;
    background: none;
  }

  /* no card inside the card: the piece's black square and its lens's lit
     copy both take this card's ground (they must match each other for the
     lens to read as a window), and its hairline goes */
  :global(.holdings-fit .he-card),
  :global(.holdings-fit .he-glass) {
    background: #0f0f0f;
  }

  :global(.holdings-fit .he-card::after),
  :global(.holdings-fit .he-logo::after) {
    display: none;
  }
  .media--edge .col > div.fit-fill > video {
    max-width: 92%;
    max-height: 92%;
  }
  /* the bell — a tiny icon in a wide shallow band */
  .media--edge .fit-bell {
    aspect-ratio: 5 / 2;
  }
  .media--edge .col > div.fit-bell > video {
    max-width: 16%;
    max-height: 44%;
  }

  /* ---- testimonials ------------------------------------------- */
  /* Framer: 16px from the title to the cards */
  #team .statement {
    margin-bottom: 16px;
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--w-surface);
    /* the project images' corner and rim (see the ::after rule below) */
    position: relative;
    border-radius: 8px;
    padding: 20px;
  }

  .quote-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .quote-by {
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote-name {
    font-size: 0.75rem;
  }

  .quote-role {
    font-size: 0.75rem;
    color: var(--w-ink-soft);
  }

  /* ---- responsive ---------------------------------------------- */
  /* stack the project rows before the two columns get cramped */
  @media (max-width: 1080px) {
    .project {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4cqw, 2.5rem);
      max-width: 640px;
      margin-inline: auto;
    }

    .project-copy {
      order: 2;
    }
  }

  @media (max-width: 820px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
