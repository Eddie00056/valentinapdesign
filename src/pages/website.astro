---
import Website from "../layouts/Website.astro";
import { caseStudies } from "../data/site";
import { Reveal } from "../components/website/Reveal";
import { HeroCreed } from "../components/website/HeroCreed";
import SiteHeader from "../components/website/SiteHeader.astro";

const bySlug = Object.fromEntries(caseStudies.map((c) => [c.slug, c]));
const qp = bySlug["questrade-pro"];
const fs = bySlug["fractional-shares"];
const em = bySlug["edgemobile"];

const quotes = [
  {
    text: "A systems thinker, strong collaborator; and the person who was instrumental to our active traders business.",
    name: "Marina Priejzev",
    role: "Managing Engineering Director @ Questrade",
  },
  {
    text: "The person you call when you need to get things done. Thoughtful, strategic, and a great collaborator.",
    name: "Eduardo Pastrana",
    role: "Staff Product Manager @ Wealthsimple",
  },
  {
    text: "An exceptional designer with a growth mindset and proven impact in leading active trader products.",
    name: "Kyle Maskewich",
    role: "Content Designer @ Microsoft",
  },
  {
    text: "An amazing leader, combining creativity and clarity to cut through complexity and deliver impact.",
    name: "Carleen Thio",
    role: "Product Designer @ Questrade",
  },
];
---

<Website
  snap
  title="Product Designer"
  description="Valentina Padure — Product Designer with 5+ years shaping fintech products."
>
  <SiteHeader />

  <noscript>
    <style>
      [style*="opacity:0"],
      [style*="opacity: 0"] {
        opacity: 1 !important;
        transform: none !important;
      }
      /* show the finished joke without JS */
      .creed-strike-line {
        transform: scaleX(1) !important;
      }
    </style>
  </noscript>

  <main>
    <div class="hero-pin">
      <div class="hero-sticky">
        <section class="w-wrap bay hero">
          <p class="statement">
            Product Designer with 5+ years experience shaping fintech products
            while focusing on fostering collaboration, pushing limits, and
            delivering high-impact work.{" "}<HeroCreed client:load />
          </p>
        </section>
      </div>
    </div>

    <section id="projects" class="w-wrap projects">
      <!-- Questrade Pro -->
      <Reveal client:load amount={0.25}>
        <a class="project" href={`/website/${qp.slug}`}>
          <div class="project-copy">
            <p class="kicker">{qp.title}</p>
            <h2 class="project-title">{qp.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--single">
            <video
              src="/website/video/questrade.mp4"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"></video>
          </div>
        </a>
      </Reveal>

      <!-- Fractional Shares -->
      <Reveal client:load amount={0.25}>
        <a class="project" href={`/website/${fs.slug}`}>
          <div class="project-copy">
            <p class="kicker">{fs.title}</p>
            <h2 class="project-title">{fs.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--frac">
            <div class="frac-phone">
              <video src="/website/video/fractional-phone.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="frac-a">
              <video src="/website/video/fractional-limit.mp4" autoplay loop muted playsinline></video>
            </div>
            <div class="frac-b">
              <video src="/website/video/fractional-icon.mp4" autoplay loop muted playsinline></video>
            </div>
          </div>
        </a>
      </Reveal>

      <!-- EdgeMobile -->
      <Reveal client:load amount={0.25}>
        <a class="project" href={`/website/${em.slug}`}>
          <div class="project-copy">
            <p class="kicker">{em.title}</p>
            <h2 class="project-title">{em.summary}</h2>
            <span class="see">See project →</span>
          </div>
          <div class="media media--edge">
            <div class="col">
              <div class="fit-fill">
                <video src="/website/video/edge-chart.mp4" autoplay loop muted playsinline></video>
              </div>
              <div class="fit-price">
                <video src="/website/video/edge-hood.mp4" autoplay loop muted playsinline></video>
              </div>
            </div>
            <div class="col">
              <div class="fit-bell">
                <video src="/website/video/edge-bell.mp4" autoplay loop muted playsinline></video>
              </div>
              <div class="fit-wide">
                <video src="/website/video/edge-order.mp4" autoplay loop muted playsinline></video>
              </div>
            </div>
          </div>
        </a>
      </Reveal>
    </section>

    <Reveal client:load amount={0.3}>
      <section id="team" class="w-wrap bay">
        <h2 class="statement">I'm a great team asset</h2>
        <ul class="quotes">
          {
            quotes.map((q) => (
              <li class="quote">
                <p class="quote-text">“{q.text}”</p>
                <p class="quote-by">
                  <span class="quote-name">{q.name}</span>
                  <span class="quote-role">{q.role}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </Reveal>

    <Reveal client:load amount={0.5}>
      <section id="contact" class="w-wrap bay contact">
        <h2 class="statement">Currently looking for new roles</h2>
        <p class="contact-line">
          <a href="mailto:valeapad@gmail.com">valeapad@gmail.com</a>
          <span class="dot">•</span>
          <a href="tel:+19292716949">929-271-6949</a>
          <span class="dot">•</span>
          <a
            class="u"
            href="https://www.linkedin.com/in/valentinapadure"
            target="_blank"
            rel="noopener">Linkedin</a
          >
        </p>
      </section>
    </Reveal>
  </main>

  <script>
    // Respect reduced-motion: freeze the project loops on the first frame.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video").forEach((v) => {
        v.removeAttribute("autoplay");
        v.pause();
      });
    }
  </script>

  <script>
    /* Section settling — replaces CSS scroll-snap.
       Nothing touches the scroll position while the user is scrolling
       (slow or fast). Only once scrolling has fully stopped does the
       nearest section ease to the top. So free-scrolling is never
       fought, and a stop clicks cleanly into place. */
    (() => {
      const html = document.documentElement;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      if (reduce.matches) return;

      const anchor = () =>
        parseFloat(getComputedStyle(html).scrollPaddingTop) || 0;
      const targets = () => [
        ...document.querySelectorAll(".projects .project, #team, #contact"),
      ];

      let tweening = false;
      let raf = 0;
      const easeOutCubic = (t) => 1 - (1 - t) ** 3;

      const stopTween = () => {
        if (!tweening) return;
        cancelAnimationFrame(raf);
        tweening = false;
        html.style.scrollBehavior = "";
      };

      function tweenTo(y) {
        const from = window.scrollY;
        const delta = y - from;
        if (Math.abs(delta) < 2) return;
        const dur = Math.min(480, 240 + Math.abs(delta) * 0.34);
        const t0 = performance.now();
        html.style.scrollBehavior = "auto";
        tweening = true;
        const step = (now) => {
          const t = Math.min(1, (now - t0) / dur);
          window.scrollTo(0, Math.round(from + delta * easeOutCubic(t)));
          if (t < 1) raf = requestAnimationFrame(step);
          else stopTween();
        };
        raf = requestAnimationFrame(step);
      }

      function settle() {
        if (tweening) return;
        if (html.classList.contains("snap-hold")) return; // hero pin busy
        // let the hero pin hand off to the projects on its own — don't
        // pounce with a settle the instant it releases
        if (Date.now() - (+html.dataset.pinReleased || 0) < 700) return;
        const off = anchor();
        const maxPull = window.innerHeight * 0.55;
        let best = null;
        let bestDist = Infinity;
        for (const el of targets()) {
          const top = el.getBoundingClientRect().top - off;
          const d = Math.abs(top);
          if (d < bestDist) {
            bestDist = d;
            best = top;
          }
        }
        if (best == null || bestDist < 3 || bestDist > maxPull) return;
        tweenTo(window.scrollY + best);
      }

      if ("onscrollend" in window) {
        window.addEventListener("scrollend", settle);
      } else {
        let d = 0;
        window.addEventListener(
          "scroll",
          () => {
            if (tweening) return;
            clearTimeout(d);
            d = setTimeout(settle, 170);
          },
          { passive: true }
        );
      }

      // hand scroll back to the user the instant they act
      ["wheel", "touchstart", "pointerdown", "keydown"].forEach((ev) =>
        window.addEventListener(ev, stopTween, { passive: true })
      );
    })();
  </script>
</Website>

<style>
  /* ---- rhythm ----------------------------------------------------- */
  section[id] {
    scroll-margin-top: 5rem;
  }

  /* Section settling is done in JS (see the scroll-settle <script>), not
     CSS scroll-snap — so slow free-scrolling is never pulled. Each
     settle target is marked data-snap. */

  /* ---- hero pin: the hero holds still while a stretch of scroll drives
     the "I get shit work done" reveal, then releases to the projects.
     .hero-pin is a tall spacer; .hero-sticky pins inside it. */
  .hero-pin {
    position: relative;
    /* the strike + a long fully-struck hold each get a real stretch of
       scroll before the hero eases out (see HeroCreed) */
    height: 200vh;
  }

  /* the sticky box is shorter than the viewport (and offset down a little)
     so there's less empty screen to scroll past once the pin releases —
     the hero still reads as roughly centred */
  .hero-sticky {
    position: sticky;
    top: 9svh;
    min-height: 82svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    will-change: opacity, transform;
  }

  /* only the media-heavy project rows fill the viewport; the text-only
     sections stay their natural height so there's no empty screen */
  .project {
    min-height: 100svh;
  }

  #team,
  #contact {
    padding-block: clamp(2.5rem, 1.75rem + 2.4vw, 4rem);
    border-top: 1px solid var(--w-line);
  }

  /* contact: tuck the copy right under its separator and don't leave a
     cavernous gap under the last line */
  #contact {
    padding-top: clamp(1.75rem, 1.25rem + 1.4vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 1.75rem + 2vw, 3.75rem);
  }

  /* .project keeps its own two-column grid; just centre it vertically */
  .project {
    align-content: center;
  }

  .bay {
    padding-block: clamp(3.5rem, 4rem + 6vw, 8.5rem);
  }

  .hero {
    padding-top: clamp(4rem, 3rem + 8vw, 9rem);
    padding-bottom: clamp(4rem, 3rem + 8vw, 9rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pin {
      height: auto;
    }
    .hero-sticky {
      position: static;
      top: auto;
      min-height: 0;
    }
    .project {
      min-height: 0;
    }
  }

  /* ---- big statements ------------------------------------------- */
  .statement {
    margin: 0;
    max-width: none;
    font-weight: 400;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 2.5rem);
    line-height: 1.16;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .hero .statement {
    max-width: 25ch;
    text-wrap: pretty;
  }

  @media (min-width: 700px) {
    .hero .statement {
      max-width: 46ch;
    }
  }

  /* ---- hero creed tail ("… high-impact work I get shit work done") --- */
  /* rendered by the HeroCreed React island, so these opt out of scoping */
  :global(.creed-tail) {
    will-change: opacity;
  }

  :global(.creed-strike) {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  :global(.creed-strike-line) {
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 0.56em;
    height: 0.075em;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
    pointer-events: none;
  }

  :global(.creed-strike-line[data-static]) {
    transform: scaleX(1);
  }

  /* ---- projects ------------------------------------------------- */
  .projects {
    display: flex;
    flex-direction: column;
  }

  @media (prefers-reduced-motion: reduce) {
    .projects {
      gap: clamp(4rem, 3rem + 8vw, 9rem);
      padding-block: clamp(2rem, 1rem + 4vw, 5rem);
    }
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.5rem, 1rem + 6vw, 7rem);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .project-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.125rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .see {
    font-family: var(--w-font-alt);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--w-ink);
    transition: opacity 0.18s ease;
  }

  .project:hover .see {
    opacity: 0.62;
  }

  /* media wrappers */
  .media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media--single video {
    aspect-ratio: 798 / 573;
    border-radius: 8px;
  }

  /* Fractional: tall phone card + two stacked cards, all on white */
  .media--frac {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
  }

  .media--frac > div {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 2vw, 1.25rem);
  }

  .frac-phone {
    grid-row: 1 / 3;
    aspect-ratio: 394 / 440;
  }

  .frac-phone video {
    width: 82%;
    height: 82%;
    object-fit: contain;
  }

  .frac-a video,
  .frac-b video {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* EdgeMobile: two independent column stacks (like the case-study
     bento) so each card sizes to its own clip — no row-height
     stretching that balloons the small cards */
  .media--edge {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    /* stretch both columns to the taller one's height so the last card in
       each can grow to a shared bottom edge (see :last-child rule below) */
    align-items: stretch;
    gap: 12px;
  }

  .media--edge .col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .media--edge .col > * {
    width: 100%;
  }

  /* the shorter column's last card takes up the slack so its bottom edge
     lines up with the taller column's — the centred clip inside just
     floats in the extra dark space (Framer's method, above) */
  .media--edge .col > div:last-child {
    flex: 1;
    min-height: 0;
  }

  /* drop the height cap on the grown card's clip so its size stays
     width-driven and the extra card height reads as dark space, not a
     zoomed-in clip */
  .media--edge .col > div:last-child > video {
    max-height: none;
  }

  /* Framer's method: each card is a short/wide near-black box; the clip
     sits CENTRED at its own size with object-fit:contain and generous
     dark padding around it — never stretched to fill. The clips carry
     baked-in #0c0c0c margin, so contain + matching card bg reads as one
     continuous dark surface with the UI floating in it. No cropping. */
  .media--edge .col > div {
    position: relative;
    background: #0c0c0c;
    border-radius: 20px;
    overflow: hidden;
  }

  /* card rim — reuse of the prototype's fractional-icon border
     (.acs-frac-card::before): a 1px gradient hairline via the padding-box
     mask trick, so the near-black media cards read as framed instead of
     dissolving into the page. */
  .media--single {
    position: relative;
    border-radius: 8px;
  }

  .media--single::after,
  .media--edge .col > div::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      66deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.03) 42%,
      rgba(255, 255, 255, 0.09) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* clip is absolutely positioned + centred so it can NEVER stretch the
     card — the card's aspect-ratio alone sets its size. The clip floats
     at its natural size, capped well below the card edges, so it reads
     as content-in-a-frame, not a zoomed-in fill. */
  .media--edge .col > div > video {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: 86%;
    max-height: 82%;
    object-fit: contain;
  }

  /* order ticket — room for all three rows (content ≈ 2.5:1) */
  .media--edge .fit-wide {
    aspect-ratio: 19 / 10;
  }
  /* single price ticker — wide, short; its baked-in text runs large so
     hold the clip well down */
  .media--edge .fit-price {
    aspect-ratio: 26 / 10;
  }
  .media--edge .col > div.fit-price > video {
    max-width: 48%;
  }
  /* chart — the one near-filled card; aspect matched to the clip */
  .media--edge .fit-fill {
    aspect-ratio: 8 / 5;
  }
  .media--edge .col > div.fit-fill > video {
    max-width: 92%;
    max-height: 92%;
  }
  /* the bell — a tiny icon in a wide shallow band */
  .media--edge .fit-bell {
    aspect-ratio: 5 / 2;
  }
  .media--edge .col > div.fit-bell > video {
    max-width: 16%;
    max-height: 44%;
  }

  /* ---- testimonials ------------------------------------------- */
  #team .statement {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--w-surface);
    border-radius: 20px;
    padding: 20px;
  }

  .quote-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .quote-by {
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote-name {
    font-size: 0.75rem;
  }

  .quote-role {
    font-size: 0.75rem;
    color: var(--w-ink-soft);
  }

  /* ---- contact ---------------------------------------------------- */
  .contact-line {
    margin: clamp(1.25rem, 1rem + 1.5vw, 2rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--w-ink-soft);
  }

  .contact-line a {
    color: var(--w-ink-soft);
    transition: color 0.18s ease;
  }

  .contact-line a:hover {
    color: var(--w-ink);
  }

  .contact-line .u {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-line .dot {
    color: var(--w-ink-faint);
  }

  /* ---- responsive ---------------------------------------------- */
  /* stack the project rows before the two columns get cramped */
  @media (max-width: 1080px) {
    .project {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4vw, 2.5rem);
      max-width: 640px;
      margin-inline: auto;
    }

    .project-copy {
      order: 2;
    }
  }

  @media (max-width: 820px) {
    .quotes {
      grid-template-columns: 1fr;
    }

    .id-name {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 480px) {
    .links {
      gap: 1.1rem;
    }
  }
</style>
