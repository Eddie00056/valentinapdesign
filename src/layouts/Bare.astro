---
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  bg?: string;
}

const { title, description, bg = "#0d0d0d" } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />

    <style is:global define:vars={{ bg }}>
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        overflow: hidden;
      }

      /* Tiles read as one dark surface with the work floating on it, the
         way the reference grid does. Only the embedded copy is re-grounded
         — each piece keeps its own backdrop on its real page. */
      html[data-embed],
      html[data-embed] body {
        background: #141414 !important;
      }

      html[data-embed] .back,
      html[data-embed] .ob-back,
      html[data-embed] .oc-back,
      html[data-embed] .shell-nav,
      html[data-embed] .shell-foot,
      html[data-embed] .pshell-nav,
      html[data-embed] .bg-toggle {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- Embed mode. The gallery renders these pages live inside its tiles,
         where a page's own chrome — the back button, the demo shell's nav
         and footer — is not part of the work being shown. Marking the
         document lets one global rule below hide all of it, rather than
         each page having to know it might be framed. -->
    <script is:inline>
      if (window.self !== window.top) {
        document.documentElement.setAttribute("data-embed", "");

        /* Some pieces are a static artboard wrapped in a nested iframe, so
           the CSS rule above cannot reach their chrome — and that markup is
           generated, with no class or id to target.

           In those artboards the work itself is statically positioned
           inside #dc-root, and the only fixed-position elements are the
           overlay toolbars (screen tabs, zoom, "Hide UI"). So position is
           the discriminator. Their own "Hide UI" button is not usable here:
           it toggles a different layer and leaves the toolbar standing. */
        /* A rule, not a sweep. Sweeping elements on a timer left the
           toolbar visible for the first second or so, which reads as a
           flash of chrome every time a tile loads. These artboards declare
           position inline, so an attribute selector catches each toolbar
           the moment it parses — the sweep below stays as a backstop for
           anything created later. */
        var NESTED_CSS =
          '[style*="position: fixed"],[style*="position:fixed"]{display:none !important}';

        var hideNestedChrome = function () {
          document.querySelectorAll("iframe").forEach(function (f) {
            var d, w;
            try {
              d = f.contentDocument;
              w = f.contentWindow;
            } catch (e) {
              return;
            }
            if (!d || !d.documentElement || !w) return;

            if (!d.getElementById("embed-chrome-hide")) {
              var st = d.createElement("style");
              st.id = "embed-chrome-hide";
              st.textContent = NESTED_CSS;
              (d.head || d.documentElement).appendChild(st);
            }

            if (!d.body) return;
            d.querySelectorAll("body *").forEach(function (el) {
              if (w.getComputedStyle(el).position === "fixed") {
                el.style.setProperty("display", "none", "important");
              }
            });
          });
        };

        var armNested = function () {
          hideNestedChrome();
          document.querySelectorAll("iframe").forEach(function (f) {
            f.addEventListener("load", function () {
              setTimeout(hideNestedChrome, 60);
            });
          });
        };

        /* Start before load: the nested document usually exists well
           before the outer page finishes, and the earlier the style lands
           the less chance the toolbar paints at all. */
        hideNestedChrome();
        var t = setInterval(hideNestedChrome, 100);
        setTimeout(function () {
          clearInterval(t);
        }, 4000);
        addEventListener("DOMContentLoaded", armNested);
        addEventListener("load", armNested);
      }
    </script>
  </body>
</html>
