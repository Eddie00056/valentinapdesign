---
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
/* the portfolio pages are drawn at 125% on desktop (see .site-zoom below);
   the presentation deck at / fits itself to the window and stays at 100% */
const siteZoom = Astro.url.pathname.startsWith("/website");
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Product Designer`;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://valentinapdesign.com",
);
---

<!doctype html>
<html lang="en" class:list={[{ "site-zoom": siteZoom }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonical.href} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,500;9..40,600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- section reveals (reveal.ts): hide the parts before first paint, and
         give them back if the module never arrives -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        var h = document.documentElement;
        h.classList.add("reveal-on");
        setTimeout(function () {
          if (!window.__revealReady) h.classList.remove("reveal-on");
        }, 4000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* The site as it looks at 125% browser zoom, at 100%: `zoom` re-lays the
     page out bigger (crisp, not a bitmap stretch), the way browser zoom does.
     Desktop only: from 1350px, so the page still has 1080px of layout — the
     width the project rows stack at. Viewport units are not zoomed, so
     anything sized off the window divides by --zoom. */
  :root {
    --zoom: 1;
  }

  @media (min-width: 1350px) {
    html.site-zoom {
      zoom: 1.25;
      --zoom: 1.25;
    }
  }

  /* …and the fluid sizes are written in cqw against the body, not vw: a
     container's width is in the page's own (zoomed) pixels, so a clamp()
     lands where it would at real 125% zoom. vw would see the raw window. */
  html.site-zoom body {
    container-type: inline-size;
  }

  /* section reveals: parts wait hidden until reveal.ts animates them in */
  html.reveal-on [data-reveal]:not([data-revealed]) [data-r],
  html.reveal-on [data-reveal]:not([data-revealed]):not(:has([data-r])) {
    opacity: 0;
  }

  /* Elza Text — self-hosted, matched to the Framer source ------------- */
  @font-face {
    font-family: "Elza Text";
    src: url("/website/fonts/elza-400.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Elza Text";
    src: url("/website/fonts/elza-500.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Elza Text";
    src: url("/website/fonts/elza-600.woff2") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Elza Text";
    src: url("/website/fonts/elza-700.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* palette measured off valentinapadure.framer.website */
    --w-bg: #030205;
    --w-surface: #0c0c0c;
    --w-ink: #ffffff;
    --w-ink-soft: #969696;
    --w-ink-mute: rgba(255, 255, 255, 0.5);
    --w-ink-faint: #565656;
    --w-line: #1e1e1e;
    /* section dividers — a step brighter than --w-line so they read on the black */
    --w-rule: #2e2e2e;
    --w-accent: #00ff9d;
    --w-cream: #fffced;

    --w-font: "Elza Text", "Fraunces", Georgia, serif;
    --w-font-alt: "Instrument Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Helvetica, Arial, sans-serif;

    --w-gutter: clamp(1.25rem, 4.5cqw, 2.5rem);
    --w-maxw: 1400px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
    scroll-padding-top: 4.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--w-bg);
    color: var(--w-ink);
    font-family: var(--w-font);
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .w-wrap {
    width: 100%;
    max-width: var(--w-maxw);
    margin-inline: auto;
    padding-inline: var(--w-gutter);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: var(--w-accent);
    color: #000;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
